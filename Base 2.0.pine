//@version=6
// Base 2.0 - Market Structure (TradingView port of Base 2.0.mq5 v3.10)
//
// The trend purely from market structure, from closed candles only:
//  * Swings: a swing is confirmed by the first close one swing size back from
//    the leg's extreme. The swing size is K x the 14-candle ATR: the base size
//    (Auto: set from each symbol's own movement, see swingSize; Fixed: 1 ATR)
//    times the Swing Sensitivity level's factor (level 10 = 1, each level
//    about 10% finer or broader). Internal swings use the Internal Swing Size
//    of it. HH/LH and LL/HL compare each swing with the previous one on its
//    side; EQH/EQL is a label only.
//  * Bullish Trending: two successive upside breaks with a higher low between
//    them. A BOS is a close above the weak high; the strong low is the latest
//    swing low. A close below it is a CHoCH, but the trend holds until the
//    Transition conditions are met.
//  * Bearish Transition (a CHoCH of a bullish trend, or a break out of
//    consolidation, then before the break fails):
//      A. a lower high or equal high no higher than the last HH, or
//      B. two successive internal BOS down.
//    The break fails - a liquidity sweep, LS - on two successive internal
//    breaks up (an internal CHoCH and BOS), a close above the last HH, or a
//    BOS of the trend. A BOS makes the Transition a trend.
//  * Consolidation: no trending or transitional structure within the last 5
//    swings. Its range is the highest high and lowest low of those swings.
//  * Market Tradability: Tradable when the HTF is Trending, every selected
//    MTF/LTF is Trending or in Transition the same way, and the HTF trend
//    quality is at least its minimum that way.
// It is an analysis tool and never places orders.
indicator("Base 2.0 - Market Structure", shorttitle = "Base 2.0", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// ---------------------------------------------------------------- inputs
grpTf = "Timeframes"
htfTf = input.timeframe("60", "HTF", group = grpTf, tooltip = "The main trend: its Market Trend decides Market Tradability and the alerts.")
mtfTf = input.timeframe("30", "MTF", group = grpTf, tooltip = "Middle timeframe, shown and used for Market Tradability when Use MTF is on.")
ltfTf = input.timeframe("15", "LTF", group = grpTf, tooltip = "Lower timeframe, shown and used for Market Tradability when Use LTF is on.")
useMtf = input.bool(false, "Use MTF", group = grpTf, tooltip = "Show the MTF on the dashboard and require it for Market Tradability: Trending or in Transition the HTF's way.")
useLtf = input.bool(false, "Use LTF", group = grpTf, tooltip = "Show the LTF on the dashboard and require it for Market Tradability: Trending or in Transition the HTF's way.")

grpSize = "Swing Sensitivity"
LEVEL_TIP = "1-20: 10 is the base size and each level is about 10% finer (lower) or broader (higher): 1 is 0.42 times the base, 20 is 2.59 times."
swingMode = input.string("Auto", "Swing Size", options = ["Auto", "Fixed (ATR)"], group = grpSize, tooltip = "Auto sets the base size from each symbol's own movement on each timeframe (0.5 to 2 ATR): the more of its movement is trend rather than noise, the smaller a swing needs to be, so one level gives the same structure on every symbol. Fixed (ATR) uses 1 ATR as the base.")
htfLevel = input.int(10, "HTF Swing Sensitivity", minval = 1, maxval = 20, group = grpSize, tooltip = "HTF swings. " + LEVEL_TIP)
mtfLevel = input.int(10, "MTF Swing Sensitivity", minval = 1, maxval = 20, group = grpSize, tooltip = "MTF swings. " + LEVEL_TIP)
ltfLevel = input.int(10, "LTF Swing Sensitivity", minval = 1, maxval = 20, group = grpSize, tooltip = "LTF swings. " + LEVEL_TIP)
internalRatio = input.float(0.5, "Internal Swing Size", minval = 0.2, maxval = 0.9, step = 0.05, group = grpSize, tooltip = "The internal structure uses this fraction of its timeframe's swing size.")

grpTrad = "Market Tradability"
qualityCandles = input.int(30, "Trend Quality Window (closed HTF candles)", minval = 5, maxval = 200, group = grpTrad, tooltip = "How many closed HTF candles the trend quality (efficiency) is measured over.")
qualityMin = input.float(0.30, "Tradable When The HTF Efficiency Is At Least", minval = 0.0, maxval = 0.99, step = 0.05, group = grpTrad, tooltip = "Market Tradability needs the HTF trend quality at least this, its net move in the trend's direction: the net move of the window's closes divided by the distance travelled close to close, 0 for chop and 1 for a straight line.")
requireSwings = input.bool(false, "Also Require HH + HL (LL + LH)", group = grpTrad, tooltip = "Market Tradability also needs an HH and an HL (an LL and an LH) on the HTF and every selected timeframe.")
requireInternal = input.bool(false, "Also Require The HTF Internal Structure To Agree", group = grpTrad, tooltip = "Market Tradability also needs the HTF's latest internal break in the trend's direction.")

grpDisplay = "Display"
barsToProcess = input.int(100, "Bars To Process", minval = 100, maxval = 100000, group = grpDisplay, tooltip = "How many HTF candles back structure is drawn. Other chart timeframes cover the same span of time. Structure is always calculated on all loaded history.")
showSwings = input.bool(true, "Show HH / HL / LH / LL", group = grpDisplay, tooltip = "Swing labels (and EQH/EQL, joined to the swing they equal) and the dotted latest swing high and low.")
showBreaks = input.bool(true, "Show BOS / CHoCH / LS", group = grpDisplay, tooltip = "BOS blue, CHoCH red, LS (a break that failed) deep yellow: a line from the broken swing to the first candle that touched its level.")
showInternal = input.bool(true, "Show Internal Structure", group = grpDisplay, tooltip = "The internal BOS/CHoCH, dashed with faded captions.")
showInternalOnDashboard = input.bool(true, "Show Internal Structure On Dashboard", group = grpDisplay, tooltip = "Each timeframe's latest internal break under its Market Trend.")
showStrongWeak = input.bool(true, "Show Strong / Weak High / Low", group = grpDisplay, tooltip = "In a trend or transition the level against it is Strong and the level its BOS must close beyond is Weak; Consolidation shows its Range High and Range Low.")
labelSizeInput = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDisplay)
dashPositionInput = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = grpDisplay)
enableAlerts = input.bool(false, "Alert On HTF Breaks And State Changes", group = grpDisplay, tooltip = "Send an alert() on each HTF BOS, CHoCH or LS and change of Market Trend, on the HTF candle that closed. Create the alert with Any alert() function call.")

// ------------------------------------------------------------------ rules
SWING_ATR_LENGTH = 14
VR_LAG = 20
VR_WINDOW = 1000
AUTO_SCALE = 0.8
K_MIN = 0.5
K_MAX = 2.0
LEVEL_STEP = 1.1
EQUAL_ATR = 0.2
MAX_SWINGS = 5
INTERNAL_BREAKS = 2
// How far back a level or a line end is searched (candles).
MAX_SCAN = 4999

CONS = 0
TRANS = 1
TREND = 2

HIGH_COLOR = #CD5C5C
LOW_COLOR = #008080
BOS_COLOR = color.blue
CHOCH_COLOR = color.red
LS_COLOR = #E5B800
INTERNAL_BULL_COLOR = #089981
INTERNAL_BEAR_COLOR = #F23645

labelSize = labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : labelSizeInput == "Large" ? size.large : size.small

// A Swing Sensitivity level's factor (see Base 2.0.mq5's LevelFactor).
levelFactor(int level) =>
    math.pow(LEVEL_STEP, math.max(1, math.min(20, level)) - 10)

// ------------------------------------------------------ structure engine
// The engine of Base 2.0.mq5's ReplayStructure, one closed candle at a time
// (see step).
type B3Level
    float price
    int bar
    int t

type B3Point
    int side
    int bar
    int t
    float price
    int kind = 0
    bool equal = false
    int equalBar = -1
    int equalTime = na
    float equalPrice = na

type B3Event
    int seq
    int bar
    int dir
    bool bos
    int swingBar
    int swingTime
    float level
    bool ls = false
    int lsBar = -1
    // Where its line ends: the first candle after the swing whose wick or
    // body reached the level (the breaking candle at the latest).
    int endBar = -1
    int endTime = na

// The zigzag that confirms swings. leg: 1 rising (tracking its high), -1
// falling, 0 before the first swing (tracking both extremes).
type B3Zig
    int leg = 0
    float hi = na
    int hiBar = -1
    float lo = na
    int loBar = -1
    float ext = na
    int extBar = -1

type B3Engine
    B3Zig main
    B3Zig inner
    // The swing unit (K x ATR) and the ATR of the latest MAX_SCAN + 1
    // candles, the first one on candle unitFirst.
    array<float> units
    array<float> atrs
    int unitFirst = 0
    // The latest two swings on each side, and the last MAX_SWINGS swings.
    B3Point lastHigh
    B3Point prevHigh
    B3Point lastLow
    B3Point prevLow
    array<B3Point> recent
    // The latest internal swing on each side.
    float ihPrice = na
    int ihBar = -1
    int ihConfirmed = -1
    bool ihBroken = true
    float ilPrice = na
    int ilBar = -1
    int ilConfirmed = -1
    bool ilBroken = true
    int idir = 0
    bool ibos = false
    // The state: TREND, TRANS or CONS; the direction (in Consolidation the
    // last one, 0 before any).
    int st = 0
    int d = 0
    B3Level weak
    B3Level prot
    B3Level inval
    int resume = 0
    int since = 0
    int breakBar = -1
    int changedBar = -1
    bool byInternal = false
    B3Level transBreak
    // The running extreme since the latest break (the Weak level before its
    // swing forms).
    float trail = na
    int trailBar = -1
    int trailFrom = -1
    int trailDir = 0
    // A break waiting for the Transition conditions.
    bool att = false
    int attU = 0
    int attBar = -1
    B3Level attBroken
    B3Level attOrigin
    B3Event attEvent
    int attWith = 0
    int attAgainst = 0
    B3Level attBest
    B3Level attPullback
    int attFrom = 0
    int seq = 0
    int lsTotal = 0
    float k = na
    // What the latest candle confirmed.
    array<B3Point> newPoints
    array<B3Event> newEvents
    array<B3Event> newLs
    array<B3Event> newInternal

newEngine() =>
    B3Engine.new(B3Zig.new(), B3Zig.new(), array.new<float>(), array.new<float>(), recent = array.new<B3Point>(), newPoints = array.new<B3Point>(), newEvents = array.new<B3Event>(), newLs = array.new<B3Event>(), newInternal = array.new<B3Event>())

method unitAt(B3Engine e, int bar) =>
    e.units.get(math.min(math.max(bar - e.unitFirst, 0), e.units.size() - 1))

method atrAt(B3Engine e, int bar) =>
    e.atrs.get(math.min(math.max(bar - e.unitFirst, 0), e.atrs.size() - 1))

// The candle of the highest high (side 1) or lowest low (-1) after candle
// `frm` up to this one (this one when frm is this one), the latest of equal
// ones, and its price (see Base 2.0.mq5's ExtremeAfter).
extremeAfter(int side, int frm) =>
    int best = -1
    float bestV = na
    int first = math.max(math.min(frm + 1, bar_index), bar_index - MAX_SCAN)
    for j = first to bar_index
        float v = side > 0 ? high[bar_index - j] : low[bar_index - j]
        if best < 0 or (side > 0 ? v >= bestV : v <= bestV)
            best := j
            bestV := v
    [best, bestV]

// The same from candle `frm` itself (see ExtremeSince).
extremeSince(int side, int frm) =>
    int best = -1
    float bestV = na
    int first = math.max(math.min(frm, bar_index), bar_index - MAX_SCAN)
    for j = first to bar_index
        float v = side > 0 ? high[bar_index - j] : low[bar_index - j]
        if best < 0 or (side > 0 ? v >= bestV : v <= bestV)
            best := j
            bestV := v
    [best, bestV]

levelAt(int side, int frm) =>
    [b, v] = extremeSince(side, frm)
    B3Level.new(v, b, time[bar_index - b])

// The first candle after `swingBar` (before this one) whose wick or body
// reached `level`, else this candle, and its time.
firstTouch(int swingBar, int dir, float level) =>
    int found = bar_index
    int first = math.max(swingBar + 1, bar_index - MAX_SCAN)
    if first < bar_index
        for j = first to bar_index - 1
            if dir > 0 ? high[bar_index - j] >= level : low[bar_index - j] <= level
                found := j
                break
    [found, time[bar_index - found]]

newPoint(int side, float price, int bar) =>
    B3Point.new(side, bar, time[bar_index - bar], price)

// One candle of a zigzag (see Base 2.0.mq5's ZigzagStep): the leg tracks its
// extreme, and the first close `scale` units back from it confirms the swing;
// a leg that starts on this candle waits for a later close.
zigStep(B3Zig z, B3Engine e, float scale) =>
    array<B3Point> found = array.new<B3Point>()
    bool starting = z.leg == 0
    if starting
        if na(z.hi) or high >= z.hi
            z.hi := high
            z.hiBar := bar_index
        if na(z.lo) or low <= z.lo
            z.lo := low
            z.loBar := bar_index
        bool up = close >= z.lo + e.unitAt(z.loBar) * scale
        bool down = close <= z.hi - e.unitAt(z.hiBar) * scale
        bool lowFirst = up and (not down or z.loBar < z.hiBar)
        bool highFirst = down and not lowFirst
        if lowFirst
            found.push(newPoint(-1, z.lo, z.loBar))
            z.leg := 1
            [b, v] = extremeAfter(1, z.loBar)
            z.ext := v
            z.extBar := b
            if down
                found.push(newPoint(1, z.hi, z.hiBar))
                z.leg := -1
                [b2, v2] = extremeAfter(-1, z.hiBar)
                z.ext := v2
                z.extBar := b2
        if highFirst
            found.push(newPoint(1, z.hi, z.hiBar))
            z.leg := -1
            [b, v] = extremeAfter(-1, z.hiBar)
            z.ext := v
            z.extBar := b
            if up
                found.push(newPoint(-1, z.lo, z.loBar))
                z.leg := 1
                [b2, v2] = extremeAfter(1, z.loBar)
                z.ext := v2
                z.extBar := b2
    if not starting
        if z.leg > 0 and high >= z.ext
            z.ext := high
            z.extBar := bar_index
        if z.leg < 0 and low <= z.ext
            z.ext := low
            z.extBar := bar_index
        for pass = 0 to 3
            int pivot = z.extBar
            bool topped = z.leg > 0 and close <= z.ext - e.unitAt(pivot) * scale
            bool bottomed = z.leg < 0 and close >= z.ext + e.unitAt(pivot) * scale
            if topped
                found.push(newPoint(1, z.ext, pivot))
                z.leg := -1
                [b, v] = extremeAfter(-1, pivot)
                z.ext := v
                z.extBar := b
            if bottomed
                found.push(newPoint(-1, z.ext, pivot))
                z.leg := 1
                [b, v] = extremeAfter(1, pivot)
                z.ext := v
                z.extBar := b
            if (not topped and not bottomed) or pivot == bar_index
                break
    found

method setState(B3Engine e, int st, int d) =>
    if st != e.st or d != e.d
        e.changedBar := bar_index
    e.st := st
    e.d := d
    e

// A break on this candle through `level` (its swing on level.bar).
method addEvent(B3Engine e, int dir, bool bos, B3Level level) =>
    e.seq += 1
    [endBar, endTime] = firstTouch(level.bar, dir, level.price)
    B3Event ev = B3Event.new(e.seq, bar_index, dir, bos, level.bar, level.t, level.price, endBar = endBar, endTime = endTime)
    e.newEvents.push(ev)
    ev

// A waiting break becomes a Transition (see Base 2.0.mq5's EnterTransition).
method enterTransition(B3Engine e) =>
    e.resume := e.attFrom
    e.inval := e.attOrigin
    e.setState(TRANS, e.attU)
    e.weak := e.attBest
    e.byInternal := na(e.attPullback)
    e.prot := na(e.attPullback) ? e.attBroken : e.attPullback
    e.transBreak := e.attBroken
    e.breakBar := e.attBar
    e.since := 0
    e.att := false
    e

method startAttempt(B3Engine e, int u, B3Level level, B3Level origin, int frm, bool bos) =>
    e.attEvent := e.addEvent(u, bos, level)
    e.att := true
    e.attU := u
    e.attBar := bar_index
    e.attBroken := level
    e.attOrigin := origin
    e.attWith := 0
    e.attAgainst := 0
    e.attBest := na
    e.attPullback := na
    e.attFrom := frm
    e

method toCons(B3Engine e) =>
    e.setState(CONS, e.d)
    e.weak := na
    e.prot := na
    e.inval := na
    e.since := 0
    if e.att
        e.attFrom := CONS
    e

// A swing confirmed on this candle (see Base 2.0.mq5's OnSwing).
method onSwing(B3Engine e, B3Point p) =>
    B3Point prev = p.side > 0 ? e.lastHigh : e.lastLow
    bool havePrev = not na(prev)
    if havePrev
        p.kind := (p.side > 0 ? p.price > prev.price : p.price < prev.price) ? 1 : -1
    float atrP = e.atrAt(p.bar)
    if havePrev and math.abs(p.price - prev.price) < EQUAL_ATR * atrP
        p.equal := true
        p.equalBar := prev.bar
        p.equalTime := prev.t
        p.equalPrice := prev.price
    e.newPoints.push(p)
    e.recent.push(p)
    if e.recent.size() > MAX_SWINGS
        e.recent.shift()
    if p.side > 0
        e.prevHigh := e.lastHigh
        e.lastHigh := p
    if p.side < 0
        e.prevLow := e.lastLow
        e.lastLow := p
    e.since += 1
    int d = e.d
    B3Level here = B3Level.new(p.price, p.bar, p.t)
    if e.st != CONS and p.side == d and (na(e.weak) or (d > 0 ? p.price > e.weak.price : p.price < e.weak.price))
        e.weak := here
    if e.st != CONS and p.side == -d
        e.prot := here
    if e.att and p.side == e.attU and (na(e.attBest) or (e.attU > 0 ? p.price > e.attBest.price : p.price < e.attBest.price))
        e.attBest := here
    if e.att and p.side == -e.attU
        float tolerance = EQUAL_ATR * atrP
        bool holds = e.attU > 0 ? p.price >= e.attOrigin.price - tolerance : p.price <= e.attOrigin.price + tolerance
        if holds
            e.attPullback := here
            e.enterTransition()
    e

// An internal swing broken by this candle's close (see InternalBreak).
method internalBreak(B3Engine e, int side) =>
    float price = side > 0 ? e.ihPrice : e.ilPrice
    bool broken = side > 0 ? e.ihBroken : e.ilBroken
    bool hit = not na(price) and not broken and (side > 0 ? close > price : close < price)
    if hit
        int pivot = side > 0 ? e.ihBar : e.ilBar
        int confirmed = side > 0 ? e.ihConfirmed : e.ilConfirmed
        if side > 0
            e.ihBroken := true
        if side < 0
            e.ilBroken := true
        [endBar, endTime] = firstTouch(pivot, side, price)
        e.newInternal.push(B3Event.new(0, bar_index, side, e.idir == side, pivot, time[bar_index - pivot], price, endBar = endBar, endTime = endTime))
        e.ibos := e.idir == side
        e.idir := side
        if e.att and confirmed >= e.attBar and side == e.attU
            e.attWith += 1
            e.attAgainst := 0
        if e.att and confirmed >= e.attBar and side != e.attU
            e.attAgainst += 1
            e.attWith := 0
    e

// Consolidation's range: the highest high and lowest low of the last
// MAX_SWINGS swings.
consRange(B3Engine e) =>
    B3Level hi = na
    B3Level lo = na
    for p in e.recent
        if p.side > 0 and (na(hi) or p.price > hi.price)
            hi := B3Level.new(p.price, p.bar, p.t)
        if p.side < 0 and (na(lo) or p.price < lo.price)
            lo := B3Level.new(p.price, p.bar, p.t)
    [hi, lo]

// The structure after this candle closed (see Base 2.0.mq5's OnClose).
method onClose(B3Engine e) =>
    float c = close
    if e.att
        int u = e.attU
        bool beyond = u < 0 ? c > e.attOrigin.price : c < e.attOrigin.price
        bool viaB = e.attWith >= INTERNAL_BREAKS
        bool failed = not viaB and (beyond or e.attAgainst >= INTERNAL_BREAKS)
        if viaB
            e.enterTransition()
        if failed
            // The break failed: a liquidity sweep. A trend holds, with the
            // sweep's extreme as its new strong level.
            e.attEvent.ls := true
            e.attEvent.lsBar := bar_index
            e.newLs.push(e.attEvent)
            e.lsTotal += 1
            e.att := false
            if e.attFrom == TREND
                e.prot := levelAt(-e.d, e.attBar)
    int d = e.d
    int st = e.st
    if st == TREND
        bool bos = not na(e.weak) and (d > 0 ? c > e.weak.price : c < e.weak.price)
        bool choch = not bos and not e.att and not na(e.prot) and (d > 0 ? c < e.prot.price : c > e.prot.price)
        bool stale = not bos and not choch and e.since >= MAX_SWINGS
        if bos
            e.addEvent(d, true, e.weak)
            // The trend went on while a CHoCH waited: that CHoCH failed (LS).
            if e.att
                e.attEvent.ls := true
                e.attEvent.lsBar := bar_index
                e.newLs.push(e.attEvent)
                e.lsTotal += 1
            e.weak := na
            e.since := 0
            e.breakBar := bar_index
            e.att := false
        if choch
            // A CHoCH: the trend holds until the Transition conditions are met.
            e.startAttempt(-d, e.prot, levelAt(d, e.prot.bar), TREND, false)
        if stale
            e.toCons()
    if st == TRANS
        bool bos = not na(e.weak) and (d > 0 ? c > e.weak.price : c < e.weak.price)
        bool broke = not bos and not na(e.prot) and (d > 0 ? c < e.prot.price : c > e.prot.price)
        bool resumes = broke and e.resume == TREND and (d > 0 ? c < e.inval.price : c > e.inval.price)
        bool stale = not bos and not broke and e.since >= MAX_SWINGS
        if bos
            // The second break: a trend.
            e.addEvent(d, true, e.weak)
            e.setState(TREND, d)
            e.weak := na
            e.since := 0
            e.breakBar := bar_index
        if resumes
            // Beyond the old trend's extreme too: the old trend resumes.
            e.addEvent(-d, true, e.inval)
            e.setState(TREND, -d)
            e.since := 0
            e.breakBar := bar_index
            e.weak := na
            // Its strong level: the latest swing on that side since the old
            // extreme, else the extreme since then.
            B3Point q = d > 0 ? e.lastHigh : e.lastLow
            e.prot := not na(q) and q.bar > e.inval.bar ? B3Level.new(q.price, q.bar, q.t) : levelAt(d, e.inval.bar)
        if broke and not resumes
            // The Transition broke its own structure: that break waits.
            B3Level level = e.prot
            e.toCons()
            e.startAttempt(-d, level, levelAt(d, level.bar), CONS, false)
        if stale
            e.toCons()
    if st == CONS and not e.att
        [hi, lo] = consRange(e)
        bool upBreak = not na(hi) and c > hi.price
        bool downBreak = not upBreak and not na(lo) and c < lo.price
        if upBreak
            B3Level origin = not na(e.lastLow) ? B3Level.new(e.lastLow.price, e.lastLow.bar, e.lastLow.t) : levelAt(-1, hi.bar)
            e.startAttempt(1, hi, origin, CONS, d > 0)
        if downBreak
            B3Level origin = not na(e.lastHigh) ? B3Level.new(e.lastHigh.price, e.lastHigh.bar, e.lastHigh.t) : levelAt(1, lo.bar)
            e.startAttempt(-1, lo, origin, CONS, d < 0)
    e

// One closed candle: main swings, internal swings, internal breaks, then the
// close against the structure's levels. `unit` is this candle's swing unit
// (K x ATR) and `atr` its ATR.
method step(B3Engine e, float unit, float atr, float k) =>
    e.newPoints.clear()
    e.newEvents.clear()
    e.newLs.clear()
    e.newInternal.clear()
    if e.units.size() == 0
        e.unitFirst := bar_index
    e.units.push(unit)
    e.atrs.push(atr)
    if e.units.size() > MAX_SCAN + 1
        e.units.shift()
        e.atrs.shift()
        e.unitFirst += 1
    e.k := k
    for p in zigStep(e.main, e, 1.0)
        e.onSwing(p)
    for p in zigStep(e.inner, e, internalRatio)
        if p.side > 0
            e.ihPrice := p.price
            e.ihBar := p.bar
            e.ihConfirmed := bar_index
            e.ihBroken := false
        if p.side < 0
            e.ilPrice := p.price
            e.ilBar := p.bar
            e.ilConfirmed := bar_index
            e.ilBroken := false
    e.internalBreak(1)
    e.internalBreak(-1)
    e.onClose()
    // The running extreme since the latest break, for the Weak level.
    if e.st != CONS and e.breakBar >= 0 and (e.trailFrom != e.breakBar or e.trailDir != e.d)
        [b, v] = extremeSince(e.d, e.breakBar)
        e.trail := v
        e.trailBar := b
        e.trailFrom := e.breakBar
        e.trailDir := e.d
    if e.st != CONS and e.breakBar >= 0 and e.trailFrom == e.breakBar and e.trailDir == e.d and (e.d > 0 ? high >= e.trail : low <= e.trail)
        e.trail := e.d > 0 ? high : low
        e.trailBar := bar_index
    e

// Average true range over SWING_ATR_LENGTH candles (fewer at the start), as
// Base 2.0.mq5's SwingATR.
swingAtrSeries() =>
    float tr = ta.tr(true)
    float avg = ta.sma(tr, SWING_ATR_LENGTH)
    float acc = ta.cum(tr)
    na(avg) ? acc / (bar_index + 1) : avg

// The swing size in ATR (see Base 2.0.mq5's SwingSize): the base size times
// `factor`. Fixed: the base is 1 ATR. Auto: AUTO_SCALE / sqrt(VR - 1) within
// K_MIN..K_MAX, VR the variance ratio of the last VR_WINDOW closes.
swingSize(float factor) =>
    float m1 = bar_index >= 1 ? close - close[1] : 0.0
    float mN = bar_index >= VR_LAG ? close - close[VR_LAG] : 0.0
    float c1 = ta.cum(m1 * m1)
    float cN = ta.cum(mN * mN)
    float s1 = c1 - (bar_index >= VR_WINDOW ? c1[VR_WINDOW] : 0.0)
    float sN = cN - (bar_index >= VR_WINDOW ? cN[VR_WINDOW] : 0.0)
    float size = K_MAX
    if bar_index >= VR_LAG and s1 > 0
        float excess = sN / (VR_LAG * s1) - 1.0
        if excess > 0
            size := math.min(K_MAX, math.max(K_MIN, AUTO_SCALE / math.sqrt(excess)))
    swingMode == "Auto" ? size * factor : factor

// Trend quality (see Base 2.0.mq5's TrendQuality): the efficiency of the last
// qualityCandles closes and the net move's direction; na until there are
// enough closes.
qualitySeries() =>
    float net = close - close[qualityCandles]
    float path = math.sum(math.abs(close - close[1]), qualityCandles)
    float q = na(net) or na(path) ? na : path > 0 ? math.abs(net) / path : 0.0
    [q, na(net) ? 0 : net > 0 ? 1 : net < 0 ? -1 : 0]

// A break as a code: 1 bullish BOS, 2 bearish BOS, 3 bullish CHoCH, 4
// bearish CHoCH, 5 a bullish break relabelled LS, 6 a bearish one.
eventCode(B3Event ev) =>
    ev.ls ? (ev.dir > 0 ? 5 : 6) : ev.bos ? (ev.dir > 0 ? 1 : 2) : (ev.dir > 0 ? 3 : 4)

// ---------------------------------------------------------------- requests
// The structure of the timeframe this runs on (inside request.security),
// after its last closed candle ([1] with lookahead on, so nothing repaints).
structureRequest(float factor) =>
    var B3Engine e = newEngine()
    float atr = swingAtrSeries()
    float k = swingSize(factor)
    e.step(k * atr, atr, k)
    int code = 0
    for ev in e.newLs
        code := code * 10 + eventCode(ev)
    for ev in e.newEvents
        code := code * 10 + eventCode(ev)
    [hi, lo] = consRange(e)
    float weak = not na(e.weak) ? e.weak.price : e.trail
    int st = e.st
    int dir = e.d
    int att = e.att ? e.attU : 0
    float attBroken = e.att ? e.attBroken.price : na
    float attOrigin = e.att ? e.attOrigin.price : na
    float prot = na(e.prot) ? na : e.prot.price
    float inval = na(e.inval) ? na : e.inval.price
    float transBreak = na(e.transBreak) ? na : e.transBreak.price
    int byInternal = e.byInternal ? 1 : 0
    float rangeHi = na(hi) ? na : hi.price
    float rangeLo = na(lo) ? na : lo.price
    float lastHigh = na(e.lastHigh) ? na : e.lastHigh.price
    int highKind = na(e.lastHigh) ? 0 : e.lastHigh.equal ? 2 : e.lastHigh.kind
    float prevHigh = na(e.prevHigh) ? na : e.prevHigh.price
    float lastLow = na(e.lastLow) ? na : e.lastLow.price
    int lowKind = na(e.lastLow) ? 0 : e.lastLow.equal ? 2 : e.lastLow.kind
    float prevLow = na(e.prevLow) ? na : e.prevLow.price
    int idir = e.idir
    int ibos = e.ibos ? 1 : 0
    int changed = e.changedBar == bar_index ? 1 : 0
    int count = e.seq + e.lsTotal
    [q, qd] = qualitySeries()
    [st[1], dir[1], att[1], attBroken[1], attOrigin[1], weak[1], prot[1], inval[1], transBreak[1], byInternal[1], rangeHi[1], rangeLo[1], lastHigh[1], highKind[1], prevHigh[1], lastLow[1], lowKind[1], prevLow[1], idir[1], ibos[1], k[1], changed[1], code[1], count[1], q[1], qd[1]]

[hSt, hDir, hAtt, hAttBroken, hAttOrigin, hWeak, hProt, hInval, hTransBreak, hByInternal, hRangeHi, hRangeLo, hLastHigh, hHighKind, hPrevHigh, hLastLow, hLowKind, hPrevLow, hIdir, hIbos, hK, hChanged, hCode, hCount, hQuality, hQualityDir] = request.security(syminfo.tickerid, htfTf, structureRequest(levelFactor(htfLevel)), lookahead = barmerge.lookahead_on)
[mSt, mDir, mAtt, mAttBroken, mAttOrigin, mWeak, mProt, mInval, mTransBreak, mByInternal, mRangeHi, mRangeLo, mLastHigh, mHighKind, mPrevHigh, mLastLow, mLowKind, mPrevLow, mIdir, mIbos, mK, mChanged, mCode, mCount, mQuality, mQualityDir] = request.security(syminfo.tickerid, mtfTf, structureRequest(levelFactor(mtfLevel)), lookahead = barmerge.lookahead_on)
[lSt, lDir, lAtt, lAttBroken, lAttOrigin, lWeak, lProt, lInval, lTransBreak, lByInternal, lRangeHi, lRangeLo, lLastHigh, lHighKind, lPrevHigh, lLastLow, lLowKind, lPrevLow, lIdir, lIbos, lK, lChanged, lCode, lCount, lQuality, lQualityDir] = request.security(syminfo.tickerid, ltfTf, structureRequest(levelFactor(ltfLevel)), lookahead = barmerge.lookahead_on)

// ---------------------------------------------------------- chart structure
// The chart's own timeframe, one confirmed candle at a time.
chartSeconds = timeframe.in_seconds()
htfSeconds = timeframe.in_seconds(htfTf)
displayBars = math.max(50, int(math.ceil(float(barsToProcess) * htfSeconds / math.max(chartSeconds, 1))))
drawFrom = last_bar_index - displayBars
float chartAtr = swingAtrSeries()
// The chart uses the Swing Sensitivity of the matching HTF, MTF or LTF input;
// any other chart timeframe uses the HTF's.
chartLevel = chartSeconds == timeframe.in_seconds(htfTf) ? htfLevel : chartSeconds == timeframe.in_seconds(mtfTf) ? mtfLevel : chartSeconds == timeframe.in_seconds(ltfTf) ? ltfLevel : htfLevel
float chartK = swingSize(levelFactor(chartLevel))
var B3Engine chartEngine = newEngine()

swingName(B3Point p) =>
    p.equal ? (p.side > 0 ? "EQH" : "EQL") : p.side > 0 ? (p.kind > 0 ? "HH" : "LH") : (p.kind > 0 ? "LL" : "HL")

// A caption centred on its line: above a line broken upwards, below one
// broken downwards.
breakLabel(B3Event ev, string txt, color textColor) =>
    label.new(int(math.round(0.5 * (ev.swingBar + ev.endBar))), ev.level, txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = ev.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = textColor, size = labelSize)

// The drawing of the break waiting for the Transition conditions, replaced if
// it fails (LS). Main swings are kept so that an internal break of the same
// swing is left to the main structure.
var int waitingSeq = -1
var label waitingLabel = na
var line waitingLine = na
var array<int> mainSides = array.new<int>()
var array<int> mainBars = array.new<int>()
var array<line> internalLines = array.new<line>()
var array<label> internalLabels = array.new<label>()
var array<int> internalSides = array.new<int>()
var array<int> internalBars = array.new<int>()
MAX_INTERNAL_KEPT = 120
MAX_MAIN_KEPT = 400

isMainSwing(int side, int bar) =>
    bool found = false
    int n = mainBars.size()
    if n > 0
        for j = n - 1 to 0
            if mainBars.get(j) == bar and mainSides.get(j) == side
                found := true
                break
    found

if barstate.isconfirmed
    chartEngine.step(chartK * chartAtr, chartAtr, chartK)
    for p in chartEngine.newPoints
        mainSides.push(p.side)
        mainBars.push(p.bar)
        if showSwings and p.kind != 0 and p.bar >= drawFrom
            color swingColor = p.side > 0 ? HIGH_COLOR : LOW_COLOR
            label.new(p.t, p.price, swingName(p), xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = p.side > 0 ? label.style_label_down : label.style_label_up, textcolor = swingColor, size = labelSize)
            if p.equal and p.equalBar >= drawFrom
                line.new(p.equalTime, p.equalPrice, p.t, p.price, xloc = xloc.bar_time, color = swingColor, style = line.style_dotted, width = 1)
        // An internal break of this swing is left to the main structure.
        int kept = internalSides.size()
        if kept > 0
            for j = kept - 1 to 0
                if internalSides.get(j) == p.side and internalBars.get(j) == p.bar
                    line.delete(internalLines.get(j))
                    label.delete(internalLabels.get(j))
                    internalLines.remove(j)
                    internalLabels.remove(j)
                    internalSides.remove(j)
                    internalBars.remove(j)
    while mainBars.size() > MAX_MAIN_KEPT
        mainBars.shift()
        mainSides.shift()
    // A failed break is redrawn as an LS in its place.
    for ev in chartEngine.newLs
        if ev.seq == waitingSeq
            label.delete(waitingLabel)
            line.delete(waitingLine)
            waitingSeq := -1
            if showBreaks and ev.swingBar >= drawFrom
                breakLabel(ev, "LS", LS_COLOR)
                line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = LS_COLOR, style = line.style_solid, width = 2)
    for ev in chartEngine.newEvents
        label lbl = na
        line ln = na
        if showBreaks and ev.swingBar >= drawFrom
            color clr = ev.bos ? BOS_COLOR : CHOCH_COLOR
            lbl := breakLabel(ev, ev.bos ? "BOS" : "CHoCH", clr)
            ln := line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = clr, style = line.style_solid, width = 2)
        // Only the break waiting for the Transition conditions can still fail.
        if chartEngine.att and ev.seq == chartEngine.attEvent.seq
            waitingSeq := na(lbl) ? -1 : ev.seq
            waitingLabel := lbl
            waitingLine := ln
    for ev in chartEngine.newInternal
        if showInternal and bar_index >= drawFrom and not isMainSwing(ev.dir, ev.swingBar)
            color clr = ev.dir > 0 ? INTERNAL_BULL_COLOR : INTERNAL_BEAR_COLOR
            internalLines.push(line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = clr, style = line.style_dashed, width = 1))
            internalLabels.push(label.new(int(math.round(0.5 * (ev.swingBar + ev.endBar))), ev.level, ev.bos ? "BOS" : "CHoCH", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = ev.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = color.new(clr, 30), size = labelSize))
            internalSides.push(ev.dir)
            internalBars.push(ev.swingBar)
    while internalSides.size() > MAX_INTERNAL_KEPT
        internalLines.shift()
        internalLabels.shift()
        internalSides.shift()
        internalBars.shift()

var line lastHighLine = na
var line lastLowLine = na
var line strongWeakHighLine = na
var line strongWeakLowLine = na
var label strongWeakHighLabel = na
var label strongWeakLowLabel = na
if barstate.islast
    line.delete(lastHighLine)
    line.delete(lastLowLine)
    line.delete(strongWeakHighLine)
    line.delete(strongWeakLowLine)
    label.delete(strongWeakHighLabel)
    label.delete(strongWeakLowLabel)
    // Strong/Weak High/Low: dashed lines to 20 candles right of the latest
    // candle, with their names just right of the line ends.
    int rightTime = time + 20 * chartSeconds * 1000
    B3Engine ce = chartEngine
    [cHi, cLo] = consRange(ce)
    bool cons = ce.st == CONS
    float weakPrice = not na(ce.weak) ? ce.weak.price : ce.trail
    int weakTime = not na(ce.weak) ? ce.weak.t : ce.trailBar >= 0 ? time[math.min(bar_index - ce.trailBar, MAX_SCAN)] : na
    float hiLevel = cons ? (na(cHi) ? na : cHi.price) : ce.d > 0 ? weakPrice : (na(ce.prot) ? na : ce.prot.price)
    int hiTime = cons ? (na(cHi) ? na : cHi.t) : ce.d > 0 ? weakTime : (na(ce.prot) ? na : ce.prot.t)
    string hiName = cons ? "Range High" : ce.d > 0 ? "Weak High" : "Strong High"
    float loLevel = cons ? (na(cLo) ? na : cLo.price) : ce.d < 0 ? weakPrice : (na(ce.prot) ? na : ce.prot.price)
    int loTime = cons ? (na(cLo) ? na : cLo.t) : ce.d < 0 ? weakTime : (na(ce.prot) ? na : ce.prot.t)
    string loName = cons ? "Range Low" : ce.d < 0 ? "Weak Low" : "Strong Low"
    if showStrongWeak and not na(hiLevel) and not na(hiTime)
        strongWeakHighLine := line.new(hiTime, hiLevel, rightTime, hiLevel, xloc = xloc.bar_time, color = HIGH_COLOR, style = line.style_dashed, width = 1)
        strongWeakHighLabel := label.new(rightTime, hiLevel, hiName, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = HIGH_COLOR, size = labelSize)
    if showStrongWeak and not na(loLevel) and not na(loTime)
        strongWeakLowLine := line.new(loTime, loLevel, rightTime, loLevel, xloc = xloc.bar_time, color = LOW_COLOR, style = line.style_dashed, width = 1)
        strongWeakLowLabel := label.new(rightTime, loLevel, loName, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = LOW_COLOR, size = labelSize)
    if showSwings and not na(ce.lastHigh)
        lastHighLine := line.new(ce.lastHigh.t, ce.lastHigh.price, time, ce.lastHigh.price, xloc = xloc.bar_time, color = HIGH_COLOR, style = line.style_dotted, width = 1)
    if showSwings and not na(ce.lastLow)
        lastLowLine := line.new(ce.lastLow.t, ce.lastLow.price, time, ce.lastLow.price, xloc = xloc.bar_time, color = LOW_COLOR, style = line.style_dotted, width = 1)

// ------------------------------------------------------------------ texts
// A timeframe's structure as its request returned it.
type TfView
    int st
    int dir
    int att
    float attBroken
    float attOrigin
    float weak
    float prot
    float inval
    float transBreak
    bool byInternal
    float rangeHi
    float rangeLo
    float lastHigh
    int highKind
    float prevHigh
    float lastLow
    int lowKind
    float prevLow
    int idir
    bool ibos
    float k

newView(int st, int dir, int att, float attBroken, float attOrigin, float weak, float prot, float inval, float transBreak, int byInternal, float rangeHi, float rangeLo, float lastHigh, int highKind, float prevHigh, float lastLow, int lowKind, float prevLow, int idir, int ibos, float k) =>
    TfView.new(nz(st), nz(dir), nz(att), attBroken, attOrigin, weak, prot, inval, transBreak, nz(byInternal) == 1, rangeHi, rangeLo, lastHigh, nz(highKind), prevHigh, lastLow, nz(lowKind), prevLow, nz(idir), nz(ibos) == 1, k)

htfView = newView(hSt, hDir, hAtt, hAttBroken, hAttOrigin, hWeak, hProt, hInval, hTransBreak, hByInternal, hRangeHi, hRangeLo, hLastHigh, hHighKind, hPrevHigh, hLastLow, hLowKind, hPrevLow, hIdir, hIbos, hK)
mtfView = newView(mSt, mDir, mAtt, mAttBroken, mAttOrigin, mWeak, mProt, mInval, mTransBreak, mByInternal, mRangeHi, mRangeLo, mLastHigh, mHighKind, mPrevHigh, mLastLow, mLowKind, mPrevLow, mIdir, mIbos, mK)
ltfView = newView(lSt, lDir, lAtt, lAttBroken, lAttOrigin, lWeak, lProt, lInval, lTransBreak, lByInternal, lRangeHi, lRangeLo, lLastHigh, lHighKind, lPrevHigh, lLastLow, lLowKind, lPrevLow, lIdir, lIbos, lK)

tfName(string tf) =>
    int secs = timeframe.in_seconds(tf)
    string s = ""
    if secs < 60
        s := str.tostring(secs) + "S"
    else if secs < 3600
        s := "M" + str.tostring(int(secs / 60))
    else if secs < 86400
        s := "H" + str.tostring(int(secs / 3600))
    else if secs < 604800
        s := "D" + str.tostring(int(secs / 86400))
    else if secs < 2419200
        s := "W" + str.tostring(int(secs / 604800))
    else
        s := "MN" + str.tostring(int(math.round(secs / 2592000)))
    s

priceText(float p) =>
    str.tostring(p, format.mintick)

directionWord(int d) =>
    d > 0 ? "bullish" : "bearish"

stateText(TfView v) =>
    v.st == CONS ? "Consolidation" : (v.dir > 0 ? "Bullish " : "Bearish ") + (v.st == TREND ? "Trending" : "Transition")

// The dashboard output: the state, and a break waiting for the Transition
// conditions.
stateOutput(TfView v) =>
    stateText(v) + (v.att != 0 ? (v.st == TREND ? " (CHoCH)" : " (" + directionWord(v.att) + " break)") : "")

viewDirection(TfView v) =>
    v.st == CONS ? 0 : v.dir

swingTag(int side, int kind) =>
    kind == 2 ? (side > 0 ? "EQH" : "EQL") : kind == 0 ? (side > 0 ? "first high" : "first low") : side > 0 ? (kind > 0 ? "HH" : "LH") : (kind > 0 ? "LL" : "HL")

swingStructureText(TfView v) =>
    (na(v.lastHigh) ? "no swing high yet" : swingTag(1, v.highKind)) + " + " + (na(v.lastLow) ? "no swing low yet" : swingTag(-1, v.lowKind))

swingProgression(TfView v) =>
    na(v.prevHigh) or na(v.prevLow) or na(v.lastHigh) or na(v.lastLow) ? 0 : v.lastHigh > v.prevHigh and v.lastLow > v.prevLow ? 1 : v.lastLow < v.prevLow and v.lastHigh < v.prevHigh ? -1 : 0

latestSwingsText(TfView v) =>
    (na(v.lastHigh) ? "no swing high yet" : swingTag(1, v.highKind) + " " + priceText(v.lastHigh)) + " | " + (na(v.lastLow) ? "no swing low yet" : swingTag(-1, v.lowKind) + " " + priceText(v.lastLow))

levelText(string name, float p) =>
    name + " " + (na(p) ? "none yet" : priceText(p))

strongWeakText(TfView v) =>
    string s = ""
    if v.st == CONS
        s := levelText("Range High", v.rangeHi) + " | " + levelText("Range Low", v.rangeLo)
    else if v.dir > 0
        s := levelText("Weak High", v.weak) + " | " + levelText("Strong Low", v.prot)
    else
        s := levelText("Strong High", v.prot) + " | " + levelText("Weak Low", v.weak)
    s

whyText(TfView v) =>
    string s = "no trending or transitional structure within the last " + str.tostring(MAX_SWINGS) + " swings"
    if v.st == TREND
        s := "two " + directionWord(v.dir) + " breaks with a " + (v.dir > 0 ? "higher low" : "lower high") + " between them; the trend holds while price closes " + (v.dir > 0 ? "above the strong low" : "below the strong high")
    if v.st == TRANS
        s := "a " + directionWord(v.dir) + " break through " + priceText(v.transBreak) + ", then " + (v.byInternal ? "two internal BOS " + (v.dir > 0 ? "up" : "down") : (v.dir > 0 ? "a higher low" : "a lower high") + " at " + priceText(v.prot) + " that held " + priceText(v.inval)) + "; a BOS through the " + (v.dir > 0 ? "weak high" : "weak low") + " makes it Trending"
    s

waitingText(TfView v) =>
    string s = ""
    if v.att != 0
        int u = v.att
        s := "A " + directionWord(u) + " " + (v.st == TREND ? "CHoCH" : "break") + " through " + priceText(v.attBroken) + " is waiting: a " + (u > 0 ? "higher low" : "lower high") + " that holds " + priceText(v.attOrigin) + ", or two internal BOS " + (u > 0 ? "up" : "down") + ", makes it a " + (u > 0 ? "Bullish" : "Bearish") + " Transition; two internal breaks " + (u > 0 ? "down" : "up") + " or a close " + (u > 0 ? "below " : "above ") + priceText(v.attOrigin) + " make it an LS."
    s

breakdownText(TfView v, int level) =>
    string s = "Market Trend: " + stateText(v) + "\nWhy: " + whyText(v) + "\nLatest Swings: " + latestSwingsText(v) + "\nStrong/Weak: " + strongWeakText(v) + "\nSwing Size: " + str.tostring(v.k, "0.00") + " ATR (" + (swingMode == "Auto" ? "Auto" : "Fixed") + ", level " + str.tostring(level) + "), internal " + str.tostring(v.k * internalRatio, "0.00") + " ATR"
    string w = waitingText(v)
    s + (w == "" ? "" : "\n" + w)

internalText(TfView v) =>
    v.idir == 0 ? "No break yet" : (v.idir > 0 ? "Bullish" : "Bearish") + (v.ibos ? " (BOS)" : " (CHoCH)")

// "H4", "H4 and M15" or "H4, M30 and M15": the timeframes Market Tradability
// uses.
tradabilityTimeframes() =>
    array<string> names = array.from(tfName(htfTf))
    if useMtf
        names.push(tfName(mtfTf))
    if useLtf
        names.push(tfName(ltfTf))
    string r = ""
    int count = names.size()
    for i = 0 to count - 1
        r := r + (i == 0 ? "" : i == count - 1 ? " and " : ", ") + names.get(i)
    r

stateWithVerb(TfView v) =>
    v.st == CONS ? "in Consolidation" : stateText(v)

// How the internal structure relates to its timeframe's Market Trend.
internalAgreementText(TfView v, string name) =>
    int d = viewDirection(v)
    string s = ""
    if v.idir == 0
        s := "The " + name + " internal structure has no break yet."
    else if d == 0
        s := "The " + name + " Market Trend is in Consolidation; the internal structure is " + directionWord(v.idir) + "."
    else if v.idir == d
        s := "Agrees with the " + name + " Market Trend."
    else
        s := "Opposes the " + name + " Market Trend: a " + directionWord(v.idir) + " move inside the " + directionWord(d) + " " + (v.st == TREND ? "trend" : "transition") + "."
    s

internalTooltip(TfView v, string name) =>
    "The latest break of the " + name + " internal structure (swings of " + str.tostring(internalRatio, "0.00") + " of the swing size, " + str.tostring(v.k * internalRatio, "0.00") + " ATR).\n" + internalAgreementText(v, name)

// Trend Quality on the dashboard: "0.42 up".
qualityText() =>
    na(hQuality) ? "Not available" : str.tostring(hQuality, "0.00") + (hQualityDir > 0 ? " up" : hQualityDir < 0 ? " down" : " flat")

// The HTF trend quality for a direction: "" when it is at least the minimum
// and its net move is in that direction, else why not.
qualityProblem(int d) =>
    string s = ""
    if na(hQuality)
        s := "the " + tfName(htfTf) + " trend quality needs " + str.tostring(qualityCandles + 1) + " closed candles"
    else if nz(hQualityDir) != d
        s := "the last " + str.tostring(qualityCandles) + " " + tfName(htfTf) + " candles moved against the trend"
    else if hQuality < qualityMin
        s := "the " + tfName(htfTf) + " trend quality " + str.tostring(hQuality, "0.00") + " is below " + str.tostring(qualityMin, "0.00") + " (too choppy)"
    s

// A timeframe's swings for a direction: "" when they are progressive, else
// what is missing.
swingProblem(TfView v, int d, string name) =>
    bool highs = not na(v.lastHigh) and not na(v.prevHigh)
    bool lows = not na(v.lastLow) and not na(v.prevLow)
    string s = ""
    if not highs or not lows
        s := "the " + name + " has no two swing " + (not highs ? "highs" : "lows") + " yet"
    else if swingProgression(v) != d
        s := "the " + name + " swings are " + swingStructureText(v) + " (" + directionWord(d) + " needs " + (d > 0 ? "HH + HL" : "LL + LH") + ")"
    s

// The HTF internal structure for a direction: "" when its latest break is
// that way, else what it is.
internalProblem(TfView v, int d, string name) =>
    v.idir == d ? "" : "the " + name + " internal structure is " + (v.idir == 0 ? "without a break" : directionWord(v.idir)) + ", not " + directionWord(d)

// Market Tradability (see Base 2.0.mq5's EvaluateTradability): Tradable when
// the HTF is Trending, every selected MTF/LTF is Trending or in Transition the
// same way, and the HTF trend quality is at least its minimum that way;
// optionally also progressive swings and the HTF internal structure.
evaluateTradability(TfView htf, TfView mtf, TfView ltf) =>
    bool tradable = false
    string reason = ""
    string h = tfName(htfTf)
    if htf.st == CONS
        reason := h + " is in Consolidation: no trending or transitional structure within the last " + str.tostring(MAX_SWINGS) + " swings."
    else if htf.st == TRANS
        reason := h + " is in a " + stateText(htf) + ": wait for the BOS that makes it Trending."
    else
        int d = htf.dir
        bool mBad = useMtf and viewDirection(mtf) != d
        bool lBad = useLtf and viewDirection(ltf) != d
        if mBad or lBad
            string first = mBad ? tfName(mtfTf) + " is " + stateWithVerb(mtf) : tfName(ltfTf) + " is " + stateWithVerb(ltf)
            reason := h + " is " + stateText(htf) + ", but " + first + (mBad and lBad ? " and " + tfName(ltfTf) + " is " + stateWithVerb(ltf) : "") + "."
        else
            array<string> problems = array.new<string>()
            for p in array.from(qualityProblem(d), requireSwings ? swingProblem(htf, d, h) : "", requireSwings and useMtf ? swingProblem(mtf, d, tfName(mtfTf)) : "", requireSwings and useLtf ? swingProblem(ltf, d, tfName(ltfTf)) : "", requireInternal ? internalProblem(htf, d, h) : "")
                if p != ""
                    problems.push(p)
            string lead = (useMtf or useLtf ? tradabilityTimeframes() + " agree: " : "") + h + " is " + stateText(htf)
            if problems.size() > 0
                reason := lead + ", but " + problems.join("; ") + "."
            else
                tradable := true
                reason := lead + " and the " + h + " trend quality " + str.tostring(hQuality, "0.00") + " is at least " + str.tostring(qualityMin, "0.00") + (requireSwings ? ", with " + (d > 0 ? "HH + HL" : "LL + LH") : "") + (requireInternal ? ", the " + h + " internal structure agrees" : "") + "."
                if htf.att != 0
                    reason := reason + " A " + directionWord(htf.att) + " CHoCH is waiting (see the Market Trend tooltip)."
    [tradable, reason]

// What to do on the HTF's structure (see Base 2.0.mq5's RecommendationText).
recommendationText(TfView v) =>
    int d = v.dir
    bool up = d > 0
    float strong = v.prot
    float weak = v.weak
    string s = ""
    if v.st == CONS
        s := "Stand aside" + (not na(v.rangeHi) and not na(v.rangeLo) ? " or trade only the range edges (" + priceText(v.rangeLo) + " to " + priceText(v.rangeHi) + "); a close beyond either starts a break" : "") + (v.att != 0 ? "; a " + directionWord(v.att) + " break is waiting for its Transition" : "") + "."
    else if v.st == TRANS
        s := "A " + stateText(v) + ": wait for the BOS" + (not na(weak) ? (up ? " above " : " below ") + priceText(weak) : "") + " before " + (up ? "buying" : "selling") + (not na(strong) ? "; a close " + (up ? "below " : "above ") + priceText(strong) + " breaks it" : "") + "."
    else if v.att != 0
        s := "A " + directionWord(v.att) + " CHoCH through " + priceText(v.attBroken) + " is waiting: hold off until a " + (up ? "lower high" : "higher low") + " (a Transition) or an LS resolves it."
    else
        s := "Look for " + (up ? "buys" : "sells") + " on pullbacks while price holds " + (up ? "above the strong low " : "below the strong high ") + (not na(strong) ? priceText(strong) : "") + (not na(weak) ? "; a close " + (up ? "above the weak high " : "below the weak low ") + priceText(weak) + " continues the trend" : "") + "."
    s

// The dashboard's recommendation: the HTF's, unless a selected lower
// timeframe or Market Tradability holds the HTF trend back.
tradeRecommendation(TfView htf, TfView mtf, TfView ltf, bool tradable) =>
    string s = recommendationText(htf)
    if not tradable and htf.st == TREND and htf.att == 0
        int d = htf.dir
        string action = d > 0 ? "buying" : "selling"
        string lead = tfName(htfTf) + " is " + stateText(htf) + ", but wait for "
        if useMtf and viewDirection(mtf) != d
            s := lead + tfName(mtfTf) + " to turn " + directionWord(d) + " before " + action + "."
        else if useLtf and viewDirection(ltf) != d
            s := lead + tfName(ltfTf) + " to turn " + directionWord(d) + " before " + action + "."
        else
            s := lead + "Market Tradability (see Tradability Reason) before " + action + "."
    s

// ---------------------------------------------------------------- dashboard
dashPosition = dashPositionInput == "Top Left" ? position.top_left : dashPositionInput == "Bottom Left" ? position.bottom_left : dashPositionInput == "Bottom Right" ? position.bottom_right : position.top_right
// Component names are black and bold, and only the outputs are coloured:
// green bullish / Tradable / good quality, red bearish / Not Tradable / poor
// quality, grey Consolidation.
DASH_TEXT_COLOR = color.black
var table dash = table.new(dashPosition, 2, 24, bgcolor = color.new(color.white, 100), frame_width = 0, border_width = 0)

dirColor(int d) =>
    d > 0 ? color.green : d < 0 ? color.red : color.gray

passColor(bool pass) =>
    pass ? color.green : color.red

dashRow(int row, string component, string output, color outputColor, string tip) =>
    table.cell(dash, 0, row, component, text_color = DASH_TEXT_COLOR, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip, text_formatting = text.format_bold)
    table.cell(dash, 1, row, output, text_color = outputColor, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip)

// A long output wraps onto new lines of at most DASH_WRAP_CHARS characters,
// broken between words.
DASH_WRAP_CHARS = 48
wrapText(string s) =>
    array<string> words = str.split(s, " ")
    string out = ""
    string current = ""
    int n = words.size()
    if n > 0
        for i = 0 to n - 1
            string w = words.get(i)
            if w != ""
                if current != "" and str.length(current) + 1 + str.length(w) > DASH_WRAP_CHARS
                    out := out + (out == "" ? "" : "\n") + current
                    current := ""
                current := current + (current == "" ? "" : " ") + w
    out + (out == "" or current == "" ? "" : "\n") + current

// One timeframe: its Market Trend (the breakdown is the tooltip) and its
// internal structure.
timeframeRows(int row, string title, TfView v, string name, int level) =>
    dashRow(row, title, stateOutput(v), dirColor(viewDirection(v)), breakdownText(v, level))
    int next = row + 1
    if showInternalOnDashboard
        dashRow(next, "   Internal Structure:", internalText(v), dirColor(v.idir), internalTooltip(v, name))
        next += 1
    next

if barstate.islast
    table.clear(dash, 0, 0, 1, 23)
    int row = timeframeRows(0, "HTF Market Trend (" + tfName(htfTf) + "):", htfView, tfName(htfTf), htfLevel)
    if useMtf
        row := timeframeRows(row, "MTF Market Trend (" + tfName(mtfTf) + "):", mtfView, tfName(mtfTf), mtfLevel)
    if useLtf
        row := timeframeRows(row, "LTF Market Trend (" + tfName(ltfTf) + "):", ltfView, tfName(ltfTf), ltfLevel)
    dashRow(row, "Trend Quality (" + tfName(htfTf) + "):", qualityText(), na(hQuality) or htfView.st != TREND ? color.gray : passColor(hQuality >= qualityMin and nz(hQualityDir) == htfView.dir), "Efficiency of the last " + str.tostring(qualityCandles) + " closed " + tfName(htfTf) + " candles: the net move divided by the distance travelled close to close, from 0 (chop) to 1 (a straight line), and its direction. Market Tradability needs at least " + str.tostring(qualityMin, "0.00") + " in the trend's direction.")
    [tradable, reason] = evaluateTradability(htfView, mtfView, ltfView)
    dashRow(row + 1, "Market Tradability:", tradable ? "Tradable" : "Not Tradable", passColor(tradable), "Tradable when the HTF is Trending, every selected MTF/LTF is Trending or in Transition the same way, and the HTF trend quality is at least " + str.tostring(qualityMin, "0.00") + " that way.")
    dashRow(row + 2, "Tradability Reason:", wrapText(reason), DASH_TEXT_COLOR, "")
    dashRow(row + 3, "Trade Recommendations:", wrapText(tradeRecommendation(htfView, mtfView, ltfView, tradable)), DASH_TEXT_COLOR, "")

// ------------------------------------------------------------------- alerts
// The digits of a code, oldest first.
codeDigits(int code) =>
    array<int> digits = array.new<int>()
    string raw = code > 0 ? str.tostring(code) : ""
    int len = str.length(raw)
    if len > 0
        for i = 0 to len - 1
            digits.push(int(str.tonumber(str.substring(raw, i, i + 1))))
    digits

// The HTF breaks of its latest closed candle, as Base 2.0.mq5's alerts word
// them.
eventsText(int code) =>
    string s = ""
    for d in codeDigits(code)
        string one = d == 5 ? "LS (the bullish break failed)" : d == 6 ? "LS (the bearish break failed)" : (d == 1 or d == 2 ? "BOS " : "CHoCH ") + (d == 1 or d == 3 ? "bullish" : "bearish")
        s := s + (s == "" ? "" : " + ") + one
    s

// A new HTF candle closed on this chart candle (its request values changed).
bool newHtfBar = ta.change(time(htfTf)) != 0
int newCode = nz(hCode)
bool newBreaks = nz(hCount) != nz(hCount[1]) and newCode > 0
bool newState = newHtfBar and nz(hChanged) == 1
if enableAlerts and (newBreaks or newState)
    string msg = eventsText(newBreaks ? newCode : 0)
    if newState
        msg := msg + (msg == "" ? "" : "; ") + "now " + stateText(htfView)
    alert(syminfo.ticker + " " + tfName(htfTf) + " " + msg, alert.freq_once_per_bar)
string newCodeText = str.tostring(newCode)
alertcondition(newBreaks and str.contains(newCodeText, "1"), "HTF bullish BOS", "{{ticker}}: bullish BOS on the HTF")
alertcondition(newBreaks and str.contains(newCodeText, "2"), "HTF bearish BOS", "{{ticker}}: bearish BOS on the HTF")
alertcondition(newBreaks and str.contains(newCodeText, "3"), "HTF bullish CHoCH", "{{ticker}}: bullish CHoCH on the HTF")
alertcondition(newBreaks and str.contains(newCodeText, "4"), "HTF bearish CHoCH", "{{ticker}}: bearish CHoCH on the HTF")
alertcondition(newBreaks and (str.contains(newCodeText, "5") or str.contains(newCodeText, "6")), "HTF LS (a break failed)", "{{ticker}}: a break failed (LS) on the HTF")
alertcondition(newState and htfView.st == TREND, "HTF now Trending", "{{ticker}}: the HTF is now Trending")
alertcondition(newState and htfView.st == TRANS, "HTF now in Transition", "{{ticker}}: the HTF is now in Transition")
alertcondition(newState and htfView.st == CONS, "HTF now in Consolidation", "{{ticker}}: the HTF is now in Consolidation")
