//@version=6
// 83% Strategy 2.0 - Base's market structure (Base.pine v2.44) with the 83%
// Strategy's Fibonacci entries, as a TradingView strategy. Same rules as
// 83% Strategy 2.0.mq5.
//
// Market direction: the HTF Market Trend. In a bullish market (Bullish or
// Bullish Transition) only buy setups are scanned, shown and traded; in a
// bearish market only sell setups; in Consolidation / Undefined none. A change
// of direction cancels the live setup and clears the drawn ones.
// Entries need, in the setup's direction:
//  * Market Tradability to read Tradable: the HTF trend Bullish (Bearish) by a
//    BOS, its swings an HH and an HL (an LL and an LH), its internal structure
//    bullish (bearish) by a BOS, and a Hurst exponent above 0.50;
//  * the MTF's most recent structure to be a BOS that formed an HH (LL): its
//    Market Trend Bullish (Bearish), not a Transition.
// Setup (LTF, M30, Swing Detection level 3, 25 independent processed bars):
// A is the most recent HL with heavy buying pressure; once a candle closes
// above the swing high before A (the break of structure), the Fibonacci runs
// from the highest high since A (0%, B, which follows price until it is a
// confirmed swing) back to A (100%), and the entry is at the Entry Fibonacci
// Level (83% by default). The setup is invalid once price makes a new HH
// beyond a confirmed B before the entry level. Bearish mirrors this. Only
// setups whose A lies within the processed bars are kept and shown.
// Risk: 5% per trade, at most 3 trades a day and none after 2 consecutive
// losses that day, Monday to Saturday; the stop goes behind A by an ATR buffer
// and the target just before B, at 1:2 or 1:3, whichever is closer; the stop
// moves to breakeven at 60% of the target.
//
// Run it on the LTF chart (30 minutes by default): setups, orders and the
// drawings (A / B / C, Fibonacci, target and stop zones) follow that chart.
//
// Market structure (as Base.pine), from closed candles only:
//  * HH/HL/LH/LL swings: pivots of each timeframe's Swing Detection Length
//    candles on each side (Smart Money Engine swing detection).
//  * Only identified swings are broken: a swing is identified once the
//    opposite leg after it has begun, so it can no longer be replaced and
//    stays marked on the chart.
//  * BOS: the most recent identified HH (LL) is broken by a close, creating a
//    new HH (LL).
//  * CHoCH: while the trend is not already bullish, the most recent identified
//    LH is broken by a close and the next swing high is an HH (bearish mirrors
//    this).
//  * EQH/EQL: a swing within the EQH/EQL Threshold (ATR) of the previous
//    swing on its side is an equal high/low. It keeps that swing's role, its
//    break level is the pair's outer edge, and it neither confirms nor
//    cancels a CHoCH.
//  * LS (liquidity sweep): a CHoCH that reversed a trend fails when, before
//    anything else prints, a close breaks its protected swing and the old
//    trend carries on beyond its extreme. The CHoCH is relabelled LS (deep
//    yellow) and the trend before it is restored.
//  * BOS, CHoCH and LS lines end on the first candle whose wick or body
//    touches their level. Captions are centred on the line: above a line
//    broken upwards, below one broken downwards.
//  * Trend: Bullish / Bearish after a BOS, Bullish / Bearish Transition after
//    a CHoCH, Consolidation / Undefined when the structure is sporadic or
//    trapped.
//  * Strong/Weak High/Low (Smart Money Engine): each break protects the
//    latest swing on the other side (Strong); the trend's trailing extreme is
//    Weak.
//  * Internal Structure (Smart Money Engine): minor BOS/CHoCH from shorter
//    pivots (Internal Structure Length).
strategy("83% Strategy 2.0", shorttitle = "83% 2.0", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_order_fills = false, process_orders_on_close = false, margin_long = 0, margin_short = 0, max_bars_back = 500, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ---------------------------------------------------------------- inputs
grpTf = "Timeframes"
htfTf = input.timeframe("240", "HTF", group = grpTf, tooltip = "Higher timeframe (HTF). Its Market Trend is the market's direction (buy setups in a bullish market, sell setups in a bearish one); with its swings, internal structure and the Hurst exponent it decides Market Tradability.")
mtfTf = input.timeframe("60", "MTF", group = grpTf, tooltip = "Middle timeframe (MTF). Entries need its latest break to be a BOS in the trade's direction: its Market Trend Bullish (an HH formed) for buys, Bearish (an LL formed) for sells.")
ltfTf = input.timeframe("30", "LTF", group = grpTf, tooltip = "Lower timeframe (LTF), the chart the strategy trades on: its setups, entries and drawings.")

grpHurst = "Hurst Exponent (Trend Persistence)"
hurstSource = input.string("HTF", "Hurst Timeframe", options = ["HTF", "MTF", "LTF"], group = grpHurst, tooltip = "The timeframe whose closes the Hurst exponent is measured on.")
hurstCandles = input.int(100, "Hurst Window (closed candles)", minval = 50, maxval = 400, group = grpHurst, tooltip = "How many closed candles, up to the latest, the Hurst exponent is measured over.")
hurstMin = input.float(0.50, "Tradable When H Is Above", minval = 0.0, maxval = 0.99, step = 0.01, group = grpHurst, tooltip = "Market Tradability needs the Hurst exponent above this. About 0.5 is a random walk, above it a trending (persistent) market, below it a mean-reverting one.")

grpProc = "Structure Bar Processing"
barsToProcess = input.int(100, "Bars To Process", minval = 100, maxval = 100000, group = grpProc, tooltip = "How many HTF candles back structure is drawn. Other chart timeframes cover the same span of time, except the LTF, which draws its processed bars. Structure is always calculated on all loaded history.")

grpSwing = "Swing Detection"
htfSwingLevel = input.int(3, "HTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the HTF swings (Smart Money Engine swing detection). 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
mtfSwingLevel = input.int(5, "MTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the MTF swings. 1 = finest, 10 = broadest.")
ltfSwingLevel = input.int(3, "LTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the LTF swings the setups are found on (3 by default). 1 = finest, 10 = broadest.")
showSwingPoints = input.bool(true, "Show Swing Points", group = grpSwing, tooltip = "Display the HH/HL/LH/LL (and EQH/EQL) swing labels and the dotted lines of the latest swing high and low.")
showStrongWeak = input.bool(true, "Show Strong/Weak High/Low", group = grpSwing, tooltip = "Display Strong/Weak High/Low. Each break protects the latest swing on the other side (Strong); the trend's trailing extreme is Weak.")

grpInternal = "Internal Structure"
internalLevel = input.int(4, "Internal Structure Length (1-10)", minval = 1, maxval = 10, group = grpInternal, tooltip = "Size of the internal structure's swings (the same 1-10 scale). Market Tradability needs the HTF's latest internal break to be a BOS in the trend's direction.")
showInternal = input.bool(false, "Show Internal Structure On The Chart", group = grpInternal, tooltip = "Display the internal BOS/CHoCH: minor breaks inside the swings, dashed and faded.")

grpBreaks = "BOS / CHoCH / LS Display"
showBos = input.bool(true, "Show BOS Labels", group = grpBreaks, tooltip = "Display BOS (break of structure): a close through the latest HH (bullish) or LL (bearish), creating a new HH (LL).")
showChoch = input.bool(true, "Show CHoCH Labels", group = grpBreaks, tooltip = "Display CHoCH (change of character): a close through the latest LH (bullish) or HL (bearish) followed by an HH (LL).")
showLs = input.bool(true, "Show LS Labels (a failed CHoCH)", group = grpBreaks, tooltip = "Display LS (liquidity sweep): a CHoCH that failed because the old trend carried on.")
labelSizeInput = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpBreaks, tooltip = "Text size of the swing, break and Fibonacci labels.")
showLines = input.bool(true, "Show Structure Lines", group = grpBreaks, tooltip = "Draw BOS/CHoCH/LS lines from the broken swing to the first candle that touches its level.")

grpEqual = "EQH/EQL"
showEqual = input.bool(true, "Show EQH/EQL", group = grpEqual, tooltip = "Label equal highs and lows as EQH/EQL and join each to the swing it equals.")
equalThreshold = input.float(0.2, "EQH/EQL Threshold (ATR, 0 = off)", minval = 0.0, maxval = 0.5, step = 0.05, group = grpEqual, tooltip = "A swing within this many ATR of the previous swing on its side is an equal high or low.")

grpS83 = "83% Strategy - Setup (LTF)"
ltfBarsToProcess = input.int(25, "LTF Independent Processed Bars", minval = 5, maxval = 400, group = grpS83, tooltip = "How many LTF candles the setups are found in: A must lie within them, a live setup expires when its A leaves them, and only setups found within them are shown.")
entryLevelInput = input.string("83%", "Entry Fibonacci Level", options = ["70.5%", "78.6%", "83%", "88.6%"], group = grpS83, tooltip = "The retracement of the leg from B (0%) to A (100%) that is the entry. Levels below two thirds are not offered: with the take profit just before B, a 1:2 stop would never stay behind A.")
impulseCandles = input.int(3, "Heavy Pressure: Candles After The HL/LH", minval = 0, maxval = 20, group = grpS83, tooltip = "Heavy pressure must show within this many candles of A (A's candle included).")
impulseMinAtr = input.float(2.0, "Heavy Pressure: Minimum Move (LTF ATR)", minval = 0.0, step = 0.1, group = grpS83, tooltip = "How far beyond A a candle must close within those candles, in 14-candle LTF ATR at A.")

grpS83Risk = "83% Strategy - Risk Management"
riskPercent = input.float(5.0, "Risk (%) Per Trade", minval = 0.01, maxval = 100.0, step = 0.1, group = grpS83Risk, tooltip = "Share of the balance (initial capital plus net profit) lost at the stop. Quantity = balance x risk / (stop distance x point value).")
maxTradesPerDay = input.int(3, "Number Of Trades Per Day (Max)", minval = 1, group = grpS83Risk, tooltip = "At most this many entries per day (exchange time zone).")
lossesToEndDay = input.int(2, "Consecutive Losses That End The Day (0 = never)", minval = 0, group = grpS83Risk, tooltip = "After this many consecutive losses in a day, no more trades that day. A loss closes more than half its initial risk beyond its entry; a breakeven exit is not one and ends a run.")
tradeMon = input.bool(true, "Mon", inline = "days", group = grpS83Risk)
tradeTue = input.bool(true, "Tue", inline = "days", group = grpS83Risk)
tradeWed = input.bool(true, "Wed", inline = "days", group = grpS83Risk)
tradeThu = input.bool(true, "Thu", inline = "days", group = grpS83Risk)
tradeFri = input.bool(true, "Fri", inline = "days", group = grpS83Risk)
tradeSat = input.bool(true, "Sat", inline = "days", group = grpS83Risk)
tradeSun = input.bool(false, "Sun", inline = "days", group = grpS83Risk, tooltip = "Trading days (exchange time zone). Monday to Saturday by default.")
qtyStep = input.float(0.001, "Quantity Step", minval = 0.000001, group = grpS83Risk, tooltip = "Order quantities are rounded down to a multiple of this.")
minQty = input.float(0.0, "Minimum Quantity (0 = none)", minval = 0.0, group = grpS83Risk, tooltip = "The symbol's minimum order size, e.g. the Deriv synthetic index's minimum lot.")
minQtyRiskMultiple = input.float(0.0, "Trade The Minimum If It Risks At Most N x The Plan (0 = skip)", minval = 0.0, step = 0.5, group = grpS83Risk, tooltip = "Below the minimum quantity the trade is skipped, or the minimum is traded when it risks at most this many times the planned risk.")

grpS83Stops = "83% Strategy - Stop Loss, Take Profit and Breakeven"
slBufferAtr = input.float(0.5, "Stop Loss Behind The HL/LH (LTF ATR)", minval = 0.0, step = 0.05, group = grpS83Stops, tooltip = "The ATR-based stop behind A that gives the position's natural reward-to-risk.")
tpBufferAtr = input.float(0.1, "Take Profit Before The HH/LL (LTF ATR)", minval = 0.0, step = 0.05, group = grpS83Stops, tooltip = "The take profit sits this far before B.")
rrLow = input.float(2.0, "Standard R:R (1:2)", minval = 0.1, step = 0.5, group = grpS83Stops, tooltip = "The trade uses whichever of the two standard ratios is closer to the natural one and moves the stop to match (1:2.4 becomes 1:2), as long as the stop stays behind A.")
rrHigh = input.float(3.0, "Standard R:R (1:3)", minval = 0.1, step = 0.5, group = grpS83Stops)
breakevenPercent = input.float(60.0, "Breakeven At % Of The Take Profit (0 = off)", minval = 0.0, maxval = 99.0, step = 5.0, group = grpS83Stops, tooltip = "The stop moves to the entry once price has covered this much of the way to the take profit.")

grpS83Vis = "83% Strategy - Chart (LTF)"
showFib83 = input.bool(true, "Show Fibonacci (B 0%, the entry level, A 100%)", group = grpS83Vis)
showSetupPoints = input.bool(true, "Show A / B / C", group = grpS83Vis, tooltip = "A: the HL (LH) the heavy move started from. B: the HH (LL) it formed. C: the entry.")
showPositionBoxes = input.bool(true, "Show Target And Stop Zones", group = grpS83Vis, tooltip = "The target zone (entry to take profit) and stop zone (entry to stop loss) of the traded or planned position.")

grpDash = "Dashboard and Alerts"
dashPositionInput = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = grpDash)
s83Alerts = input.bool(false, "Alert On Setups And Entries", group = grpDash, tooltip = "Send an alert() when a setup is armed and when a trade opens.")

// Swing Detection and Internal Structure Lengths are a 1-10 scale, not the
// pivot's candles on each side (N) itself: swings found with N candles are
// mostly the same swings found with N+1, so at N=10 one more candle changed
// only 11% of the drawn labels. Each level is the N that changes about a
// third of the drawn swing labels from the level before (27-42% on real data,
// 23-43% on generated markets), as in the EA's DetectionCandles.
detectionCandles(int level) =>
    level <= 1 ? 1 : level == 2 ? 2 : level == 3 ? 3 : level == 4 ? 5 : level == 5 ? 7 : level == 6 ? 10 : level == 7 ? 14 : level == 8 ? 19 : level == 9 ? 26 : 36

htfSwingLength = detectionCandles(htfSwingLevel)
mtfSwingLength = detectionCandles(mtfSwingLevel)
ltfSwingLength = detectionCandles(ltfSwingLevel)
internalLength = detectionCandles(internalLevel)

// ------------------------------------------------------ internal tuning
// Drawing constants.
BOS_COLOR = color.blue
CHOCH_COLOR = color.red
LS_COLOR = #E5B800
INTERNAL_BULL_COLOR = #089981
INTERNAL_BEAR_COLOR = #F23645
LINE_STYLE = line.style_solid
LINE_WIDTH = 2
FIB_COLOR = #787B86
ENTRY_COLOR = #FF9800
BUY_SETUP_COLOR = color.red
SELL_SETUP_COLOR = #4169E1
TARGET_ZONE_COLOR = color.new(#2962FF, 80)
STOP_ZONE_COLOR = color.new(#F23645, 80)
FIB_RIGHT_OFFSET = 10
POSITION_BOX_CANDLES = 20

// Swing detection (Smart Money Engine): a swing high is a pivot of the
// timeframe's Swing Detection Length candles on each side (see
// pivotHighFound), which is also how many candles it takes to confirm. A
// lower length finds more, faster swings; a higher length fewer, cleaner
// ones. The internal structure uses the same pivots with the shorter Internal
// Structure Length. The 14-candle ATR sizes the EQH/EQL threshold and the
// CHoCH trap area.
SWING_ATR_LENGTH = 14

// Consolidation / Undefined: the breaks since the oldest of the last
// SPORADIC_LABELS labels flip direction SPORADIC_FLIPS times, or two CHoCHs
// since the last confirming BOS lie within CHOCH_TRAP_AREA_ATR ATR.
SPORADIC_LABELS = 5
SPORADIC_FLIPS = 2
CHOCH_TRAP_AREA_ATR = 4.0

// Kept history: enough for the last five labels and the recent breaks.
MAX_POINTS = 80
MAX_EVENTS = 200
MAX_TRAP = 50

HIGH_LABEL_COLOR = #CD5C5C
LOW_LABEL_COLOR = #008080

if timeframe.in_seconds(htfTf) <= timeframe.in_seconds(mtfTf) or timeframe.in_seconds(mtfTf) <= timeframe.in_seconds(ltfTf)
    runtime.error("The timeframes must run from the longest to the shortest: HTF, then MTF, then LTF")
if rrHigh < rrLow
    runtime.error("Standard R:R (1:3) must be at least Standard R:R (1:2)")

// ------------------------------------------------------ structure engine
// An equal high or low (EQH/EQL, see markEqual) keeps the role of the swing
// it equals, and its break level is the outer edge of the pair.
type SPoint
    int id
    int pivotBar
    int pivotTime
    float price
    int side
    int kind
    bool superseded = false
    int equalId = -1
    float equalPrice = na
    int equalTime = na
    int equalBar = -1
    float level = na
    int levelTime = na
    int levelBar = -1
    // The first candle after levelBar whose wick or body reached the level
    // (-1 until one does), tracked while the swing can still become a level.
    int levelTouchBar = -1
    int levelTouchTime = na

type SEvent
    int bar
    int breakBar
    int breakTime
    int dir
    bool bos
    int swingTime
    float level
    int seq = 0
    bool ls = false
    int lsBar = -1
    int swingBar = -1
    // Where its line ends: the first candle that touched the level.
    int endBar = -1
    int endTime = na

type SLevel
    bool active = false
    float price = na
    int swingTime = na
    int point = -1
    int swingBar = -1
    int touchBar = -1
    int touchTime = na

type SEngine
    array<SPoint> points
    array<SEvent> events
    array<SEvent> trapChochs
    array<SPoint> newPoints
    array<SPoint> dropped
    array<SEvent> newEvents
    SLevel hh
    SLevel lh
    SLevel ll
    SLevel hl
    SPoint highPt
    SPoint lowPt
    // The previous leg's swing on each side: the one a new swing is labelled
    // against, and the one it may equal (EQH/EQL).
    SPoint highRefPt
    SPoint lowRefPt
    int nextId = 0
    int lastSide = 0
    bool haveHighRef = false
    bool haveLowRef = false
    float highRef = 0.0
    float lowRef = 0.0
    int dir = 0
    bool lastBos = false
    bool haveHigh = false
    bool haveLow = false
    float lastHigh = 0.0
    float lastLow = 0.0
    int lastHighKind = 0
    int lastLowKind = 0
    int lastHighTime = na
    int lastLowTime = na
    int chochDir = 0
    int chochBreakBar = -1
    int chochBreakTime = na
    float chochLevel = na
    int chochLevelTime = na
    int chochLevelPoint = -1
    int chochLevelBar = -1
    int chochTouchBar = -1
    int chochTouchTime = na
    int eventTotal = 0
    int consolidation = 0
    int labelsFromIdx = -1
    int trapFromIdx = -1
    // LS watch on the latest CHoCH (see lsClose).
    SEvent lsEvent
    int lsSeq = -1
    int lsDir = 0
    float lsOrigin = na
    float lsExtreme = na
    int lsPriorDir = 0
    bool lsPriorBos = false
    bool lsTriggered = false
    bool lsBeyond = false
    int lsTotal = 0
    array<SEvent> newLs
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh = na
    int trailHighTime = na
    float trailLow = na
    int trailLowTime = na

newEngine() =>
    SEngine.new(points = array.new<SPoint>(), events = array.new<SEvent>(), trapChochs = array.new<SEvent>(), newPoints = array.new<SPoint>(), dropped = array.new<SPoint>(), newEvents = array.new<SEvent>(), hh = SLevel.new(), lh = SLevel.new(), ll = SLevel.new(), hl = SLevel.new(), newLs = array.new<SEvent>())

method setLevel(SLevel lv, SPoint p) =>
    lv.active := true
    lv.price := p.level
    lv.swingTime := p.levelTime
    lv.swingBar := p.levelBar
    lv.point := p.id
    lv.touchBar := p.levelTouchBar
    lv.touchTime := p.levelTouchTime

// A swing is identified once the opposite leg after it has begun: no later
// pivot can replace it, so it stays marked on the chart. Only then does it
// become the HH/LH (or LL/HL) whose close-through is a break.
method identifySwing(SEngine e, SPoint p) =>
    if not na(p)
        if p.side > 0
            if p.kind > 0
                e.hh.setLevel(p)
            else if p.kind < 0
                e.lh.setLevel(p)
        else
            if p.kind > 0
                e.ll.setLevel(p)
            else if p.kind < 0
                e.hl.setLevel(p)
    p

method highId(SEngine e) =>
    int id = -1
    if not na(e.highPt)
        id := e.highPt.id
    id

method lowId(SEngine e) =>
    int id = -1
    if not na(e.lowPt)
        id := e.lowPt.id
    id

method addPoint(SEngine e, int pivotBar, int pivotTime, float price, int side, int kind) =>
    e.nextId += 1
    SPoint p = SPoint.new(e.nextId, pivotBar, pivotTime, price, side, kind, level = price, levelTime = pivotTime, levelBar = pivotBar)
    e.points.push(p)
    if e.points.size() > MAX_POINTS
        e.points.shift()
    e.newPoints.push(p)
    p

// A BOS that follows an event in the same direction confirms that direction
// and ends any CHoCH trap; every other CHoCH joins the trap window.
// e.dir is the direction of the latest event that is not an LS.
// EQH / EQL: a swing within the EQH/EQL Threshold (ATR) of the previous swing
// on its side (the swing its HH/LH or LL/HL label is judged against) is an
// equal high or low. The two swings are one liquidity pool, so the new swing
// keeps the role of the swing it equals instead of being called higher or
// lower by a hair, and the pool's outer edge is the level a close must break.
// An untyped first swing has no role to pass on.
markEqual(SPoint p, SPoint ref, float tol) =>
    if not na(ref) and tol > 0
        if ref.kind != 0 and math.abs(p.price - ref.price) < tol
            p.kind := ref.kind
            p.equalId := ref.id
            p.equalPrice := ref.price
            p.equalTime := ref.pivotTime
            p.equalBar := ref.pivotBar
            if p.side > 0 ? ref.level > p.level : ref.level < p.level
                p.level := ref.level
                p.levelTime := ref.levelTime
                p.levelBar := ref.levelBar
                p.levelTouchBar := ref.levelTouchBar
                p.levelTouchTime := ref.levelTouchTime
    p

method addEvent(SEngine e, int bar, int breakBar, int breakTime, int dir, bool bos, int swingTime, float level, int swingBar, int endBar, int endTime) =>
    SEvent ev = SEvent.new(bar, breakBar, breakTime, dir, bos, swingTime, level, e.eventTotal, swingBar = swingBar, endBar = endBar, endTime = endTime)
    int prevDir = e.dir
    e.events.push(ev)
    if e.events.size() > MAX_EVENTS
        e.events.shift()
    if bos and prevDir == dir
        e.trapChochs.clear()
    else if not bos
        e.trapChochs.push(ev)
        if e.trapChochs.size() > MAX_TRAP
            e.trapChochs.shift()
    e.newEvents.push(ev)
    e.eventTotal += 1
    e.dir := dir
    e.lastBos := bos

method startChoch(SEngine e, int dir, int bar, int barTime, SLevel lv) =>
    e.chochDir := dir
    e.chochBreakBar := bar
    e.chochBreakTime := barTime
    e.chochLevel := lv.price
    e.chochLevelTime := lv.swingTime
    e.chochLevelPoint := lv.point
    e.chochLevelBar := lv.swingBar
    e.chochTouchBar := lv.touchBar
    e.chochTouchTime := lv.touchTime

// Drops a candidate. While the broken LH/HL is still the latest swing on its
// side it stays the most recent LH/HL, so a later close through it is a
// fresh break.
method cancelChoch(SEngine e) =>
    if e.chochDir > 0 and e.highId() == e.chochLevelPoint
        e.lh := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    if e.chochDir < 0 and e.lowId() == e.chochLevelPoint
        e.hl := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0

// The swings after the broken LH have made an HH (bullish), or after the
// broken HL an LL (bearish), and no LL (HH) has formed after it since. An
// equal high or low (EQH/EQL) is neither: it did not go beyond the swing it
// equals, so it neither confirms nor cancels a CHoCH.
method chochComplete(SEngine e) =>
    SPoint ext = na
    SPoint opp = na
    if e.chochDir > 0
        ext := e.highPt
        opp := e.lowPt
    else
        ext := e.lowPt
        opp := e.highPt
    bool done = false
    if not na(ext)
        if ext.id > e.chochLevelPoint and ext.kind > 0 and ext.equalId < 0
            if na(opp)
                done := true
            else
                done := opp.id < ext.id or opp.kind < 0 or opp.equalId >= 0
    done

// A CHoCH that reversed a trend is watched while it is the latest event: if
// the old trend carries on instead, it was a liquidity sweep (LS).
//  * Protected swing (origin): the swing the breaking move started from, the
//    last low before the HH of a bullish CHoCH (the last high before the LL
//    of a bearish one).
//  * Extreme: the old trend's most recent identified LL (bullish CHoCH) or
//    HH (bearish CHoCH).
//  * Trigger: a close through the protected swing.
//  * Confirmation: the old trend carries on beyond its extreme, by a close
//    (which is also the old trend's BOS) or by a swing, before anything else
//    prints. A BOS in the CHoCH's direction or an opposite CHoCH ends the
//    watch, and the CHoCH stands.
method confirmChoch(SEngine e, int bar) =>
    int priorDir = e.dir
    bool priorBos = e.lastBos
    int direction = e.chochDir
    e.addEvent(bar, e.chochBreakBar, e.chochBreakTime, direction, false, e.chochLevelTime, e.chochLevel, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0
    e.lsSeq := -1
    SPoint origin = direction > 0 ? e.lowPt : e.highPt
    SLevel extreme = direction > 0 ? e.ll : e.hh
    if priorDir != 0 and not na(origin) and not na(extreme.swingTime)
        e.lsEvent := e.events.last()
        e.lsSeq := e.lsEvent.seq
        e.lsDir := direction
        e.lsOrigin := origin.price
        e.lsExtreme := extreme.price
        e.lsPriorDir := priorDir
        e.lsPriorBos := priorBos
        e.lsTriggered := false
        e.lsBeyond := false
    e.lsSeq

method lsWatching(SEngine e) =>
    e.lsSeq >= 0 and e.lsSeq == e.eventTotal - 1

// A swing on the old trend's side (side -1 low, 1 high) while watching:
// beyond the extreme it shows the old trend carrying on. True when that
// confirms the LS.
method lsSwing(SEngine e, int side, float price) =>
    bool confirm = false
    if e.lsWatching() and e.lsDir == -side
        if side < 0 ? price < e.lsExtreme : price > e.lsExtreme
            e.lsBeyond := true
        confirm := e.lsTriggered and e.lsBeyond
    confirm

// A close while watching. True when it confirms the LS.
method lsClose(SEngine e, float c) =>
    bool confirm = false
    if e.lsWatching()
        bool bullish = e.lsDir > 0
        if bullish ? c < e.lsOrigin : c > e.lsOrigin
            e.lsTriggered := true
        confirm := e.lsTriggered and (e.lsBeyond or (bullish ? c < e.lsExtreme : c > e.lsExtreme))
    confirm

// The CHoCH was a liquidity sweep: it is relabelled LS and the trend it
// changed is restored, as if it had never printed. It also leaves the CHoCH
// trap, and any CHoCH attempt still pending ends.
method confirmLs(SEngine e, int bar) =>
    SEvent ev = e.lsEvent
    ev.ls := true
    ev.lsBar := bar
    e.dir := e.lsPriorDir
    e.lastBos := e.lsPriorBos
    int t = e.trapChochs.size()
    if t > 0
        if e.trapChochs.get(t - 1).seq == ev.seq
            e.trapChochs.pop()
    e.newLs.push(ev)
    e.lsTotal += 1
    e.lsSeq := -1
    e.chochDir := 0

// A pivot high is accepted if it extends the current high leg or starts a new
// high leg. It is labelled HH/LH against the previous high leg.
method onPivotHigh(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == 1
    bool accepted = false
    if sameLeg
        if v > e.lastHigh
            e.lastHigh := v
            kind := e.haveHighRef ? (v > e.highRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveHighRef := e.haveHigh
        e.highRef := e.lastHigh
        kind := e.haveHigh ? (v > e.lastHigh ? 1 : -1) : 0
        e.haveHigh := true
        e.lastHigh := v
        e.lastSide := 1
        accepted := true
    if accepted
        // A higher pivot in the same leg replaces the leg's high; the first
        // high of a new leg ends the low leg, identifying its low.
        if sameLeg
            e.highPt.superseded := true
            e.dropped.push(e.highPt)
        else
            e.identifySwing(e.lowPt)
            e.highRefPt := e.highPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, 1, kind), e.highRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.highPt := p
        e.lastHighKind := kind
        e.lastHighTime := pivotTime
        // An HH beyond the old uptrend's extreme after a failed bearish CHoCH
        // confirms the LS; a pending CHoCH attempt ends with it.
        if e.lsSwing(1, v)
            e.confirmLs(curBar)
        // Only swings formed after the breaking close can cancel a CHoCH, and
        // an equal high never does.
        else if e.chochDir > 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir < 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

method onPivotLow(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == -1
    bool accepted = false
    if sameLeg
        if v < e.lastLow
            e.lastLow := v
            kind := e.haveLowRef ? (v < e.lowRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveLowRef := e.haveLow
        e.lowRef := e.lastLow
        kind := e.haveLow ? (v < e.lastLow ? 1 : -1) : 0
        e.haveLow := true
        e.lastLow := v
        e.lastSide := -1
        accepted := true
    if accepted
        if sameLeg
            e.lowPt.superseded := true
            e.dropped.push(e.lowPt)
        else
            e.identifySwing(e.highPt)
            e.lowRefPt := e.lowPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, -1, kind), e.lowRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.lowPt := p
        e.lastLowKind := kind
        e.lastLowTime := pivotTime
        if e.lsSwing(-1, v)
            e.confirmLs(curBar)
        else if e.chochDir < 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir > 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

// A structure line never clips through a candle: it ends on the first candle
// after its swing whose wick or body reaches the level (high at or above a
// swing high, low at or below a swing low). The candle that closes through
// the level always touches it, so a break's line ends there at the latest.
// The swings that can still become levels (the latest swing and the previous
// leg's swing on each side) and the four levels record their first touch as
// candles close; the candles between a pivot and its confirmation never
// reach it.
method touchLevel(SLevel lv, int side, float h, float l, int curBar, int curTime) =>
    if lv.active and lv.touchBar < 0 and (side > 0 ? h >= lv.price : l <= lv.price)
        lv.touchBar := curBar
        lv.touchTime := curTime
    lv.touchBar

touchPoint(SPoint p, float h, float l, int curBar, int curTime) =>
    if not na(p)
        if p.levelTouchBar < 0 and (p.side > 0 ? h >= p.level : l <= p.level)
            p.levelTouchBar := curBar
            p.levelTouchTime := curTime
    p

// Only a candle close through an identified swing is a break; a wick is a
// sweep.
//  * The most recent identified LH broken while the trend is not bullish
//    starts a bullish CHoCH (an LH broken with an HH is the CHoCH, not a BOS).
//  * The most recent identified HH broken is a bullish BOS. Bearish mirrors
//    both.
method onClose(SEngine e, float c, float h, float l, int curBar, int curTime) =>
    e.hh.touchLevel(1, h, l, curBar, curTime)
    e.lh.touchLevel(1, h, l, curBar, curTime)
    e.ll.touchLevel(-1, h, l, curBar, curTime)
    e.hl.touchLevel(-1, h, l, curBar, curTime)
    // LS first: the restored trend then decides the breaks below, so the
    // protected swing's break is a pullback and a close beyond the old extreme
    // is that trend's BOS.
    if e.lsClose(c)
        e.confirmLs(curBar)
    if e.lh.active and c > e.lh.price
        e.lh.active := false
        if e.dir <= 0 and e.chochDir <= 0
            e.cancelChoch()
            e.startChoch(1, curBar, curTime, e.lh)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.hh.active and c > e.hh.price
        e.hh.active := false
        if e.chochDir <= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, 1, true, e.hh.swingTime, e.hh.price, e.hh.swingBar, e.hh.touchBar, e.hh.touchTime)
    if e.hl.active and c < e.hl.price
        e.hl.active := false
        if e.dir >= 0 and e.chochDir >= 0
            e.cancelChoch()
            e.startChoch(-1, curBar, curTime, e.hl)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.ll.active and c < e.ll.price
        e.ll.active := false
        if e.chochDir >= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, -1, true, e.ll.swingTime, e.ll.price, e.ll.swingBar, e.ll.touchBar, e.ll.touchTime)
    e.dir

// Strong/Weak High/Low after one candle (Smart Money Engine): a break on this
// candle (a new event, or an LS confirmed on it) protects the latest swing on
// the other side of the resulting trend, then the trailing extreme on the
// trend's side follows the candle. The protected swing is Strong, the
// trailing extreme Weak: Strong Low / Weak High in a bullish trend, Strong
// High / Weak Low in a bearish one.
method trailExtremes(SEngine e, float h, float l, int curTime) =>
    bool broke = e.newEvents.size() > 0 or e.newLs.size() > 0
    if broke and e.dir > 0 and not na(e.lowPt)
        e.trailLow := e.lowPt.price
        e.trailLowTime := e.lowPt.pivotTime
    if broke and e.dir < 0 and not na(e.highPt)
        e.trailHigh := e.highPt.price
        e.trailHighTime := e.highPt.pivotTime
    if e.dir > 0 and (na(e.trailHigh) or h > e.trailHigh)
        e.trailHigh := h
        e.trailHighTime := curTime
    if e.dir < 0 and (na(e.trailLow) or l < e.trailLow)
        e.trailLow := l
        e.trailLowTime := curTime
    e.dir

// One closed candle: the swing confirmed on it (its pivot is Swing Detection
// Length candles back), then the candle's close, then the trailing extremes
// and the touches of the swings that can still become levels.
// A candle that is both a swing high and a swing low (an outside candle, about
// 4% of swing candles at 1 candle a side) is taken in the order its price most
// likely went: a bullish candle made its low first (lowFirst), a bearish or
// flat one its high first.
method step(SEngine e, bool isPh, bool isPl, float phV, float plV, int pivotBar, int pivotTime, float equalTol, float c, float h, float l, int curBar, int curTime, bool lowFirst) =>
    e.newPoints.clear()
    e.dropped.clear()
    e.newEvents.clear()
    e.newLs.clear()
    if lowFirst and isPl
        e.onPivotLow(plV, pivotBar, pivotTime, equalTol, curBar)
    if isPh
        e.onPivotHigh(phV, pivotBar, pivotTime, equalTol, curBar)
    if isPl and not lowFirst
        e.onPivotLow(plV, pivotBar, pivotTime, equalTol, curBar)
    e.onClose(c, h, l, curBar, curTime)
    e.trailExtremes(h, l, curTime)
    touchPoint(e.highPt, h, l, curBar, curTime)
    touchPoint(e.lowPt, h, l, curBar, curTime)
    touchPoint(e.highRefPt, h, l, curBar, curTime)
    touchPoint(e.lowRefPt, h, l, curBar, curTime)

// Consolidation / Undefined, 1 = sporadic 5-label sequence, 2 = multiple
// CHoCHs without a BoS, 3 = both.
method classify(SEngine e, float atrNow) =>
    int cons = 0
    int labels = 0
    int firstIdx = -1
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labels += 1
                firstIdx := k
                if labels >= SPORADIC_LABELS
                    break
    e.labelsFromIdx := labels >= SPORADIC_LABELS ? firstIdx : -1
    if e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        int flips = 0
        int prevDir = 0
        int m = e.events.size()
        if m > 0
            for i = m - 1 to 0
                SEvent ev = e.events.get(i)
                if ev.breakBar < fromBar
                    break
                // An LS is not a break: it never flips the structure.
                if ev.ls
                    continue
                if prevDir != 0 and ev.dir != prevDir
                    flips += 1
                prevDir := ev.dir
        if flips >= SPORADIC_FLIPS
            cons := 1
    e.trapFromIdx := -1
    int t = e.trapChochs.size()
    if t >= 2
        SEvent latest = e.trapChochs.get(t - 1)
        for i = 0 to t - 2
            SEvent ev = e.trapChochs.get(i)
            if math.abs(ev.level - latest.level) <= CHOCH_TRAP_AREA_ATR * atrNow
                cons += 2
                e.trapFromIdx := i
                break
    e.consolidation := cons
    cons

labelDigit(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? 5 : 6) : p.side > 0 ? (p.kind > 0 ? 1 : 2) : (p.kind > 0 ? 3 : 4)

eventDigit(SEvent ev) =>
    ev.bos ? (ev.dir > 0 ? 1 : 2) : (ev.dir > 0 ? 3 : 4)

// Numeric evidence for the dashboard (strings are built on the chart):
// label digits 1 HH, 2 LH, 3 LL, 4 HL, 5 EQH, 6 EQL; break digits 1 bull
// BoS, 2 bear BoS, 3 bull CHoCH, 4 bear CHoCH.
method summary(SEngine e) =>
    int labelsCode = 0
    float rangeLo = na
    float rangeHi = na
    int n = e.points.size()
    if e.labelsFromIdx >= 0 and n > 0
        for k = e.labelsFromIdx to n - 1
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labelsCode := labelsCode * 10 + labelDigit(p)
                rangeHi := na(rangeHi) ? p.price : math.max(rangeHi, p.price)
                rangeLo := na(rangeLo) ? p.price : math.min(rangeLo, p.price)
    int breaksCode = 0
    int breaksCount = 0
    int m = e.events.size()
    if e.consolidation % 2 == 1 and m > 0 and e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        array<int> breaks = array.new<int>()
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if ev.breakBar < fromBar
                break
            if not ev.ls
                breaks.unshift(i)
        breaksCount := breaks.size()
        if breaksCount > 0
            for j = math.max(0, breaksCount - 9) to breaksCount - 1
                breaksCode := breaksCode * 10 + eventDigit(e.events.get(breaks.get(j)))
    int trapCode = 0
    int trapCount = 0
    float trap1 = na
    float trap2 = na
    float trap3 = na
    float trap4 = na
    int t = e.trapChochs.size()
    if e.consolidation >= 2 and e.trapFromIdx >= 0 and t > 0
        trapCount := t - e.trapFromIdx
        int slot = 0
        for i = math.max(e.trapFromIdx, t - 4) to t - 1
            SEvent ev = e.trapChochs.get(i)
            trapCode := trapCode * 10 + eventDigit(ev)
            if slot == 0
                trap1 := ev.level
            else if slot == 1
                trap2 := ev.level
            else if slot == 2
                trap3 := ev.level
            else
                trap4 := ev.level
            slot += 1
    int latestCode = 0
    float latestLevel = na
    if m > 0
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if not ev.ls
                latestCode := eventDigit(ev)
                latestLevel := ev.level
                break
    // New on this candle: an LS first (5 a failed bullish CHoCH, 6 a failed
    // bearish one), then the events.
    int newCode = 0
    int lsFresh = e.newLs.size()
    if lsFresh > 0
        for i = 0 to lsFresh - 1
            newCode := newCode * 10 + (e.newLs.get(i).dir > 0 ? 5 : 6)
    int fresh = e.newEvents.size()
    if fresh > 0
        for i = 0 to math.min(fresh, 3) - 1
            newCode := newCode * 10 + eventDigit(e.newEvents.get(i))
    float hhV = e.hh.active ? e.hh.price : na
    float lhV = e.lh.active ? e.lh.price : na
    float llV = e.ll.active ? e.ll.price : na
    float hlV = e.hl.active ? e.hl.price : na
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV]

// A swing high must be at least as high as the L candles on its left and
// strictly higher than the L candles on its right (a double top is one swing
// at its latest candle). Swing lows mirror this.
pivotHighFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = high[len]
        for j = len + 1 to 2 * len
            if high[j] > v
                ok := false
        for j = 0 to len - 1
            if high[j] >= v
                ok := false
    ok

pivotLowFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = low[len]
        for j = len + 1 to 2 * len
            if low[j] < v
                ok := false
        for j = 0 to len - 1
            if low[j] <= v
                ok := false
    ok

// Average true range over SWING_ATR_LENGTH candles (fewer at the start).
swingAtrSeries() =>
    float tr = ta.tr(true)
    float avg = ta.sma(tr, SWING_ATR_LENGTH)
    float acc = ta.cum(tr)
    na(avg) ? acc / (bar_index + 1) : avg

// Structure of the timeframe this runs on (inside request.security), with
// pivots of `length` candles on each side.
structureRequest(int length) =>
    var SEngine e = newEngine()
    float atrS = swingAtrSeries()
    bool ph = pivotHighFound(length)
    bool pl = pivotLowFound(length)
    e.step(ph, pl, high[length], low[length], bar_index - length, time[length], equalThreshold * nz(atrS[length]), close, high, low, bar_index, time, ph and pl and close[length] > open[length])
    e.classify(atrS)
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV] = e.summary()
    // Flags cross request.security as 0/1 so a missing value is simply 0.
    [e.dir, e.lastBos ? 1 : 0, e.consolidation, labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV, e.eventTotal + e.lsTotal, e.lastHigh, e.lastHighKind, e.haveHigh ? 1 : 0, e.lastLow, e.lastLowKind, e.haveLow ? 1 : 0, e.trailHigh, e.trailLow, e.haveHighRef ? e.highRef : na, e.haveLowRef ? e.lowRef : na]

// ----------------------------------------------- internal structure
// Internal Structure (Smart Money Engine): minor structure inside the swings,
// from pivots of Internal Structure Length candles (level 4, 5 candles, by
// default). It gives more insight into the moves between swings without
// changing the Market Trend; Market Tradability needs the HTF's to agree (see
// evaluateTradability).
//  * Each internal pivot high (low) becomes the internal high (low) level.
//  * The first close above the internal high is an internal bullish BOS, or
//    an internal bullish CHoCH when the internal trend was bearish; bearish
//    mirrors this. Each level is broken once, and the break sets the
//    internal trend.
//  * On the chart its breaks are drawn as dashed width-1 lines with faded
//    captions, except where the internal pivot is also a swing of the main
//    structure, which draws that level itself.
// Only closed candles are used.
type SInternal
    int trend = 0
    bool lastChoch = false
    float breakLevel = na
    float highLevel = na
    int highBar = na
    int highTime = na
    bool highBroken = false
    float lowLevel = na
    int lowBar = na
    int lowTime = na
    bool lowBroken = false
    // The first candle after each pivot that touched its level (-1 until
    // one does): where a break's line ends.
    int highTouchBar = -1
    int highTouchTime = na
    int lowTouchBar = -1
    int lowTouchTime = na
    // Breaks made on this candle, and whether each was a CHoCH.
    bool bullBreak = false
    bool bullChoch = false
    bool bearBreak = false
    bool bearChoch = false

// One closed candle: the internal pivots confirmed on it, the touches of
// their levels, then its close.
method update(SInternal s, bool ph, bool pl, float phV, float plV, int pivotBar, int pivotTime, float c, float h, float l, int curBar, int curTime) =>
    s.bullBreak := false
    s.bearBreak := false
    if ph
        s.highLevel := phV
        s.highBar := pivotBar
        s.highTime := pivotTime
        s.highBroken := false
        s.highTouchBar := -1
    if pl
        s.lowLevel := plV
        s.lowBar := pivotBar
        s.lowTime := pivotTime
        s.lowBroken := false
        s.lowTouchBar := -1
    if not na(s.highLevel) and s.highTouchBar < 0 and h >= s.highLevel
        s.highTouchBar := curBar
        s.highTouchTime := curTime
    if not na(s.lowLevel) and s.lowTouchBar < 0 and l <= s.lowLevel
        s.lowTouchBar := curBar
        s.lowTouchTime := curTime
    if not na(s.highLevel) and not s.highBroken and c > s.highLevel
        s.highBroken := true
        s.lastChoch := s.trend < 0
        s.trend := 1
        s.breakLevel := s.highLevel
        s.bullBreak := true
        s.bullChoch := s.lastChoch
    if not na(s.lowLevel) and not s.lowBroken and c < s.lowLevel
        s.lowBroken := true
        s.lastChoch := s.trend > 0
        s.trend := -1
        s.breakLevel := s.lowLevel
        s.bearBreak := true
        s.bearChoch := s.lastChoch
    s

// The internal structure of the timeframe this runs on.
internalRequest(int length) =>
    var SInternal s = SInternal.new()
    s.update(pivotHighFound(length), pivotLowFound(length), high[length], low[length], bar_index - length, time[length], close, high, low, bar_index, time)
    [s.trend, s.lastChoch ? 1 : 0, s.breakLevel]

// Each request returns the state after the last closed candle of its
// timeframe ([1] with lookahead on), so nothing repaints. The HTF gives the
// Market Trend, its breakdown, the swings and the internal structure; the MTF
// its Market Trend and breakdown.
htfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl, ph, pl] = structureRequest(htfSwingLength)
    [iT, iC, iL] = internalRequest(internalLength)
    [d[1], b[1], cons[1], lc[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], th[1], tl[1], iT[1], iC[1], iL[1], hp[1], hv[1], lp[1], lv[1], ph[1], pl[1]]

mtfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl, ph, pl] = structureRequest(mtfSwingLength)
    [d[1], b[1], cons[1], lc[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], th[1], tl[1]]

[hDir, hBos, hCons, hLabels, hBreaks, hBreaksN, hTrap, hTrapN, hT1, hT2, hT3, hT4, hLatest, hLatestLv, hTrailHigh, hTrailLow, hInTrend, hInChoch, hInLevel, hLastHigh, hHaveHigh, hLastLow, hHaveLow, hPrevHigh, hPrevLow] = request.security(syminfo.tickerid, htfTf, htfRequest(), lookahead = barmerge.lookahead_on)
[mDir, mBos, mCons, mLabels, mBreaks, mBreaksN, mTrap, mTrapN, mT1, mT2, mT3, mT4, mLatest, mLatestLv, mTrailHigh, mTrailLow] = request.security(syminfo.tickerid, mtfTf, mtfRequest(), lookahead = barmerge.lookahead_on)

// The Hurst exponent (see the EA's HurstOf): measured on the HTF by default.
hurstTf = hurstSource == "MTF" ? mtfTf : hurstSource == "LTF" ? ltfTf : htfTf
HURST_MIN_LAG = 2
HURST_MAX_LAG = 20

// The Hurst exponent of the hurstCandles closes up to the latest closed
// candle, by the lagged-difference method (the generalized Hurst exponent with
// q = 2): x = ln(close) oldest first; for each lag tau from 2 to 20, sigma is
// the root mean square of x[t+tau] - x[t]; H is the least-squares slope of
// ln sigma against ln tau. About 0.5 is a random walk; a trending market (a
// steady drift or momentum) gives more, a mean-reverting one less. The same
// sums in the same order as 83% Strategy 2.0.mq5's HurstOf. Also the number of closed
// candles (up to hurstCandles).
hurstRequest() =>
    float lc = close > 0 ? math.log(close) : na
    float h = na
    int n = hurstCandles
    if bar_index >= n - 1
        bool valid = true
        for j = 0 to n - 1
            if na(lc[j])
                valid := false
        int lags = HURST_MAX_LAG - HURST_MIN_LAG + 1
        array<float> lt = array.new<float>(lags, 0.0)
        array<float> ls = array.new<float>(lags, 0.0)
        if valid
            for k = 0 to lags - 1
                int tau = HURST_MIN_LAG + k
                int m = n - tau
                float square = 0.0
                // x[t] is lc[n - 1 - t] (x runs oldest first).
                for t = 0 to m - 1
                    float move = lc[n - 1 - t - tau] - lc[n - 1 - t]
                    square += move * move
                square := square / m
                // Separate ifs: their last statements differ in type.
                if square <= 0
                    valid := false
                if square > 0
                    array.set(lt, k, math.log(tau))
                    array.set(ls, k, math.log(math.sqrt(square)))
        if valid
            float mt = 0.0
            float ms = 0.0
            for k = 0 to lags - 1
                mt += array.get(lt, k)
                ms += array.get(ls, k)
            mt := mt / lags
            ms := ms / lags
            float sxy = 0.0
            float sxx = 0.0
            for k = 0 to lags - 1
                sxy += (array.get(lt, k) - mt) * (array.get(ls, k) - ms)
                sxx += (array.get(lt, k) - mt) * (array.get(lt, k) - mt)
            h := sxy / sxx
    [h[1], math.min(bar_index, n)]

[baseHurst, baseHurstCount] = request.security(syminfo.tickerid, hurstTf, hurstRequest(), lookahead = barmerge.lookahead_on)

// ---------------------------------------------------- chart structure
// Labels and signals follow the chart timeframe, while the dashboard stays on
// the structure timeframe. Only confirmed candles are processed. The chart
// uses the Swing Detection Length of the matching HTF, MTF or LTF input (any
// other chart timeframe uses the HTF's) and the Internal Structure Length.
chartSeconds = timeframe.in_seconds()
chartTfIndex = chartSeconds == timeframe.in_seconds(htfTf) ? 0 : chartSeconds == timeframe.in_seconds(mtfTf) ? 1 : chartSeconds == timeframe.in_seconds(ltfTf) ? 2 : 0
chartLength = chartTfIndex == 1 ? mtfSwingLength : chartTfIndex == 2 ? ltfSwingLength : htfSwingLength
chartInternalLength = internalLength
float chartAtr = swingAtrSeries()
bool chartPh = pivotHighFound(chartLength)
bool chartPl = pivotLowFound(chartLength)
bool chartInternalPh = pivotHighFound(chartInternalLength)
bool chartInternalPl = pivotLowFound(chartInternalLength)
var SEngine chartEngine = newEngine()
var SInternal chartInternal = SInternal.new()

labelSize = labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : labelSizeInput == "Large" ? size.large : size.small

// The drawn history covers Bars To Process structure candles, and the LTF
// processed bars on the LTF.
htfSeconds = timeframe.in_seconds(htfTf)
displayBars = chartTfIndex == 2 ? ltfBarsToProcess : math.max(2 * math.max(htfSwingLength, mtfSwingLength, ltfSwingLength) + 2, int(math.ceil(float(barsToProcess) * htfSeconds / math.max(chartSeconds, 1))))
drawFrom = last_bar_index - displayBars
var int drawFromTime = na
if bar_index == math.max(drawFrom, 0)
    drawFromTime := time

swingName(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? "EQH" : "EQL") : p.side > 0 ? (p.kind > 0 ? "HH" : "LH") : (p.kind > 0 ? "LL" : "HL")

// A BOS, CHoCH or LS caption, centred on its line (the candle midway between
// the broken swing and the first candle that touched its level, where the
// line ends): above a line broken upwards, below one broken downwards.
breakLabel(SEvent ev, string txt, color textColor) =>
    label.new(int(math.round(0.5 * (ev.swingBar + ev.endBar))), ev.level, txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = ev.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = textColor, size = labelSize)

// Only the newest swing on each side can be superseded, so the chart keeps
// the label (and EQH/EQL line) of the newest high and low to delete when that
// happens. The drawing of the latest CHoCH, replaced if it becomes an LS.
var int lastChochSeq = -1
var label lastChochLabel = na
var line lastChochLine = na
var label highSwingLabel = na
var line highEqualLine = na
var int highSwingId = -1
var label lowSwingLabel = na
var line lowEqualLine = na
var int lowSwingId = -1

// Whether the main structure has a swing (side 1 high, -1 low) at a candle.
mainSwingAt(SEngine e, int side, int pivotTime) =>
    bool found = false
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if p.side == side and p.pivotTime == pivotTime
                found := true
                break
    found

// The internal structure's BOS/CHoCH (Smart Money Engine): a dashed width-1
// line from the internal pivot to the first candle that touched its level
// (the candle that closed through it at the latest) and a faded caption
// centred on it, above a line broken upwards and below one broken downwards.
internalBreak(int dir, bool choch, float level, int swingTime, int swingBar, int endBar, int endTime) =>
    color clr = dir > 0 ? INTERNAL_BULL_COLOR : INTERNAL_BEAR_COLOR
    line ln = line.new(swingTime, level, endTime, level, xloc = xloc.bar_time, color = clr, style = line.style_dashed, width = 1)
    label lbl = label.new(int(math.round(0.5 * (swingBar + endBar))), level, choch ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = dir > 0 ? label.style_label_down : label.style_label_up, textcolor = color.new(clr, 30), size = labelSize)
    [ln, lbl]

// An internal pivot that is also a swing of the main structure is left to
// the main structure, which draws that level. The main swing is confirmed
// Swing Detection Length candles after its pivot, so the internal breaks
// drawn meanwhile are kept (side and pivot time) to delete when it is.
var bool internalHighMain = false
var bool internalLowMain = false
var array<line> internalLines = array.new<line>()
var array<label> internalLabels = array.new<label>()
var array<int> internalSides = array.new<int>()
var array<int> internalSwingTimes = array.new<int>()
MAX_INTERNAL_KEPT = 120

if barstate.isconfirmed
    chartEngine.step(chartPh, chartPl, high[chartLength], low[chartLength], bar_index - chartLength, time[chartLength], equalThreshold * nz(chartAtr[chartLength]), close, high, low, bar_index, time, chartPh and chartPl and close[chartLength] > open[chartLength])
    int droppedCount = chartEngine.dropped.size()
    if droppedCount > 0
        for i = 0 to droppedCount - 1
            SPoint gone = chartEngine.dropped.get(i)
            if gone.side > 0 and gone.id == highSwingId
                label.delete(highSwingLabel)
                line.delete(highEqualLine)
                highSwingId := -1
            if gone.side < 0 and gone.id == lowSwingId
                label.delete(lowSwingLabel)
                line.delete(lowEqualLine)
                lowSwingId := -1
    int pointCount = chartEngine.newPoints.size()
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if showSwingPoints and p.kind != 0 and p.pivotBar >= drawFrom
                color swingColor = p.side > 0 ? HIGH_LABEL_COLOR : LOW_LABEL_COLOR
                label lbl = label.new(p.pivotTime, p.price, swingName(p), xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = p.side > 0 ? label.style_label_down : label.style_label_up, textcolor = swingColor, size = labelSize)
                // An equal high or low is joined to the swing it equals.
                line eq = na
                if showEqual and p.equalId >= 0 and p.equalBar >= drawFrom
                    eq := line.new(p.equalTime, p.equalPrice, p.pivotTime, p.price, xloc = xloc.bar_time, color = swingColor, style = line.style_dotted, width = 1)
                if p.side > 0
                    highSwingLabel := lbl
                    highEqualLine := eq
                    highSwingId := p.id
                else
                    lowSwingLabel := lbl
                    lowEqualLine := eq
                    lowSwingId := p.id
    // Internal structure, after the main swings of this candle.
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if p.side > 0 and p.pivotTime == chartInternal.highTime
                internalHighMain := true
            if p.side < 0 and p.pivotTime == chartInternal.lowTime
                internalLowMain := true
            int kept = internalSides.size()
            if kept > 0
                for k = kept - 1 to 0
                    if internalSides.get(k) == p.side and internalSwingTimes.get(k) == p.pivotTime
                        line.delete(internalLines.get(k))
                        label.delete(internalLabels.get(k))
                        internalLines.remove(k)
                        internalLabels.remove(k)
                        internalSides.remove(k)
                        internalSwingTimes.remove(k)
    chartInternal.update(chartInternalPh, chartInternalPl, high[chartInternalLength], low[chartInternalLength], bar_index - chartInternalLength, time[chartInternalLength], close, high, low, bar_index, time)
    if chartInternalPh
        internalHighMain := mainSwingAt(chartEngine, 1, chartInternal.highTime)
    if chartInternalPl
        internalLowMain := mainSwingAt(chartEngine, -1, chartInternal.lowTime)
    if showInternal and bar_index >= drawFrom
        if chartInternal.bullBreak and not internalHighMain
            [ln, lbl] = internalBreak(1, chartInternal.bullChoch, chartInternal.highLevel, chartInternal.highTime, chartInternal.highBar, chartInternal.highTouchBar, chartInternal.highTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(1)
            internalSwingTimes.push(chartInternal.highTime)
        if chartInternal.bearBreak and not internalLowMain
            [ln, lbl] = internalBreak(-1, chartInternal.bearChoch, chartInternal.lowLevel, chartInternal.lowTime, chartInternal.lowBar, chartInternal.lowTouchBar, chartInternal.lowTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(-1)
            internalSwingTimes.push(chartInternal.lowTime)
        while internalSides.size() > MAX_INTERNAL_KEPT
            internalLines.shift()
            internalLabels.shift()
            internalSides.shift()
            internalSwingTimes.shift()
    // An LS replaces the drawing of the CHoCH it reclassifies and keeps its
    // place, in its own colour. It is known before this candle's events.
    int lsCount = chartEngine.newLs.size()
    if lsCount > 0
        for i = 0 to lsCount - 1
            SEvent ev = chartEngine.newLs.get(i)
            if ev.seq == lastChochSeq
                label.delete(lastChochLabel)
                line.delete(lastChochLine)
                lastChochSeq := -1
            if showLs and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color lsColor = LS_COLOR
                breakLabel(ev, "LS", lsColor)
                if showLines
                    line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = lsColor, style = LINE_STYLE, width = LINE_WIDTH)
    int eventCount = chartEngine.newEvents.size()
    if eventCount > 0
        for i = 0 to eventCount - 1
            SEvent ev = chartEngine.newEvents.get(i)
            bool shown = ev.bos ? showBos : showChoch
            label lbl = na
            line ln = na
            // A break is drawn only with its broken swing, so every BOS, CHoCH
            // and LS starts from a marked swing.
            if shown and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color textColor = ev.bos ? BOS_COLOR : CHOCH_COLOR
                lbl := breakLabel(ev, ev.bos ? "BOS" : "CHoCH", textColor)
                if showLines
                    ln := line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = textColor, style = LINE_STYLE, width = LINE_WIDTH)
            // Only the latest CHoCH can still become an LS.
            if not ev.bos
                lastChochSeq := ev.seq
                lastChochLabel := lbl
                lastChochLine := ln

var line lastHighLine = na
var line lastLowLine = na
var line strongWeakHighLine = na
var line strongWeakLowLine = na
var label strongWeakHighLabel = na
var label strongWeakLowLabel = na
// A strategy runs only at candle closes (calc_on_every_tick off), so while the
// market is open it has not run on the forming last candle when it loads or
// its settings change, and barstate.islast stays false until that candle
// closes. Drawing on the last closed candle as well
// (barstate.islastconfirmedhistory) shows the drawings and the dashboard at
// once; the closes that follow redraw them.
if barstate.islast or barstate.islastconfirmedhistory
    line.delete(lastHighLine)
    line.delete(lastLowLine)
    line.delete(strongWeakHighLine)
    line.delete(strongWeakLowLine)
    label.delete(strongWeakHighLabel)
    label.delete(strongWeakLowLabel)
    // Strong/Weak High/Low (Smart Money Engine): dashed lines from the
    // trailing high and low to 20 candles right of the latest candle, with
    // their names just right of the line ends.
    int rightTime = time + 20 * chartSeconds * 1000
    if showStrongWeak and not na(chartEngine.trailHigh)
        strongWeakHighLine := line.new(chartEngine.trailHighTime, chartEngine.trailHigh, rightTime, chartEngine.trailHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakHighLabel := label.new(rightTime, chartEngine.trailHigh, chartEngine.dir < 0 ? "Strong High" : "Weak High", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = HIGH_LABEL_COLOR, size = labelSize)
    if showStrongWeak and not na(chartEngine.trailLow)
        strongWeakLowLine := line.new(chartEngine.trailLowTime, chartEngine.trailLow, rightTime, chartEngine.trailLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakLowLabel := label.new(rightTime, chartEngine.trailLow, chartEngine.dir > 0 ? "Strong Low" : "Weak Low", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = LOW_LABEL_COLOR, size = labelSize)
    if showSwingPoints and chartEngine.haveHigh
        lastHighLine := line.new(chartEngine.lastHighTime, chartEngine.lastHigh, time, chartEngine.lastHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dotted, width = 1)
    if showSwingPoints and chartEngine.haveLow
        lastLowLine := line.new(chartEngine.lastLowTime, chartEngine.lastLow, time, chartEngine.lastLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dotted, width = 1)

// ------------------------------------------------------- trend breakdown
type TfView
    int dir
    bool lastBos
    int cons
    int labelsCode
    int breaksCode
    int breaksCount
    int trapCode
    int trapCount
    float trap1
    float trap2
    float trap3
    float trap4
    int latestCode
    float latestLevel
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh
    float trailLow
    // The latest swing high and low and the ones before them (the previous
    // leg's; a more extreme swing in the same leg replaces it), for the
    // progressive structure Market Tradability needs.
    bool haveHighs = false
    float lastHigh = na
    float prevHigh = na
    bool haveLows = false
    float lastLow = na
    float prevLow = na

htfView = TfView.new(nz(hDir), nz(hBos) == 1, nz(hCons), nz(hLabels), nz(hBreaks), nz(hBreaksN), nz(hTrap), nz(hTrapN), hT1, hT2, hT3, hT4, nz(hLatest), hLatestLv, hTrailHigh, hTrailLow, nz(hHaveHigh) == 1 and not na(hPrevHigh), hLastHigh, hPrevHigh, nz(hHaveLow) == 1 and not na(hPrevLow), hLastLow, hPrevLow)
mtfView = TfView.new(nz(mDir), nz(mBos) == 1, nz(mCons), nz(mLabels), nz(mBreaks), nz(mBreaksN), nz(mTrap), nz(mTrapN), mT1, mT2, mT3, mT4, nz(mLatest), mLatestLv, mTrailHigh, mTrailLow)

// The Internal Structure of a trend timeframe.
type InternalView
    int trend
    bool lastChoch
    float level

htfInternal = InternalView.new(nz(hInTrend), nz(hInChoch) == 1, hInLevel)

biasDirection(TfView v) =>
    v.cons != 0 ? 0 : v.dir

definiteBias(TfView v) =>
    biasDirection(v) != 0 and v.lastBos

biasText(TfView v) =>
    string s = "Consolidation / Undefined"
    int d = biasDirection(v)
    if d > 0
        s := v.lastBos ? "Bullish" : "Bullish Transition"
    else if d < 0
        s := v.lastBos ? "Bearish" : "Bearish Transition"
    s

triggerText(TfView v) =>
    string s = ""
    if v.dir == 0
        s := "No structure break yet"
    else
        if v.cons % 2 == 1
            s := "Sporadic 5-label sequence"
        if v.cons >= 2
            s := s + (s == "" ? "" : " + ") + "Multiple CHoCHs without BoS"
        if s == ""
            s := v.lastBos ? "Clear trending structure" : "Clear structure (CHoCH awaiting BoS)"
    s

priceText(float p) =>
    str.tostring(p, format.mintick)

labelName(int d) =>
    d == 1 ? "HH" : d == 2 ? "LH" : d == 3 ? "LL" : d == 4 ? "HL" : d == 5 ? "EQH" : "EQL"

breakName(int d) =>
    d == 1 ? "bull BoS" : d == 2 ? "bear BoS" : d == 3 ? "bull CHoCH" : "bear CHoCH"

// The digits of a code, oldest first.
codeDigits(int code) =>
    array<int> digits = array.new<int>()
    string raw = code > 0 ? str.tostring(code) : ""
    int len = str.length(raw)
    if len > 0
        for i = 0 to len - 1
            digits.push(int(str.tonumber(str.substring(raw, i, i + 1))))
    digits

evidenceText(TfView v) =>
    string labels = ""
    array<int> ld = codeDigits(v.labelsCode)
    if ld.size() > 0
        for i = 0 to ld.size() - 1
            labels := labels + (labels == "" ? "" : " ") + labelName(ld.get(i))
    string out = labels == "" ? "" : "Labels " + labels
    if v.cons % 2 == 1
        string breaks = v.breaksCount > 9 ? "..." : ""
        array<int> bd = codeDigits(v.breaksCode)
        if bd.size() > 0
            for i = 0 to bd.size() - 1
                breaks := breaks + (breaks == "" ? "" : ", ") + breakName(bd.get(i))
        out := out + "; breaks " + breaks
    if v.cons >= 2
        string chochs = v.trapCount > 4 ? "..." : ""
        array<int> td = codeDigits(v.trapCode)
        array<float> lv = array.from(v.trap1, v.trap2, v.trap3, v.trap4)
        if td.size() > 0
            for i = 0 to td.size() - 1
                chochs := chochs + (chochs == "" ? "" : ", ") + breakName(td.get(i)) + " " + priceText(lv.get(i))
        out := out + (out == "" ? "" : " | ") + chochs + "; no confirming BoS since"
    if v.cons == 0 and v.latestCode > 0
        out := out + (out == "" ? "" : "; ") + "latest " + breakName(v.latestCode) + " " + priceText(v.latestLevel)
    out == "" ? "No labels yet" : out

trendWord(int d) =>
    d > 0 ? "bullish" : "bearish"

// The internal structure's dashboard output: its trend and latest break.
internalTrendText(InternalView iv) =>
    iv.trend == 0 ? "Undefined" : (iv.trend > 0 ? "Bullish" : "Bearish") + (iv.lastChoch ? " (CHoCH)" : " (BOS)")

// How the internal structure relates to the timeframe's Market Trend.
internalAgreementText(InternalView iv, TfView v, string name) =>
    int d = biasDirection(v)
    string s = ""
    if iv.trend == 0
        s := "No internal break yet to compare with the " + name + " Market Trend."
    else if d == 0
        s := "The " + name + " Market Trend is ranging; the internal structure is " + trendWord(iv.trend) + "."
    else if d == iv.trend
        s := "Agrees with the " + name + " Market Trend."
    else
        s := "Opposes the " + name + " Market Trend: a " + trendWord(iv.trend) + " move inside the " + trendWord(d) + " trend (a pullback until the swing structure breaks)."
    s

internalTooltip(InternalView iv, TfView v, string name, int level) =>
    string t = "Internal structure (level " + str.tostring(level) + ": " + str.tostring(detectionCandles(level)) + "-candle swings)\nInternal trend: "
    t := t + (iv.trend == 0 ? "no internal level broken yet" : (iv.trend > 0 ? "Bullish" : "Bearish") + " since a " + trendWord(iv.trend) + " " + (iv.lastChoch ? "CHoCH" : "BOS") + " through " + priceText(iv.level))
    t + "\n" + internalAgreementText(iv, v, name)

// Strong/Weak High/Low of a timeframe: the swing protected by the latest break
// is Strong, the trailing extreme on the trend's side Weak.
strongWeakText(TfView v) =>
    string hi = na(v.trailHigh) ? "no swing high yet" : (v.dir < 0 ? "Strong High " : "Weak High ") + priceText(v.trailHigh)
    string lo = na(v.trailLow) ? "no swing low yet" : (v.dir > 0 ? "Strong Low " : "Weak Low ") + priceText(v.trailLow)
    hi + " | " + lo

breakdownText(TfView v) =>
    "Current Trend Classification: " + biasText(v) + "\nTrigger Condition Met: " + triggerText(v) + "\nStructural Evidence: " + evidenceText(v) + "\nStrong/Weak: " + strongWeakText(v)

tfName(string tf) =>
    int secs = timeframe.in_seconds(tf)
    string s = ""
    if secs < 60
        s := str.tostring(secs) + "S"
    else if secs < 3600
        s := "M" + str.tostring(int(secs / 60))
    else if secs < 86400
        s := "H" + str.tostring(int(secs / 3600))
    else if secs < 604800
        s := "D" + str.tostring(int(secs / 86400))
    else if secs < 2419200
        s := "W" + str.tostring(int(secs / 604800))
    else
        s := "MN" + str.tostring(int(math.round(secs / 2592000)))
    s

// Why a timeframe has no trend direction.
noTrendText(string name, TfView v) =>
    string s = name + " has no structure break yet."
    if v.dir != 0
        string why = v.cons % 2 == 1 ? "breaks in both directions over its last 5 swings" : ""
        if v.cons >= 2
            why := why + (why == "" ? "" : "; ") + "repeated CHoCHs in one area with no BOS"
        s := name + " is ranging (" + why + ")."
    s

transitionText(string name, TfView v) =>
    name + " is only in a " + trendWord(v.dir) + " transition (a CHoCH not yet confirmed by a BOS)."

// "HH", "LH" or "EQH" for highs; "LL", "HL" or "EQL" for lows.
swingTag(int side, float cur, float prev) =>
    side > 0 ? (cur > prev ? "HH" : cur < prev ? "LH" : "EQH") : (cur < prev ? "LL" : cur > prev ? "HL" : "EQL")

// 1 for a bullish progression (an HH and an HL), -1 for a bearish one (an LL
// and an LH), 0 otherwise (see the EA's SwingProgression).
swingProgression(TfView v) =>
    not v.haveHighs or not v.haveLows ? 0 : v.lastHigh > v.prevHigh and v.lastLow > v.prevLow ? 1 : v.lastLow < v.prevLow and v.lastHigh < v.prevHigh ? -1 : 0

// "HH + HL", or what is missing.
swingStructureText(TfView v) =>
    (v.haveHighs ? swingTag(1, v.lastHigh, v.prevHigh) : "no two swing highs yet") + " + " + (v.haveLows ? swingTag(-1, v.lastLow, v.prevLow) : "no two swing lows yet")

// The structure of a timeframe for a direction: "" when it is progressive (an
// HH and an HL for bullish, an LL and an LH for bearish), else what is missing.
swingProblem(TfView v, int d, string name) =>
    string s = ""
    if not v.haveHighs or not v.haveLows
        s := "the " + name + " has no two swing " + (not v.haveHighs ? "highs" : "lows") + " yet"
    else if swingProgression(v) != d
        s := "the " + name + " swings are " + swingStructureText(v) + " (" + trendWord(d) + " needs " + (d > 0 ? "HH + HL" : "LL + LH") + ")"
    s

hurstName() =>
    tfName(hurstTf)

// About 0.5 is a random walk; above it a trending (persistent) market, below
// it a mean-reverting one. "trending" is above the Hurst minimum, so the
// reading agrees with Market Tradability.
hurstWord(float h) =>
    h > hurstMin ? "trending" : h >= 0.45 ? "random walk" : "mean-reverting"

// The Hurst exponent: "" when it is above the minimum, else why not.
hurstProblem() =>
    string s = ""
    if na(baseHurst)
        s := nz(baseHurstCount) < hurstCandles ? "the Hurst exponent needs " + str.tostring(hurstCandles) + " closed " + hurstName() + " candles (" + str.tostring(nz(baseHurstCount)) + " so far)" : "the Hurst exponent is not available (the " + hurstName() + " closes do not move)"
    else if not (baseHurst > hurstMin)
        s := "the Hurst exponent " + str.tostring(baseHurst, "0.00") + " is not above " + str.tostring(hurstMin, "0.00") + " (" + hurstWord(baseHurst) + ")"
    s

// The HTF internal structure for a direction: "" when it is in that direction
// and its latest break is a BOS, else what it is.
internalProblem(InternalView iv, int d, string name) =>
    string s = ""
    if iv.trend == 0
        s := "the " + name + " internal structure has no break yet"
    else if iv.trend != d or iv.lastChoch
        s := "the " + name + " internal structure is " + trendWord(iv.trend) + (iv.lastChoch ? " (CHoCH)" : " (BOS)") + ", not " + trendWord(d) + " (BOS)"
    s

// Market Tradability (see the EA's EvaluateTradability): Tradable when all of
// these line up in one direction on the HTF:
//  1. Market Trend: Bullish or Bearish, established by a BOS (not a
//     transition and not Consolidation / Undefined).
//  2. Progressive structure: bullish, a Higher High (the latest swing high
//     above the previous one) and a Higher Low (the latest swing low above
//     the previous one); bearish, a Lower Low and a Lower High.
//  3. The internal structure in that direction, its latest break a BOS (not
//     a CHoCH).
//  4. The Hurst exponent above the Hurst minimum (0.50), a trending market.
// The reason names every condition that fails. This is Base's rule with only
// the HTF selected as a trend timeframe.
evaluateTradability(TfView htf, InternalView hi) =>
    int hd = biasDirection(htf)
    string name = tfName(htfTf)
    bool tradable = false
    string reason = ""
    if hd == 0
        reason := noTrendText(name, htf)
    else if not definiteBias(htf)
        reason := transitionText(name, htf)
    else
        array<string> problems = array.new<string>()
        for p in array.from(swingProblem(htf, hd, name), internalProblem(hi, hd, name), hurstProblem())
            if p != ""
                problems.push(p)
        string lead = name + " is " + trendWord(hd) + " (BOS)"
        if problems.size() == 0
            tradable := true
            reason := lead + " with " + (hd > 0 ? "HH + HL" : "LL + LH") + ", the " + name + " internal structure is " + trendWord(hd) + " (BOS), and the Hurst exponent " + str.tostring(baseHurst, "0.00") + " is above " + str.tostring(hurstMin, "0.00") + "."
        else
            reason := lead + ", but " + problems.join("; ") + "."
    [tradable, reason]

// ============================================================ 83% Strategy 2.0
// Same rules as 83% Strategy 2.0.mq5 (see the top of this script). Per closed
// LTF candle (see the EA's S83ScanSetups):
//  1. the live setup is cancelled if the market no longer points its
//     direction (unless its order filled on this candle: the filters of an
//     order placed at the previous close reach this candle); otherwise it
//     steps through the candle: touched (the entry) or invalidated by a new
//     HH (LL) beyond a confirmed B. If still live, its B follows price, and it
//     expires once its A left the processed candles.
//  2. in a bullish market, the latest swing low, A, starts a buy setup when
//     it is an HL not used before, within the processed candles, a candle from
//     A on has closed above the swing high before it (the break of structure)
//     and it shows heavy pressure (a close Impulse Min ATR LTF ATR beyond A
//     within Impulse Candles candles of it). B is the highest high since A.
//     If the entry level was reached after B (and after the break) before the
//     setup was known, it is missed; otherwise it is armed and replaces the
//     live setup. A bearish market mirrors this with sells.
// Shown: the setups whose A lies within the processed candles, created since
// the market last changed direction.
// Differences from the EA: orders are limit orders placed at a candle's close
// (the EA enters at the market on the first tick at the level); breakeven is
// checked at candle closes; Pine has no spread; days are in the exchange time
// zone; the structure is calculated on all loaded history (the EA replays
// three times Bars To Process); and a new MTF/HTF candle reaches the filters
// and the market direction one LTF candle after it closes (request.security
// reads the latest closed candle).

entryRatio = entryLevelInput == "70.5%" ? 0.705 : entryLevelInput == "78.6%" ? 0.786 : entryLevelInput == "88.6%" ? 0.886 : 0.83

S83_ARMED = 0
S83_TOUCHED = 1
S83_INVALID = 2
S83_EXPIRED = 3
S83_MISSED = 4
S83_REPLACED = 5
S83_CANCELLED = 6

// One setup: A (the HL/LH the heavy move started from), B (the HH/LL it
// formed), the entry level between them, its state and its drawings.
type S83Setup
    int dir
    float aPrice
    int aTime
    int aBar
    float bPrice
    int bTime
    int bBar
    float level
    float impulse
    int createdBar
    // B follows price until it is a confirmed swing.
    bool bFixed = false
    bool pruned = false
    int state = 0
    int endBar = na
    int endTime = na
    string note = ""
    bool traded = false
    float entry = na
    float sl = na
    float tp = na
    float rr = na
    int entryTime = na
    array<line> lines
    array<label> levelLabels
    array<label> labels
    array<box> boxes

// The price of a share of a setup's leg: 0 at B, 1 at A.
s83Price(S83Setup s, float ratio) =>
    s.bPrice + (s.aPrice - s.bPrice) * ratio

s83SetupText(S83Setup s) =>
    (s.dir > 0 ? "Buy: A HL " : "Sell: A LH ") + priceText(s.aPrice) + " -> B " + (s.dir > 0 ? "HH " : "LL ") + priceText(s.bPrice) + (s.state == S83_ARMED and not s.bFixed ? " (forming)" : "") + "; " + entryLevelInput + " at " + priceText(s.level)

alignDown(float p) =>
    math.floor(p / syminfo.mintick + 1e-8) * syminfo.mintick

alignUp(float p) =>
    math.ceil(p / syminfo.mintick - 1e-8) * syminfo.mintick

// Take profit, stop loss and reward-to-risk for an entry at `entry`, and
// whether that stop is behind A.
s83Plan(S83Setup s, float entry, float atr) =>
    float tp = s.dir > 0 ? alignDown(s.bPrice - tpBufferAtr * atr) : alignUp(s.bPrice + tpBufferAtr * atr)
    float reward = s.dir > 0 ? tp - entry : entry - tp
    float atrStop = s.dir > 0 ? s.aPrice - slBufferAtr * atr : s.aPrice + slBufferAtr * atr
    float atrRisk = s.dir > 0 ? entry - atrStop : atrStop - entry
    bool ok = reward > 0 and atrRisk > 0 and atr > 0
    float rr = ok and reward / atrRisk < 0.5 * (rrLow + rrHigh) ? rrLow : rrHigh
    float sl = s.dir > 0 ? alignDown(entry - reward / rr) : alignUp(entry + reward / rr)
    bool behind = s.dir > 0 ? sl < s.aPrice : sl > s.aPrice
    [tp, sl, rr, ok, behind]

s83IsLive(S83Setup s) =>
    not na(s) and s.state == S83_ARMED

// Heavy pressure: the furthest close beyond A within Impulse Candles candles
// of it, in LTF ATR at A.
s83Impulse(int aBar, int bBar, int dir, float aPrice) =>
    float atrA = chartAtr[bar_index - aBar]
    float best = 0.0
    int last = math.min(aBar + impulseCandles, bBar)
    for k = aBar to last
        float c = close[bar_index - k]
        best := math.max(best, dir > 0 ? c - aPrice : aPrice - c)
    nz(atrA) > 0 ? best / atrA : 0.0

s83TradingDay(int d) =>
    d == dayofweek.monday ? tradeMon : d == dayofweek.tuesday ? tradeTue : d == dayofweek.wednesday ? tradeWed : d == dayofweek.thursday ? tradeThu : d == dayofweek.friday ? tradeFri : d == dayofweek.saturday ? tradeSat : tradeSun

s83DayName(int d) =>
    d == dayofweek.monday ? "Monday" : d == dayofweek.tuesday ? "Tuesday" : d == dayofweek.wednesday ? "Wednesday" : d == dayofweek.thursday ? "Thursday" : d == dayofweek.friday ? "Friday" : d == dayofweek.saturday ? "Saturday" : "Sunday"

// ------------------------------------------------- market filters per candle
// The latest closed LTF candle is the chart's own when the chart is the LTF.
bool s83OnLtf = timeframe.in_seconds() == timeframe.in_seconds(ltfTf)
[s83Tradable, s83TradabilityWhy] = evaluateTradability(htfView, htfInternal)
// The market's direction: the HTF Market Trend. The MTF's direction when its
// latest break is a BOS (not a transition), else 0.
int s83MarketDir = biasDirection(htfView)
int s83MtfDir = definiteBias(mtfView) ? biasDirection(mtfView) : 0

// The entry filters of a direction: "" when they pass, else why not.
// `detailed` adds the Tradability Reason.
s83FilterText(int dir, bool detailed) =>
    string r = ""
    if dir == 0
        r := "the market has no direction (the " + tfName(htfTf) + " Market Trend is Consolidation / Undefined)"
    else if not s83Tradable
        r := "Market Tradability is Not Tradable" + (detailed ? " (" + s83TradabilityWhy + ")" : "")
    else if s83MarketDir != dir
        r := "the market is " + trendWord(s83MarketDir) + ", not " + trendWord(dir)
    else if s83MtfDir != dir
        r := "the " + tfName(mtfTf) + " Market Trend is " + biasText(mtfView) + ", not " + (dir > 0 ? "Bullish" : "Bearish") + " (a BOS that formed an " + (dir > 0 ? "HH" : "LL") + ")"
    r

// ------------------------------------------------------- daily bookkeeping
// A day is the exchange's calendar day. A trade is a loss when it closed more
// than half its initial risk beyond its entry (a breakeven exit is not); a win
// or breakeven ends a run of losses, and Losses That End The Day consecutive
// losses end trading for the day.
var int s83Day = na
var int s83TradesToday = 0
var int s83LossesInRow = 0
var int s83KnownTrades = 0
var int s83KnownClosed = 0
var array<float> s83TradeRisk = array.new<float>()
// The setup of the order placed and its plan, matched to its fill.
var S83Setup s83Pending = na
var float s83PlannedRisk = na
var float s83PlannedSl = na
var float s83PlannedTp = na
var float s83PlannedRr = na
var string s83LastNote = ""
var bool s83Breakeven = false
// The entry filters behind the pending order, for the dashboard.
var int s83FilterDir = 0
var string s83FilterNow = ""

s83DayEnded(int losses) =>
    lossesToEndDay > 0 and losses >= lossesToEndDay

// ------------------------------------------------------------------ setups
var S83Setup s83Current = na
var array<int> s83UsedBuy = array.new<int>()
var array<int> s83UsedSell = array.new<int>()
// The drawn setups, and the market direction they were found in.
var array<S83Setup> s83Drawn = array.new<S83Setup>()
var int s83ShownDir = 0

method s83AddLevel(S83Setup s, float price, string txt, color c, int rightTime) =>
    s.lines.push(line.new(s.aTime, price, rightTime, price, xloc = xloc.bar_time, color = c, style = line.style_solid, width = 1))
    s.levelLabels.push(label.new(rightTime, price, txt, xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = c, size = labelSize))

// The Fibonacci (B 0%, the entry level, A 100%) and A / B, drawn when the
// setup is found.
method s83DrawNew(S83Setup s) =>
    s.lines := array.new<line>()
    s.levelLabels := array.new<label>()
    s.labels := array.new<label>()
    s.boxes := array.new<box>()
    int rightTime = time + FIB_RIGHT_OFFSET * chartSeconds * 1000
    if showFib83
        s.s83AddLevel(s.bPrice, "0%", FIB_COLOR, rightTime)
        s.s83AddLevel(s.level, entryLevelInput + " (" + priceText(s.level) + ")", ENTRY_COLOR, rightTime)
        s.s83AddLevel(s.aPrice, "100%", FIB_COLOR, rightTime)
    if showSetupPoints
        color pc = s.dir > 0 ? BUY_SETUP_COLOR : SELL_SETUP_COLOR
        s.labels.push(label.new(s.aTime, s.aPrice, "A", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_up : label.style_label_down, textcolor = pc, size = size.normal))
        s.labels.push(label.new(s.bTime, s.bPrice, "B", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = pc, size = size.normal))

method s83Extend(S83Setup s, int rightTime) =>
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, rightTime)
        for lb in s.levelLabels
            label.set_x(lb, rightTime)

method s83Delete(S83Setup s) =>
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        for lb in s.levelLabels
            label.delete(lb)
        for lb in s.labels
            label.delete(lb)
        for bx in s.boxes
            box.delete(bx)

// A setup no longer shown: its drawings go and it is not drawn again.
method s83Hide(S83Setup s) =>
    s.s83Delete()
    s.pruned := true

// The traded position, as in the strategy's examples: the target zone (entry
// to take profit) and stop zone (entry to stop loss) from the entry.
method s83DrawTrade(S83Setup s) =>
    if showPositionBoxes and not na(s.boxes) and not s.pruned
        int boxEnd = s.entryTime + POSITION_BOX_CANDLES * chartSeconds * 1000
        s.boxes.push(box.new(s.entryTime, math.max(s.entry, s.tp), boxEnd, math.min(s.entry, s.tp), xloc = xloc.bar_time, bgcolor = TARGET_ZONE_COLOR, border_width = 0))
        s.boxes.push(box.new(s.entryTime, math.max(s.entry, s.sl), boxEnd, math.min(s.entry, s.sl), xloc = xloc.bar_time, bgcolor = STOP_ZONE_COLOR, border_width = 0))
        s.labels.push(label.new(boxEnd, s.tp, "1:" + str.tostring(s.rr, "0") + "  TP " + priceText(s.tp) + "  SL " + priceText(s.sl), xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = chart.fg_color, size = labelSize))

// A finished setup: its levels end FIB_RIGHT_OFFSET candles after the candle
// that ended it. A touched one gets C, and its position once traded; a failed
// one is dotted with its reason. A setup no longer shown stays hidden.
method s83Finish(S83Setup s) =>
    if not s.pruned
        s.s83Extend(s.endTime + FIB_RIGHT_OFFSET * chartSeconds * 1000)
        color pc = s.dir > 0 ? BUY_SETUP_COLOR : SELL_SETUP_COLOR
        if s.state == S83_TOUCHED
            if showSetupPoints
                s.labels.push(label.new(s.endTime, s.level, "C", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_up : label.style_label_down, textcolor = pc, size = size.normal))
            if s.traded
                s.s83DrawTrade()
            else if s.note != ""
                s.labels.push(label.new(s.endTime, s.level, s.note, xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_right, textcolor = color.gray, size = labelSize))
        else
            for ln in s.lines
                line.set_style(ln, line.style_dotted)
            s.labels.push(label.new(s.endTime, s.level, s.note, xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_right, textcolor = color.gray, size = labelSize))

// Ends a setup on this candle and draws how.
s83Ends(S83Setup s, int st, string why) =>
    s.state := st
    s.endBar := bar_index
    s.endTime := time
    if why != ""
        s.note := why
    s.s83Finish()

// Ends a setup without drawing yet (its candle time `t`).
s83End(S83Setup s, int st, int t, string why) =>
    s.state := st
    s.endBar := bar_index
    s.endTime := t
    s.note := why

// One closed LTF candle of the live setup (see the EA's S83Step): a touch of
// the entry level makes it touched (the entry); otherwise going beyond a
// confirmed B invalidates it (beyond a forming B, B follows at the close:
// s83FollowB).
// (Separate ifs: their last statements differ in type.)
s83Step(S83Setup s) =>
    int d = s.dir
    if s.state == S83_ARMED
        bool touched = d > 0 ? low <= s.level : high >= s.level
        if touched
            s.state := S83_TOUCHED
            s.endBar := bar_index
            s.endTime := time
        if not touched and s.bFixed and (d > 0 ? high > s.bPrice : low < s.bPrice)
            s83End(s, S83_INVALID, time, "invalidated: a new " + (d > 0 ? "HH" : "LL") + " first")
    s.state

// At the close of an LTF candle, the B of the live setup follows price until
// it is a confirmed swing (see the EA's S83FollowB): a candle at or beyond B
// becomes B, and B is fixed once Swing Detection Length candles have closed
// without reaching it. The levels are redrawn when B moves.
s83FollowB(S83Setup s) =>
    if s.state == S83_ARMED and not s.bFixed
        if s.dir > 0 ? high >= s.bPrice : low <= s.bPrice
            s.bPrice := s.dir > 0 ? high : low
            s.bTime := time
            s.bBar := bar_index
            s.level := s83Price(s, entryRatio)
            if not s.pruned
                s.s83Delete()
                s.s83DrawNew()
        if bar_index - s.bBar >= chartLength
            s.bFixed := true

if barstate.isconfirmed and s83OnLtf
    // The day and the trades since the last candle.
    int today = year * 10000 + month * 100 + dayofmonth
    if na(s83Day) or today != s83Day
        s83Day := today
        s83TradesToday := 0
        s83LossesInRow := 0
    int tradeCount = strategy.closedtrades + strategy.opentrades
    while s83KnownTrades < tradeCount
        int k = s83KnownTrades
        s83TradeRisk.push(s83PlannedRisk)
        s83TradesToday += 1
        S83Setup s = s83Pending
        if not na(s) and not s.traded and s.state == S83_ARMED
            bool isLong = k < strategy.closedtrades ? strategy.closedtrades.size(k) > 0 : strategy.opentrades.size(k - strategy.closedtrades) > 0
            s.traded := true
            s.entry := k < strategy.closedtrades ? strategy.closedtrades.entry_price(k) : strategy.opentrades.entry_price(k - strategy.closedtrades)
            s.sl := s83PlannedSl
            s.tp := s83PlannedTp
            s.rr := s83PlannedRr
            s.entryTime := time
            s83Breakeven := false
            s83LastNote := (isLong ? "buy at " : "sell at ") + priceText(s.entry) + ", SL " + priceText(s.sl) + ", TP " + priceText(s.tp) + " (1:" + str.tostring(s.rr, "0") + ")"
            if s83Alerts
                alert("83% Strategy 2.0 " + syminfo.ticker + ": " + s83LastNote, alert.freq_once_per_bar_close)
        s83KnownTrades += 1
    while s83KnownClosed < strategy.closedtrades
        int k = s83KnownClosed
        float risk = k < s83TradeRisk.size() ? s83TradeRisk.get(k) : na
        float entryPx = strategy.closedtrades.entry_price(k)
        float exitPx = strategy.closedtrades.exit_price(k)
        bool isLong = strategy.closedtrades.size(k) > 0
        bool loss = na(risk) ? strategy.closedtrades.profit(k) < 0 : (isLong ? entryPx - exitPx : exitPx - entryPx) > 0.5 * risk
        s83LossesInRow := loss ? s83LossesInRow + 1 : 0
        s83KnownClosed += 1

    // A change of market direction clears the drawn setups.
    if s83MarketDir != s83ShownDir
        for s in s83Drawn
            s.s83Hide()
        s83Drawn.clear()
        s83ShownDir := s83MarketDir

    // 1. The live setup through this candle.
    if s83IsLive(s83Current)
        S83Setup s = s83Current
        if s83MarketDir != s.dir and not s.traded
            s83End(s, S83_CANCELLED, time, "cancelled: the market is no longer " + trendWord(s.dir))
        s83Step(s)
        s83FollowB(s)
        if s83IsLive(s) and s.aBar < bar_index - ltfBarsToProcess + 1
            s83End(s, S83_EXPIRED, time, "expired: A left the processed candles")
        if not s83IsLive(s)
            // A touched (limit) setup: traded on this candle, or why not.
            if s.state == S83_TOUCHED
                s.note := s.traded ? "" : entryLevelInput + " touched; not traded: " + s.note
                if not s.traded
                    s83LastNote := s.note
            s.s83Finish()
    while s83UsedBuy.size() > 200
        s83UsedBuy.shift()
    while s83UsedSell.size() > 200
        s83UsedSell.shift()

    // 2. A new setup, in the market's direction only: A is the latest swing on
    //    its side; the swing before it on the other side holds the level whose
    //    break arms the setup.
    if s83MarketDir != 0
        int dir = s83MarketDir
        SPoint a = na
        SPoint p = na
        int n = chartEngine.points.size()
        if n > 0
            for k = n - 1 to 0
                SPoint pt = chartEngine.points.get(k)
                if not na(a) and pt.side == dir
                    p := pt
                    break
                if na(a) and pt.side == -dir
                    a := pt
        bool used = not na(a) and (dir > 0 ? s83UsedBuy.includes(a.pivotTime) : s83UsedSell.includes(a.pivotTime))
        if not na(a) and not na(p) and a.kind < 0 and not used and a.pivotBar >= bar_index - ltfBarsToProcess + 1
            int broke = -1
            for k = a.pivotBar to bar_index
                float c = close[bar_index - k]
                if dir > 0 ? c > p.level : c < p.level
                    broke := k
                    break
            float impulse = broke >= 0 ? s83Impulse(a.pivotBar, bar_index, dir, a.price) : 0.0
            if broke >= 0 and impulse >= impulseMinAtr
                // B: the extreme since A (the latest of equal ones).
                int bBar = a.pivotBar
                for k = a.pivotBar to bar_index
                    if dir > 0 ? high[bar_index - k] >= high[bar_index - bBar] : low[bar_index - k] <= low[bar_index - bBar]
                        bBar := k
                float bPrice = dir > 0 ? high[bar_index - bBar] : low[bar_index - bBar]
                S83Setup s = S83Setup.new(dir, a.price, a.pivotTime, a.pivotBar, bPrice, time[bar_index - bBar], bBar, na, impulse, bar_index)
                s.level := s83Price(s, entryRatio)
                s.bFixed := bar_index - bBar >= chartLength
                if dir > 0
                    s83UsedBuy.push(a.pivotTime)
                else
                    s83UsedSell.push(a.pivotTime)
                bool missed = false
                int firstAfter = math.max(bBar, broke) + 1
                if firstAfter <= bar_index
                    for j = firstAfter to bar_index
                        if dir > 0 ? low[bar_index - j] <= s.level : high[bar_index - j] >= s.level
                            missed := true
                s.s83DrawNew()
                s83Drawn.push(s)
                if missed
                    s83Ends(s, S83_MISSED, "missed: " + entryLevelInput + " reached before the setup was known")
                else
                    if s83IsLive(s83Current)
                        s83Ends(s83Current, S83_REPLACED, "replaced by a newer setup")
                    s83Current := s
                    if s83Alerts
                        alert("83% Strategy 2.0 " + syminfo.ticker + ": setup armed - " + s83SetupText(s), alert.freq_once_per_bar_close)

    // Only the setups whose A lies within the processed candles are shown.
    int drawnCount = s83Drawn.size()
    if drawnCount > 0
        for k = drawnCount - 1 to 0
            S83Setup s = s83Drawn.get(k)
            if s.aBar < bar_index - ltfBarsToProcess + 1
                s.s83Hide()
                s83Drawn.remove(k)

    // Breakeven: once a candle has covered Breakeven % of the way to the take
    // profit, the stop moves to the entry from the next candle.
    if strategy.position_size != 0 and breakevenPercent > 0 and not s83Breakeven
        bool isLong = strategy.position_size > 0
        S83Setup s = s83Pending
        // Not on the entry candle itself: its high (low) may have come before the fill.
        if not na(s) and s.traded and strategy.opentrades.entry_bar_index(0) < bar_index
            float progress = isLong ? high - s.entry : s.entry - low
            if progress >= breakevenPercent / 100 * math.abs(s.tp - s.entry)
                s83Breakeven := true
                strategy.exit(isLong ? "83% buy exit" : "83% sell exit", from_entry = isLong ? "83% buy" : "83% sell", stop = s.entry, limit = s.tp, comment_loss = "BE", comment_profit = "TP")

    s83FilterDir := s83MarketDir
    if s83IsLive(s83Current)
        s83FilterDir := s83Current.dir
    s83FilterNow := s83FilterText(s83FilterDir, false)

    // The order for the next candle: a limit order at the live setup's entry
    // level when its filters pass.
    int nextDay = dayofweek(time_close)
    bool flat = strategy.position_size == 0
    int nextDayKey = year(time_close) * 10000 + month(time_close) * 100 + dayofmonth(time_close)
    int tradesNextDay = nextDayKey == s83Day ? s83TradesToday : 0
    int lossesNextDay = nextDayKey == s83Day ? s83LossesInRow : 0
    bool live = s83IsLive(s83Current)
    string id = live and s83Current.dir < 0 ? "83% sell" : "83% buy"
    strategy.cancel(id == "83% buy" ? "83% sell" : "83% buy")
    string why = ""
    if live
        if not flat
            why := "a position is already open"
        else if not s83TradingDay(nextDay)
            why := s83DayName(nextDay) + " is not a trading day"
        else if tradesNextDay >= maxTradesPerDay
            why := "the maximum of " + str.tostring(maxTradesPerDay) + " trades today is reached"
        else if s83DayEnded(lossesNextDay)
            why := str.tostring(lossesNextDay) + " consecutive losses ended trading for today"
        else
            why := s83FilterText(s83Current.dir, true)
    float tp = na
    float sl = na
    float rr = na
    float qty = na
    if live and why == ""
        [ptp, psl, prr, pok, pbehind] = s83Plan(s83Current, s83Current.level, chartAtr)
        float balance = strategy.initial_capital + strategy.netprofit
        float riskCash = balance * riskPercent / 100
        float dist = math.abs(s83Current.level - psl)
        qty := pok and dist > 0 ? math.floor(riskCash / (dist * syminfo.pointvalue) / qtyStep) * qtyStep : 0.0
        // Below the symbol's minimum quantity: no trade, or the minimum when it
        // risks at most N times the plan.
        if pok and minQty > 0 and qty < minQty
            qty := minQtyRiskMultiple > 0 and minQty * dist * syminfo.pointvalue <= minQtyRiskMultiple * riskCash ? minQty : 0.0
        tp := ptp
        sl := psl
        rr := prr
        if not pok
            why := "the take profit is not beyond the entry"
        else if not pbehind
            why := "a 1:" + str.tostring(prr, "0") + " stop would not be behind the " + (s83Current.dir > 0 ? "HL" : "LH")
        else if qty <= 0
            why := minQty > 0 ? "the position size is below the minimum quantity of " + str.tostring(minQty) : "the position size rounds to zero"
    // (Separate ifs: their last statements differ in type.)
    bool place = live and why == ""
    if place
        strategy.entry(id, s83Current.dir > 0 ? strategy.long : strategy.short, qty = qty, limit = s83Current.level, comment = id)
        strategy.exit(id + " exit", from_entry = id, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
        s83Pending := s83Current
        s83PlannedRisk := math.abs(s83Current.level - sl)
        s83PlannedSl := sl
        s83PlannedTp := tp
        s83PlannedRr := rr
    if not place
        strategy.cancel(id)
    if live and not place
        s83Current.note := why

// The live setup: its levels reach FIB_RIGHT_OFFSET candles past the latest
// candle, with the planned position from it. Drawn on the last closed candle
// too, like the dashboard (see the strong/weak lines).
var array<box> s83PlanBoxes = array.new<box>()
var array<label> s83PlanLabels = array.new<label>()
if (barstate.islast or barstate.islastconfirmedhistory) and s83OnLtf
    for bx in s83PlanBoxes
        box.delete(bx)
    s83PlanBoxes.clear()
    for lb in s83PlanLabels
        label.delete(lb)
    s83PlanLabels.clear()
    if s83IsLive(s83Current) and not s83Current.pruned
        s83Current.s83Extend(time + FIB_RIGHT_OFFSET * chartSeconds * 1000)
        if showPositionBoxes
            [ptp, psl, prr, pok, pbehind] = s83Plan(s83Current, s83Current.level, chartAtr)
            if pok
                int boxEnd = time + POSITION_BOX_CANDLES * chartSeconds * 1000
                s83PlanBoxes.push(box.new(time, math.max(s83Current.level, ptp), boxEnd, math.min(s83Current.level, ptp), xloc = xloc.bar_time, bgcolor = color.new(TARGET_ZONE_COLOR, 90), border_width = 0))
                s83PlanBoxes.push(box.new(time, math.max(s83Current.level, psl), boxEnd, math.min(s83Current.level, psl), xloc = xloc.bar_time, bgcolor = color.new(STOP_ZONE_COLOR, 90), border_width = 0))
                s83PlanLabels.push(label.new(boxEnd, ptp, "Planned 1:" + str.tostring(prr, "0") + "  TP " + priceText(ptp) + "  SL " + priceText(psl), xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = chart.fg_color, size = labelSize))

// ---------------------------------------------------------------- dashboard
dashPosition = dashPositionInput == "Top Left" ? position.top_left : dashPositionInput == "Bottom Left" ? position.bottom_left : dashPositionInput == "Bottom Right" ? position.bottom_right : position.top_right
// Component names are black and bold, and only the outputs are coloured:
// trends green (Bullish, Bullish Transition), red (Bearish, Bearish
// Transition) or grey (Consolidation / Undefined); tradability and conditions
// green when they pass and red when they do not. No background and no borders.
DASH_TEXT_COLOR = color.black
DASH_POSITIVE_COLOR = color.green
DASH_NEGATIVE_COLOR = color.red
DASH_NEUTRAL_COLOR = color.gray
var table dash = table.new(dashPosition, 2, 24, bgcolor = color.new(color.white, 100), frame_width = 0, border_width = 0)

trendColor(TfView v) =>
    int d = biasDirection(v)
    d > 0 ? DASH_POSITIVE_COLOR : d < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

passColor(bool pass) =>
    pass ? DASH_POSITIVE_COLOR : DASH_NEGATIVE_COLOR

internalColor(InternalView iv) =>
    iv.trend > 0 ? DASH_POSITIVE_COLOR : iv.trend < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

// The Swing Structure row: green for an HH and an HL, red for an LL and an LH.
swingColor(TfView v) =>
    int p = swingProgression(v)
    p > 0 ? DASH_POSITIVE_COLOR : p < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

swingTooltip(TfView v) =>
    "Latest swing high " + (v.haveHighs ? priceText(v.lastHigh) + " vs previous " + priceText(v.prevHigh) : "-") + "; latest swing low " + (v.haveLows ? priceText(v.lastLow) + " vs previous " + priceText(v.prevLow) : "-") + "\nMarket Tradability needs HH + HL (bullish) or LL + LH (bearish)."

// One row: the component name in bold, then its coloured output.
dashRow(int row, string component, string output, color outputColor, string tip) =>
    table.cell(dash, 0, row, component, text_color = DASH_TEXT_COLOR, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip, text_formatting = text.format_bold)
    table.cell(dash, 1, row, output, text_color = outputColor, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip)

// Long outputs (the Tradability Reason and the strategy's) wrap onto new lines
// of at most DASH_WRAP_CHARS characters, broken between words.
DASH_WRAP_CHARS = 48
wrapText(string s) =>
    array<string> words = str.split(s, " ")
    string out = ""
    string line = ""
    int n = words.size()
    if n > 0
        for i = 0 to n - 1
            string w = words.get(i)
            if w != ""
                if line != "" and str.length(line) + 1 + str.length(w) > DASH_WRAP_CHARS
                    out := out + (out == "" ? "" : "\n") + line
                    line := ""
                line := line + (line == "" ? "" : " ") + w
    out + (out == "" or line == "" ? "" : "\n") + line

// The HTF Market Trend (its breakdown is the tooltip) with its swing and
// internal structure, the MTF Market Trend, the Hurst exponent, Market
// Tradability and its reason, then the 83% Strategy: its state, the live
// setup, the entry filters, today's risk and the latest outcome. On the last
// closed candle too (see the strong/weak lines).
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(dash, 0, 0, 1, 23)
    int row = 0
    string htfName = tfName(htfTf)
    dashRow(row, "HTF Market Trend (" + htfName + "):", biasText(htfView), trendColor(htfView), breakdownText(htfView))
    row += 1
    dashRow(row, "Swing Structure:", swingStructureText(htfView), swingColor(htfView), swingTooltip(htfView))
    row += 1
    dashRow(row, "Internal Structure:", internalTrendText(htfInternal), internalColor(htfInternal), internalTooltip(htfInternal, htfView, htfName, internalLevel))
    row += 1
    dashRow(row, "MTF Market Trend (" + tfName(mtfTf) + "):", biasText(mtfView), trendColor(mtfView), breakdownText(mtfView) + "\nEntries need it Bullish (buys) or Bearish (sells): its latest break a BOS that formed an HH (LL), not a Transition.")
    row += 1
    dashRow(row, "Hurst Exponent (" + hurstName() + "):", na(baseHurst) ? "Not available" : "H " + str.tostring(baseHurst, "0.00") + " (" + hurstWord(baseHurst) + ")", na(baseHurst) ? DASH_NEUTRAL_COLOR : passColor(baseHurst > hurstMin), "The last " + str.tostring(hurstCandles) + " closed " + hurstName() + " candles. Market Tradability needs H above " + str.tostring(hurstMin, "0.00") + "; about 0.5 is a random walk, above it a trending market, below it a mean-reverting one.")
    row += 1
    dashRow(row, "Market Tradability:", s83Tradable ? "Tradable" : "Not Tradable", passColor(s83Tradable), "Tradable: the " + htfName + " Market Trend is Bullish (Bearish) after a BOS, its latest swings are an HH and an HL (an LL and an LH), its internal structure is bullish (bearish) after a BOS, and the Hurst exponent is above " + str.tostring(hurstMin, "0.00") + ".")
    row += 1
    dashRow(row, "Tradability Reason:", wrapText(s83TradabilityWhy), DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, " ", " ", DASH_TEXT_COLOR, "")
    row += 1
    bool armed = s83IsLive(s83Current)
    int armedDir = 0
    if armed
        armedDir := s83Current.dir
    string state = not s83OnLtf ? "Open a " + tfName(ltfTf) + " chart to trade" : strategy.position_size > 0 ? "Buy position open" : strategy.position_size < 0 ? "Sell position open" : armedDir > 0 ? "Buy setup armed" : armedDir < 0 ? "Sell setup armed" : s83MarketDir > 0 ? "Waiting for a buy setup" : s83MarketDir < 0 ? "Waiting for a sell setup" : "No setups (no market direction)"
    color stateColor = not s83OnLtf ? DASH_NEGATIVE_COLOR : strategy.position_size > 0 or (strategy.position_size == 0 and armedDir > 0) ? DASH_POSITIVE_COLOR : strategy.position_size < 0 or (strategy.position_size == 0 and armedDir < 0) ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR
    dashRow(row, "83% Strategy (" + tfName(ltfTf) + "):", state, stateColor, "Buys (sells) at the " + entryLevelInput + " retracement of the latest " + tfName(ltfTf) + " HL-to-HH (LH-to-LL) leg with heavy pressure, within the last " + str.tostring(ltfBarsToProcess) + " " + tfName(ltfTf) + " candles. Only buy setups are scanned and shown in a bullish market and only sell setups in a bearish one (the " + htfName + " Market Trend).")
    row += 1
    if armed
        dashRow(row, "Setup:", wrapText(s83SetupText(s83Current)), DASH_TEXT_COLOR, "Heavy pressure " + str.tostring(s83Current.impulse, "0.0") + " " + tfName(ltfTf) + " ATR")
        row += 1
    if s83OnLtf
        dashRow(row, "Entry Filters:", wrapText(s83FilterNow == "" ? "PASS (" + trendWord(s83FilterDir) + ")" : "BLOCKED: " + s83FilterNow), passColor(s83FilterNow == ""), "Entries need Market Tradability to read Tradable and the " + tfName(mtfTf) + " Market Trend to be Bullish (buys) or Bearish (sells): its latest break a BOS.")
        row += 1
        bool ended = s83DayEnded(s83LossesInRow)
        string riskText = str.tostring(s83TradesToday) + "/" + str.tostring(maxTradesPerDay) + " trades, risk " + str.tostring(riskPercent, "0.00") + "%" + (s83LossesInRow > 0 ? ", " + str.tostring(s83LossesInRow) + (s83LossesInRow == 1 ? " loss" : " losses") + " in a row" : "") + (ended ? " (done for today)" : "")
        dashRow(row, "Risk Today:", riskText, ended ? DASH_NEGATIVE_COLOR : DASH_TEXT_COLOR, "Risk " + str.tostring(riskPercent, "0.00") + "% of the balance per trade; at most " + str.tostring(maxTradesPerDay) + " trades a day" + (lossesToEndDay > 0 ? ", and none after " + str.tostring(lossesToEndDay) + " consecutive losses that day" : "") + ".")
        row += 1
    if s83LastNote != ""
        dashRow(row, "Last Setup:", wrapText(s83LastNote), DASH_TEXT_COLOR, "")
        row += 1
