//@version=6
// 83% Strategy - Base market structure (Base.pine v2.43) with Fib Base's
// Fibonacci engine, as a TradingView strategy. Same rules as 83% Strategy.mq5.
//
// Bullish (buys only): Market Tradability reads Tradable and the Optimal
// Conditions OPTIMAL; the MTF's most recent structure is a BOS that made an
// HH; on the LTF (M30, Swing Detection level 3, 25 independent processed
// bars) the Fibonacci runs from the HH (0%) back to the most recent HL with
// heavy buying pressure (100%), and the entry is at 83%. The setup is invalid
// once price makes a new HH without reaching 83%. Bearish mirrors this.
// Risk: 5% per trade by default, halved after every 2 consecutive losses in a
// day, at most 5 trades a day, Monday to Saturday; the stop goes behind the HL
// (LH) by an ATR buffer and the target just before the HH (LL), at 1:2 or 1:3,
// whichever is closer; the stop moves to breakeven at 60% of the target.
//
// Run it on the LTF chart (30 minutes by default): setups, orders and the
// drawings (A / B / C, Fibonacci, target and stop zones) follow that chart.
//
// The market-structure part below is Base.pine unchanged:
// Base - Market Structure (TradingView port of Base.mq5 v2.43)
//
// Reads market structure from closed candles only:
//  * HH/HL/LH/LL swings: pivots of each timeframe's Swing Detection Length
//    candles on each side (Smart Money Engine swing detection; 10 by
//    default, lower is more sensitive).
//  * Only identified swings are broken: a swing is identified once the
//    opposite leg after it has begun, so it can no longer be replaced and
//    stays marked on the chart.
//  * BOS: the most recent identified HH (LL) is broken by a close, creating a
//    new HH (LL).
//  * CHoCH: while the trend is not already bullish, the most recent identified
//    LH is broken by a close and the next swing high is an HH (bearish mirrors
//    this).
//  * EQH/EQL: a swing within the EQH/EQL Threshold (ATR) of the previous
//    swing on its side is an equal high/low. It keeps that swing's role, its
//    break level is the pair's outer edge, and it neither confirms nor
//    cancels a CHoCH.
//  * LS (liquidity sweep): a CHoCH that reversed a trend fails when, before
//    anything else prints, a close breaks its protected swing and the old
//    trend carries on beyond its extreme. The CHoCH is relabelled LS (deep
//    yellow) and the trend before it is restored.
//  * BOS, CHoCH and LS lines end on the first candle whose wick or body
//    touches their level, so they never clip through a candle. Captions are
//    centred on the line: above a line broken upwards, below one broken
//    downwards.
//  * Trend: Bullish / Bearish after a BOS, Bullish / Bearish Transition after
//    a CHoCH, Consolidation / Undefined when the structure is sporadic or
//    trapped.
//  * Strong/Weak High/Low (Smart Money Engine): each break protects the
//    latest swing on the other side (Strong); the trend's trailing extreme is
//    Weak.
//  * Internal Structure (Smart Money Engine): minor BOS/CHoCH from shorter
//    pivots (Internal Structure Length, 5 by default), dashed and faded on
//    the chart and one dashboard row per timeframe.
//  * Dashboard: the Market Trend and Internal Structure of each selected
//    timeframe, Market Tradability (Tradable, Tradable (Early) or Not
//    Tradable) and its reason, the trade recommendation and Optimal
//    Conditions. It is an analysis tool and never places orders.
strategy("83% Strategy", shorttitle = "83%", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_order_fills = false, process_orders_on_close = false, margin_long = 0, margin_short = 0, max_bars_back = 500, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ---------------------------------------------------------------- inputs
grpTf = "Timeframes"
htfTf = input.timeframe("240", "HTF", group = grpTf, tooltip = "Higher timeframe (HTF). Its structure sets the main trend, Market Tradability, the HTF MA, ADX, ATR and session filters, and the alerts.")
mtfTf = input.timeframe("60", "MTF", group = grpTf, tooltip = "Middle timeframe (MTF). Its trend is correlated with the HTF for Market Tradability, it drives the MTF MA filter, and its swings and ATR measure Healthy Extension.")
ltfTf = input.timeframe("30", "LTF", group = grpTf, tooltip = "Lower timeframe (LTF). Its trend can be correlated too, its latest close is the price Healthy Extension measures, and its candles feed Market Volume and Price Momentum.")

grpTrend = "Trend Analysis Timeframes"
useHtf = input.bool(true, "Use HTF", group = grpTrend, tooltip = "Show the HTF Market Trend and require it to agree with the other selected timeframes for Market Tradability. An established HTF trend is always required.")
useMtf = input.bool(true, "Use MTF", group = grpTrend, tooltip = "Show the MTF Market Trend and require it to agree with the other selected timeframes for Market Tradability. It may be in transition.")
useLtf = input.bool(false, "Use LTF", group = grpTrend, tooltip = "Show the LTF Market Trend and require it to agree for Market Tradability. A selected LTF trend must itself be established (latest break a BOS).")
allowEarly = input.bool(true, "Allow Tradable (Early)", group = grpTrend, tooltip = "Show Tradable (Early), in amber, when the timeframes agree but the HTF (or a selected LTF) is only a transition (a CHoCH not yet confirmed by a BOS), and the internal structure of the HTF and of every selected timeframe agrees. Such transitions reached their BOS more often, but still failed about a third of the time.")

grpProc = "Structure Bar Processing"
barsToProcess = input.int(100, "Bars To Process", minval = 100, maxval = 100000, group = grpProc, tooltip = "How many HTF candles back structure is drawn. Other chart timeframes cover the same span of time. Structure is always calculated on all loaded history.")

grpSwing = "Swing Detection"
htfSwingLevel = input.int(3, "HTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the HTF swings (Smart Money Engine swing detection). 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
mtfSwingLevel = input.int(5, "MTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the MTF swings. 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
ltfSwingLevel = input.int(3, "LTF Swing Detection Length (1-10)", minval = 1, maxval = 10, group = grpSwing, tooltip = "Size of the LTF swings. 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
showSwingPoints = input.bool(true, "Show Swing Points", group = grpSwing, tooltip = "Display the HH/HL/LH/LL (and EQH/EQL) swing labels and the dotted lines at the latest swing high and low.")
showStrongWeak = input.bool(true, "Show Strong/Weak High/Low", group = grpSwing, tooltip = "Display Strong/Weak High/Low. Each break protects the latest swing on the other side (Strong); the trend's running extreme is Weak, the next target.")

grpInternal = "Internal Structure"
showInternal = input.bool(true, "Show Internal Structure", group = grpInternal, tooltip = "Display the internal BOS/CHoCH: minor breaks inside the swings, drawn as dashed lines with faded captions.")
showInternalOnDashboard = input.bool(true, "Show Internal Structure On Dashboard", group = grpInternal, tooltip = "Show each timeframe's internal trend under its Market Trend on the dashboard.")
htfInternalLevel = input.int(4, "HTF Internal Structure Length (1-10)", minval = 1, maxval = 10, group = grpInternal, tooltip = "Size of the HTF internal swings. Keep it below the timeframe's Swing Detection Length: at or above it, almost every internal pivot is also a main swing and almost nothing is drawn. 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
mtfInternalLevel = input.int(4, "MTF Internal Structure Length (1-10)", minval = 1, maxval = 10, group = grpInternal, tooltip = "Size of the MTF internal swings. Keep it below the timeframe's Swing Detection Length: at or above it, almost every internal pivot is also a main swing and almost nothing is drawn. 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
ltfInternalLevel = input.int(4, "LTF Internal Structure Length (1-10)", minval = 1, maxval = 10, group = grpInternal, tooltip = "Size of the LTF internal swings. Keep it below the timeframe's Swing Detection Length: at or above it, almost every internal pivot is also a main swing and almost nothing is drawn. 1 = finest, 10 = broadest; each step changes about a third of the drawn swings. Candles on each side of a pivot (also how many candles a swing takes to confirm): 1:1, 2:2, 3:3, 4:5, 5:7, 6:10, 7:14, 8:19, 9:26, 10:36.")
internalBullColor = input.color(#089981, "Internal Bullish Color", group = grpInternal, tooltip = "Color of bullish internal BOS/CHoCH lines and captions.")
internalBearColor = input.color(#F23645, "Internal Bearish Color", group = grpInternal, tooltip = "Color of bearish internal BOS/CHoCH lines and captions.")

// Swing Detection and Internal Structure Lengths are a 1-10 scale, not the
// pivot's candles on each side (N) itself: swings found with N candles are
// mostly the same swings found with N+1, so at N=10 one more candle changed
// only 11% of the drawn labels. Each level is the N that changes about a
// third of the drawn swing labels from the level before (27-42% on real data,
// 23-43% on generated markets), as in Base.mq5's DetectionCandles.
detectionCandles(int level) =>
    level <= 1 ? 1 : level == 2 ? 2 : level == 3 ? 3 : level == 4 ? 5 : level == 5 ? 7 : level == 6 ? 10 : level == 7 ? 14 : level == 8 ? 19 : level == 9 ? 26 : 36

htfSwingLength = detectionCandles(htfSwingLevel)
mtfSwingLength = detectionCandles(mtfSwingLevel)
ltfSwingLength = detectionCandles(ltfSwingLevel)
htfInternalLength = detectionCandles(htfInternalLevel)
mtfInternalLength = detectionCandles(mtfInternalLevel)
ltfInternalLength = detectionCandles(ltfInternalLevel)

grpBos = "BOS Display"
showBos = input.bool(true, "Show BOS Labels", group = grpBos, tooltip = "Display BOS (break of structure): a close through the latest HH (bullish) or LL (bearish) that continues the trend.")
bullBosColor = input.color(color.blue, "Bullish BOS Color", group = grpBos, tooltip = "Caption color of bullish BOS.")
bearBosColor = input.color(color.blue, "Bearish BOS Color", group = grpBos, tooltip = "Caption color of bearish BOS.")

grpChoch = "CHoCH Display"
showChoch = input.bool(true, "Show CHoCH Labels", group = grpChoch, tooltip = "Display CHoCH (change of character): a close through the latest LH (bullish) or HL (bearish), confirmed by the next HH (LL).")
bullChochColor = input.color(color.red, "Bullish CHoCH Color", group = grpChoch, tooltip = "Caption color of bullish CHoCH.")
bearChochColor = input.color(color.red, "Bearish CHoCH Color", group = grpChoch, tooltip = "Caption color of bearish CHoCH.")

grpLs = "LS Display"
showLs = input.bool(true, "Show LS Labels", group = grpLs, tooltip = "Display LS (liquidity sweep): a CHoCH that failed because the old trend carried on beyond its extreme. It replaces the CHoCH, and the old trend is restored.")
bullLsColor = input.color(#E5B800, "Bullish LS Color (a failed bullish CHoCH)", group = grpLs, tooltip = "Caption and line color of an LS that replaced a bullish CHoCH.")
bearLsColor = input.color(#E5B800, "Bearish LS Color (a failed bearish CHoCH)", group = grpLs, tooltip = "Caption and line color of an LS that replaced a bearish CHoCH.")

grpLines = "Labels and Lines"
labelSizeInput = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpLines, tooltip = "Text size of the swing, BOS, CHoCH, LS, internal and Strong/Weak labels.")
showLines = input.bool(true, "Show Structure Lines", group = grpLines, tooltip = "Draw BOS/CHoCH/LS lines from the broken swing to the first candle that touches its level.")
lineStyleInput = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpLines, tooltip = "Style of the BOS/CHoCH/LS lines.")
lineWidth = input.int(2, "Line Width", minval = 1, maxval = 4, group = grpLines, tooltip = "Width of the BOS/CHoCH/LS lines.")

grpEqual = "EQH/EQL"
showEqual = input.bool(true, "Show EQH/EQL", group = grpEqual, tooltip = "Label equal highs and lows as EQH/EQL and join each to the swing it equals with a dotted line. When off, they still act as one liquidity pool.")
equalThreshold = input.float(0.2, "EQH/EQL Threshold (ATR, 0 = off)", minval = 0.0, maxval = 0.5, step = 0.05, group = grpEqual, tooltip = "A swing within this many ATR of the previous swing on its side is an equal high or low: it keeps that swing's role and breaks at the pool's outer edge. 0 turns it off.")

grpHtfMa = "MA Filter (HTF)"
useHtfMa = input.bool(true, "Use HTF MA Filter", group = grpHtfMa, tooltip = "Qualify setups with the latest closed HTF candle against the HTF MA (longs above, shorts below). Shown in the Market Tradability tooltip only.")
htfMaLength = input.int(50, "HTF MA Length", minval = 1, group = grpHtfMa, tooltip = "Length of the HTF moving average.")
htfMaType = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = grpHtfMa, tooltip = "Type of the HTF moving average.")
showHtfMaLine = input.bool(false, "Show HTF MA Line", group = grpHtfMa, tooltip = "Plot the HTF moving average on the chart.")
htfMaColor = input.color(color.blue, "HTF MA Color", group = grpHtfMa, tooltip = "Color of the HTF moving average line.")

grpMtfMa = "MA Filter (MTF)"
useMtfMa = input.bool(true, "Use MTF MA Filter", group = grpMtfMa, tooltip = "Qualify setups with the latest closed MTF candle against the MTF MA (longs above, shorts below). Shown in the Market Tradability tooltip only.")
mtfMaLength = input.int(100, "MTF MA Length", minval = 1, group = grpMtfMa, tooltip = "Length of the MTF moving average.")
mtfMaType = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = grpMtfMa, tooltip = "Type of the MTF moving average.")
showMtfMaLine = input.bool(false, "Show MTF MA Line", group = grpMtfMa, tooltip = "Plot the MTF moving average on the chart.")
mtfMaColor = input.color(color.orange, "MTF MA Color", group = grpMtfMa, tooltip = "Color of the MTF moving average line.")

grpSession = "Session Filter"
useSession = input.bool(false, "Use Session Filter", group = grpSession, tooltip = "Qualify setups only when the latest HTF candle opens inside the chosen session. Shown in the Market Tradability tooltip only.")
sessionPreset = input.string("New York", "Session Preset", options = ["New York", "London", "Tokyo", "Sydney", "Custom", "24x7"], group = grpSession, tooltip = "Trading session. Presets use their market's time zone, so daylight saving time is handled. Custom uses the two inputs below.")
customSession = input.string("0930-1600", "Custom Session (HHMM-HHMM)", group = grpSession, tooltip = "Custom session as HHMM-HHMM. Equal start and end means all day; 2200-0600 crosses midnight.")
customTimezone = input.string("UTC", "Custom Session Timezone (e.g. UTC, GMT+2, America/New_York)", group = grpSession, tooltip = "Time zone of the custom session, for example UTC, GMT+2 or America/New_York.")

grpAdx = "ADX Filter"
useAdx = input.bool(true, "Use ADX Filter", group = grpAdx, tooltip = "Require the HTF ADX to be at least 25 (trend strength) for BOS setups. Shown in the Market Tradability tooltip only.")
adxLength = input.int(14, "ADX Length", minval = 1, group = grpAdx, tooltip = "Length of the HTF ADX.")

grpAtr = "ATR Filter"
useAtr = input.bool(true, "Use ATR Filter", group = grpAtr, tooltip = "Require the HTF ATR to be at least 1.0 (in price units) for setups. Shown in the Market Tradability tooltip only.")
atrLength = input.int(14, "ATR Length", minval = 1, group = grpAtr, tooltip = "Length of the HTF ATR.")

grpOpt = "Optimal Conditions"
useCorrOpt = input.bool(true, "Use Timeframe Correlation For Optimal", group = grpOpt, tooltip = "Optimal Conditions requires the selected timeframes to correlate (Market Tradability is Tradable or Tradable (Early).")
useExtOpt = input.bool(false, "Use Healthy Extension For Optimal", group = grpOpt, tooltip = "Optimal Conditions blocks an overextended market: price more than 10 MTF ATR beyond the latest MTF swing low (bullish HTF trend) or swing high (bearish). Anything less passes.")
useVolOpt = input.bool(true, "Use Market Volume For Optimal", group = grpOpt, tooltip = "Optimal Conditions requires the latest LTF volume to be 0.5x to 2x its 20-candle average.")
useMomOpt = input.bool(false, "Use Price Momentum For Optimal", group = grpOpt, tooltip = "Optimal Conditions requires the latest LTF true range to be 0.5x to 2x its 20-candle average.")

grpDash = "Dashboard and Alerts"
dashPositionInput = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = grpDash, tooltip = "Corner of the chart where the dashboard is shown.")
enableAlerts = input.bool(false, "Alert On Structure-Timeframe BOS / CHoCH / LS", group = grpDash, tooltip = "Send an alert() when a BOS, CHoCH or LS is confirmed on the latest closed HTF candle. Create the alert with Any alert() function call.")

grpS83Sym = "83% Strategy - Symbol (Deriv Synthetic Indices)"
symbolProfile = input.string("Auto", "Symbol Profile", options = ["Auto", "Deriv Synthetic Index", "Standard Symbol"], group = grpS83Sym, tooltip = "Deriv synthetic indices tick at a fixed rate around the clock, so their volume measures nothing: Market Volume is not applied to them (nor to any symbol without volume data). Auto recognises them by ticker, description or the DERIV prefix.")
minQty = input.float(0.0, "Minimum Quantity (0 = none)", minval = 0.0, group = grpS83Sym, tooltip = "The symbol's minimum order size, e.g. the Deriv minimum lot. A smaller risk-based size is not traded, unless the option below allows the minimum.")
minQtyRiskMultiple = input.float(0.0, "Trade The Minimum If It Risks At Most N x The Plan (0 = skip)", minval = 0.0, step = 0.5, group = grpS83Sym, tooltip = "When the risk-based size is below the minimum quantity, trade the minimum only if its loss at the stop is at most this many times the planned risk.")

grpS83 = "83% Strategy - Setup (LTF)"
ltfBarsToProcess = input.int(25, "LTF Independent Processed Bars", minval = 5, maxval = 400, group = grpS83, tooltip = "How many LTF candles the setup is looked for in, and how far back Base's structure is drawn on the LTF chart. A (the HL or LH) must lie within them; a setup whose A leaves them expires.")
entryLevel = input.float(0.83, "Entry Fibonacci Level", minval = 0.01, maxval = 0.99, step = 0.01, group = grpS83, tooltip = "The retracement of the A-to-B leg where the order is placed: 0.83 = 83%, measured from B (0%) back towards A (100%).")
impulseCandles = input.int(3, "Heavy Pressure: Candles After The HL/LH", minval = 0, maxval = 20, group = grpS83, tooltip = "Heavy pressure must start the move: a candle within this many candles after A (A's own candle included) must close far enough beyond A (below).")
impulseMinAtr = input.float(2.0, "Heavy Pressure: Minimum Move (LTF ATR)", minval = 0.0, step = 0.1, group = grpS83, tooltip = "How far beyond A that close must be, in 14-candle LTF ATR measured at A. On real data 2.0 selected the strongest 43% of HL-to-HH legs. 0 accepts every leg.")
allowEarlyEntries = input.bool(false, "Also Trade When Tradable (Early)", group = grpS83, tooltip = "Off: Market Tradability must read Tradable. On: Tradable (Early) is accepted too.")

grpS83Conf = "83% Strategy - Entry Confirmation"
engulfConfirm = input.bool(true, "Wait For An Engulfing After The 83% Touch", group = grpS83Conf, tooltip = "On: once price touches the entry level, the trade waits for an engulfing candle in the trade direction (bullish for buys, bearish for sells) on the lower timeframe or the LTF, on the touching candle or later, and enters at its close. Off: a limit order at the entry level.")
useLowerEngulf = input.bool(true, "Engulfing On The Lower Timeframe", inline = "lower", group = grpS83Conf)
engulfLowerTf = input.timeframe("15", "", inline = "lower", group = grpS83Conf, tooltip = "The lower timeframe (M15 by default). Its candles inside each LTF candle are read with request.security_lower_tf; the entry is placed at the close of the LTF candle that contains the engulfing.")
useLtfEngulf = input.bool(true, "Engulfing On The LTF", group = grpS83Conf, tooltip = "An engulfing of the LTF candles (M30 by default) also confirms the entry.")
confirmWindow = input.int(4, "LTF Candles To Wait For The Engulfing", minval = 1, maxval = 50, group = grpS83Conf, tooltip = "The engulfing must close within this many LTF candles, the touching candle included. The setup also fails if a candle closes through A or price makes a new HH (LL) first.")

grpS83Risk = "83% Strategy - Risk Management"
riskPercent = input.float(5.0, "Risk (%) Per Trade", minval = 0.01, maxval = 100.0, step = 0.1, group = grpS83Risk, tooltip = "Share of the balance (initial capital plus net profit) lost at the stop. Quantity = balance x risk % / 100 / (stop distance x point value).")
maxTradesPerDay = input.int(5, "Number Of Trades Per Day (Max)", minval = 1, group = grpS83Risk, tooltip = "At most this many entries per day (exchange time zone).")
lossesBeforeCut = input.int(2, "Consecutive Losses Before Cutting The Risk (0 = never)", minval = 0, group = grpS83Risk, tooltip = "After every run of this many consecutive losses in a day the risk is multiplied by the factor below; it is restored at the start of the next day. A breakeven exit is not a loss and ends the run.")
riskCutFactor = input.float(0.5, "Risk Multiplier After Each Run Of Losses", minval = 0.01, maxval = 1.0, step = 0.05, group = grpS83Risk, tooltip = "0.5 halves the risk.")
tradeMon = input.bool(true, "Mon", inline = "days", group = grpS83Risk)
tradeTue = input.bool(true, "Tue", inline = "days", group = grpS83Risk)
tradeWed = input.bool(true, "Wed", inline = "days", group = grpS83Risk)
tradeThu = input.bool(true, "Thu", inline = "days", group = grpS83Risk)
tradeFri = input.bool(true, "Fri", inline = "days", group = grpS83Risk)
tradeSat = input.bool(true, "Sat", inline = "days", group = grpS83Risk)
tradeSun = input.bool(false, "Sun", inline = "days", group = grpS83Risk, tooltip = "Trading days (exchange time zone). Monday to Saturday by default.")
qtyStep = input.float(0.001, "Quantity Step", minval = 0.000001, group = grpS83Risk, tooltip = "Order quantities are rounded down to a multiple of this.")

grpS83Stops = "83% Strategy - Stop Loss, Take Profit and Breakeven"
slBufferAtr = input.float(0.5, "Stop Loss Behind The HL/LH (LTF ATR)", minval = 0.0, step = 0.05, group = grpS83Stops, tooltip = "The ATR-based stop behind A that sets the position's natural reward-to-risk. With 0.5 the natural ratio fell between 1:2.2 and 1:3.0 for 80% of real-data setups.")
tpBufferAtr = input.float(0.1, "Take Profit Before The HH/LL (LTF ATR)", minval = 0.0, step = 0.05, group = grpS83Stops, tooltip = "The take profit sits this far before B, the HH (LL) the Fibonacci's 0% is drawn at.")
rrLow = input.float(2.0, "Standard R:R (1:2)", minval = 0.1, step = 0.5, group = grpS83Stops, tooltip = "The trade uses whichever of the two standard ratios is closer to the natural one (1:2.4 uses 1:2) and moves the stop to match, keeping the take profit.")
rrHigh = input.float(3.0, "Standard R:R (1:3)", minval = 0.1, step = 0.5, group = grpS83Stops)
breakevenPercent = input.float(60.0, "Breakeven At % Of The Take Profit (0 = off)", minval = 0.0, maxval = 99.0, step = 5.0, group = grpS83Stops, tooltip = "The stop moves to the entry price once a candle has covered this share of the way to the take profit (from the next candle).")

grpS83Fib = "83% Strategy - Fibonacci (Fib Base)"
showFib83 = input.bool(true, "Show Fibonacci", group = grpS83Fib, tooltip = "Fib Base's levels over each setup: 0% at B, 100% at A, and the entry level in its own color.")
FIB_TIP = "Show, ratio and color of the level, measured from B (0) to A (1)."
fibShow1 = input.bool(true, "", inline = "f1", group = grpS83Fib)
fibRatio1 = input.float(0.0, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f1", group = grpS83Fib)
fibColor1 = input.color(#787B86, "", inline = "f1", group = grpS83Fib, tooltip = FIB_TIP)
fibShow2 = input.bool(false, "", inline = "f2", group = grpS83Fib)
fibRatio2 = input.float(0.5, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f2", group = grpS83Fib)
fibColor2 = input.color(#4CAF50, "", inline = "f2", group = grpS83Fib, tooltip = FIB_TIP)
fibShow3 = input.bool(false, "", inline = "f3", group = grpS83Fib)
fibRatio3 = input.float(0.618, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f3", group = grpS83Fib)
fibColor3 = input.color(#089981, "", inline = "f3", group = grpS83Fib, tooltip = FIB_TIP)
fibShow4 = input.bool(false, "", inline = "f4", group = grpS83Fib)
fibRatio4 = input.float(0.705, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f4", group = grpS83Fib)
fibColor4 = input.color(#00BCD4, "", inline = "f4", group = grpS83Fib, tooltip = FIB_TIP)
fibShow5 = input.bool(false, "", inline = "f5", group = grpS83Fib)
fibRatio5 = input.float(0.886, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f5", group = grpS83Fib)
fibColor5 = input.color(#9C27B0, "", inline = "f5", group = grpS83Fib, tooltip = FIB_TIP)
fibShow6 = input.bool(true, "", inline = "f6", group = grpS83Fib)
fibRatio6 = input.float(1.0, "", minval = -5.0, maxval = 5.0, step = 0.001, inline = "f6", group = grpS83Fib)
fibColor6 = input.color(#787B86, "", inline = "f6", group = grpS83Fib, tooltip = FIB_TIP)
entryLevelColor = input.color(#FF9800, "Entry Level Color", group = grpS83Fib, tooltip = "Color of the entry level (83%) line and label.")
fibLineStyleInput = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpS83Fib, tooltip = "Style of the Fibonacci lines of armed and touched setups (failed ones are dotted).")
fibLineWidth = input.int(1, "Line Width", minval = 1, maxval = 4, group = grpS83Fib, tooltip = "Width of the Fibonacci lines.")
fibLabelInput = input.string("Percent", "Label Text", options = ["Percent", "Ratio", "Price", "Percent + Price"], group = grpS83Fib, tooltip = "Percent: 83.00%. Ratio: 0.83. Price: the level's price.")
fibRightOffset = input.int(10, "Right Offset (candles)", minval = 0, maxval = 200, group = grpS83Fib, tooltip = "How far right of the latest candle (or of the candle that ended the setup) the levels reach.")

grpS83Vis = "83% Strategy - Visuals (LTF)"
showSetupPoints = input.bool(true, "Show A / B / C", group = grpS83Vis, tooltip = "A: the HL (LH) the heavy move started from. B: the HH (LL) it formed. C: the entry, where price touched the entry level.")
bullSetupColor = input.color(color.red, "Buy Setup Color", group = grpS83Vis, tooltip = "Color of A / B / C of buy setups.")
bearSetupColor = input.color(#4169E1, "Sell Setup Color", group = grpS83Vis, tooltip = "Color of A / B / C of sell setups.")
showPositionBoxes = input.bool(true, "Show Target And Stop Zones", group = grpS83Vis, tooltip = "The target zone (entry to take profit) and stop zone (entry to stop loss) from C, as in the strategy's examples; armed setups show the planned zones faintly from the latest candle.")
targetZoneColor = input.color(color.new(#2962FF, 80), "Target Zone Color", group = grpS83Vis)
stopZoneColor = input.color(color.new(#F23645, 80), "Stop Zone Color", group = grpS83Vis)
positionBoxCandles = input.int(20, "Zone Width (candles)", minval = 1, maxval = 500, group = grpS83Vis)
showFailedSetups = input.bool(true, "Show Failed Setups", group = grpS83Vis, tooltip = "Keep invalidated, expired, missed and replaced setups on the chart, dotted with their reason.")
s83Alerts = input.bool(false, "Alert On 83% Setups And Entries", group = grpS83Vis, tooltip = "Send an alert() when a setup is armed and when a trade is entered. Create the alert with Any alert() function call.")

// ------------------------------------------------------ internal tuning
// Kept out of the inputs, as in Base.mq5.
HTF_MA_FULL_BODY = false
MTF_MA_FULL_BODY = false
ADX_MINIMUM = 25.0
ADX_BOS_AND_CHOCH = false
ATR_MODE = "Minimum"
ATR_MINIMUM = 1.0
ATR_MAXIMUM = 10.0
MAX_EXTENSION_ATR = 10.0
VOLUME_AVERAGE_LENGTH = 20
VOLUME_MIN_RATIO = 0.50
VOLUME_MAX_RATIO = 2.00
MOMENTUM_AVERAGE_LENGTH = 20
MOMENTUM_MIN_RATIO = 0.50
MOMENTUM_MAX_RATIO = 2.00

// Swing detection (Smart Money Engine): a swing high is a pivot of the
// timeframe's Swing Detection Length candles on each side (see
// pivotHighFound), which is also how many candles it takes to confirm. A
// lower length finds more, faster swings; a higher length fewer, cleaner
// ones. The internal structure uses the same pivots with the shorter Internal
// Structure Length. The 14-candle ATR sizes the EQH/EQL threshold and the
// CHoCH trap area.
SWING_ATR_LENGTH = 14

// Consolidation / Undefined: the breaks since the oldest of the last
// SPORADIC_LABELS labels flip direction SPORADIC_FLIPS times, or two CHoCHs
// since the last confirming BOS lie within CHOCH_TRAP_AREA_ATR ATR.
SPORADIC_LABELS = 5
SPORADIC_FLIPS = 2
CHOCH_TRAP_AREA_ATR = 4.0

// Kept history: enough for the last five labels and the recent breaks.
MAX_POINTS = 80
MAX_EVENTS = 200
MAX_TRAP = 50

HIGH_LABEL_COLOR = #CD5C5C
LOW_LABEL_COLOR = #008080

if not useHtf and not useMtf and not useLtf
    runtime.error("Enable at least one trend analysis timeframe")
if not useCorrOpt and not useExtOpt and not useVolOpt and not useMomOpt
    runtime.error("Enable at least one Optimal Conditions requirement")
if rrHigh < rrLow
    runtime.error("The second standard R:R must be at least the first")

// ------------------------------------------------------ structure engine
// An equal high or low (EQH/EQL, see markEqual) keeps the role of the swing
// it equals, and its break level is the outer edge of the pair.
type SPoint
    int id
    int pivotBar
    int pivotTime
    float price
    int side
    int kind
    bool superseded = false
    int equalId = -1
    float equalPrice = na
    int equalTime = na
    int equalBar = -1
    float level = na
    int levelTime = na
    int levelBar = -1
    // The first candle after levelBar whose wick or body reached the level
    // (-1 until one does), tracked while the swing can still become a level.
    int levelTouchBar = -1
    int levelTouchTime = na

type SEvent
    int bar
    int breakBar
    int breakTime
    int dir
    bool bos
    int swingTime
    float level
    int seq = 0
    bool ls = false
    int lsBar = -1
    int swingBar = -1
    // Where its line ends: the first candle that touched the level.
    int endBar = -1
    int endTime = na

type SLevel
    bool active = false
    float price = na
    int swingTime = na
    int point = -1
    int swingBar = -1
    int touchBar = -1
    int touchTime = na

type SEngine
    array<SPoint> points
    array<SEvent> events
    array<SEvent> trapChochs
    array<SPoint> newPoints
    array<SPoint> dropped
    array<SEvent> newEvents
    SLevel hh
    SLevel lh
    SLevel ll
    SLevel hl
    SPoint highPt
    SPoint lowPt
    // The previous leg's swing on each side: the one a new swing is labelled
    // against, and the one it may equal (EQH/EQL).
    SPoint highRefPt
    SPoint lowRefPt
    int nextId = 0
    int lastSide = 0
    bool haveHighRef = false
    bool haveLowRef = false
    float highRef = 0.0
    float lowRef = 0.0
    int dir = 0
    bool lastBos = false
    bool haveHigh = false
    bool haveLow = false
    float lastHigh = 0.0
    float lastLow = 0.0
    int lastHighKind = 0
    int lastLowKind = 0
    int lastHighTime = na
    int lastLowTime = na
    int chochDir = 0
    int chochBreakBar = -1
    int chochBreakTime = na
    float chochLevel = na
    int chochLevelTime = na
    int chochLevelPoint = -1
    int chochLevelBar = -1
    int chochTouchBar = -1
    int chochTouchTime = na
    int eventTotal = 0
    int consolidation = 0
    int labelsFromIdx = -1
    int trapFromIdx = -1
    // LS watch on the latest CHoCH (see lsClose).
    SEvent lsEvent
    int lsSeq = -1
    int lsDir = 0
    float lsOrigin = na
    float lsExtreme = na
    int lsPriorDir = 0
    bool lsPriorBos = false
    bool lsTriggered = false
    bool lsBeyond = false
    int lsTotal = 0
    array<SEvent> newLs
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh = na
    int trailHighTime = na
    float trailLow = na
    int trailLowTime = na

newEngine() =>
    SEngine.new(points = array.new<SPoint>(), events = array.new<SEvent>(), trapChochs = array.new<SEvent>(), newPoints = array.new<SPoint>(), dropped = array.new<SPoint>(), newEvents = array.new<SEvent>(), hh = SLevel.new(), lh = SLevel.new(), ll = SLevel.new(), hl = SLevel.new(), newLs = array.new<SEvent>())

method setLevel(SLevel lv, SPoint p) =>
    lv.active := true
    lv.price := p.level
    lv.swingTime := p.levelTime
    lv.swingBar := p.levelBar
    lv.point := p.id
    lv.touchBar := p.levelTouchBar
    lv.touchTime := p.levelTouchTime

// A swing is identified once the opposite leg after it has begun: no later
// pivot can replace it, so it stays marked on the chart. Only then does it
// become the HH/LH (or LL/HL) whose close-through is a break.
method identifySwing(SEngine e, SPoint p) =>
    if not na(p)
        if p.side > 0
            if p.kind > 0
                e.hh.setLevel(p)
            else if p.kind < 0
                e.lh.setLevel(p)
        else
            if p.kind > 0
                e.ll.setLevel(p)
            else if p.kind < 0
                e.hl.setLevel(p)
    p

method highId(SEngine e) =>
    int id = -1
    if not na(e.highPt)
        id := e.highPt.id
    id

method lowId(SEngine e) =>
    int id = -1
    if not na(e.lowPt)
        id := e.lowPt.id
    id

method addPoint(SEngine e, int pivotBar, int pivotTime, float price, int side, int kind) =>
    e.nextId += 1
    SPoint p = SPoint.new(e.nextId, pivotBar, pivotTime, price, side, kind, level = price, levelTime = pivotTime, levelBar = pivotBar)
    e.points.push(p)
    if e.points.size() > MAX_POINTS
        e.points.shift()
    e.newPoints.push(p)
    p

// A BOS that follows an event in the same direction confirms that direction
// and ends any CHoCH trap; every other CHoCH joins the trap window.
// e.dir is the direction of the latest event that is not an LS.
// EQH / EQL: a swing within the EQH/EQL Threshold (ATR) of the previous swing
// on its side (the swing its HH/LH or LL/HL label is judged against) is an
// equal high or low. The two swings are one liquidity pool, so the new swing
// keeps the role of the swing it equals instead of being called higher or
// lower by a hair, and the pool's outer edge is the level a close must break.
// An untyped first swing has no role to pass on.
markEqual(SPoint p, SPoint ref, float tol) =>
    if not na(ref) and tol > 0
        if ref.kind != 0 and math.abs(p.price - ref.price) < tol
            p.kind := ref.kind
            p.equalId := ref.id
            p.equalPrice := ref.price
            p.equalTime := ref.pivotTime
            p.equalBar := ref.pivotBar
            if p.side > 0 ? ref.level > p.level : ref.level < p.level
                p.level := ref.level
                p.levelTime := ref.levelTime
                p.levelBar := ref.levelBar
                p.levelTouchBar := ref.levelTouchBar
                p.levelTouchTime := ref.levelTouchTime
    p

method addEvent(SEngine e, int bar, int breakBar, int breakTime, int dir, bool bos, int swingTime, float level, int swingBar, int endBar, int endTime) =>
    SEvent ev = SEvent.new(bar, breakBar, breakTime, dir, bos, swingTime, level, e.eventTotal, swingBar = swingBar, endBar = endBar, endTime = endTime)
    int prevDir = e.dir
    e.events.push(ev)
    if e.events.size() > MAX_EVENTS
        e.events.shift()
    if bos and prevDir == dir
        e.trapChochs.clear()
    else if not bos
        e.trapChochs.push(ev)
        if e.trapChochs.size() > MAX_TRAP
            e.trapChochs.shift()
    e.newEvents.push(ev)
    e.eventTotal += 1
    e.dir := dir
    e.lastBos := bos

method startChoch(SEngine e, int dir, int bar, int barTime, SLevel lv) =>
    e.chochDir := dir
    e.chochBreakBar := bar
    e.chochBreakTime := barTime
    e.chochLevel := lv.price
    e.chochLevelTime := lv.swingTime
    e.chochLevelPoint := lv.point
    e.chochLevelBar := lv.swingBar
    e.chochTouchBar := lv.touchBar
    e.chochTouchTime := lv.touchTime

// Drops a candidate. While the broken LH/HL is still the latest swing on its
// side it stays the most recent LH/HL, so a later close through it is a
// fresh break.
method cancelChoch(SEngine e) =>
    if e.chochDir > 0 and e.highId() == e.chochLevelPoint
        e.lh := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    if e.chochDir < 0 and e.lowId() == e.chochLevelPoint
        e.hl := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0

// The swings after the broken LH have made an HH (bullish), or after the
// broken HL an LL (bearish), and no LL (HH) has formed after it since. An
// equal high or low (EQH/EQL) is neither: it did not go beyond the swing it
// equals, so it neither confirms nor cancels a CHoCH.
method chochComplete(SEngine e) =>
    SPoint ext = na
    SPoint opp = na
    if e.chochDir > 0
        ext := e.highPt
        opp := e.lowPt
    else
        ext := e.lowPt
        opp := e.highPt
    bool done = false
    if not na(ext)
        if ext.id > e.chochLevelPoint and ext.kind > 0 and ext.equalId < 0
            if na(opp)
                done := true
            else
                done := opp.id < ext.id or opp.kind < 0 or opp.equalId >= 0
    done

// A CHoCH that reversed a trend is watched while it is the latest event: if
// the old trend carries on instead, it was a liquidity sweep (LS).
//  * Protected swing (origin): the swing the breaking move started from, the
//    last low before the HH of a bullish CHoCH (the last high before the LL
//    of a bearish one).
//  * Extreme: the old trend's most recent identified LL (bullish CHoCH) or
//    HH (bearish CHoCH).
//  * Trigger: a close through the protected swing.
//  * Confirmation: the old trend carries on beyond its extreme, by a close
//    (which is also the old trend's BOS) or by a swing, before anything else
//    prints. A BOS in the CHoCH's direction or an opposite CHoCH ends the
//    watch, and the CHoCH stands.
method confirmChoch(SEngine e, int bar) =>
    int priorDir = e.dir
    bool priorBos = e.lastBos
    int direction = e.chochDir
    e.addEvent(bar, e.chochBreakBar, e.chochBreakTime, direction, false, e.chochLevelTime, e.chochLevel, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0
    e.lsSeq := -1
    SPoint origin = direction > 0 ? e.lowPt : e.highPt
    SLevel extreme = direction > 0 ? e.ll : e.hh
    if priorDir != 0 and not na(origin) and not na(extreme.swingTime)
        e.lsEvent := e.events.last()
        e.lsSeq := e.lsEvent.seq
        e.lsDir := direction
        e.lsOrigin := origin.price
        e.lsExtreme := extreme.price
        e.lsPriorDir := priorDir
        e.lsPriorBos := priorBos
        e.lsTriggered := false
        e.lsBeyond := false
    e.lsSeq

method lsWatching(SEngine e) =>
    e.lsSeq >= 0 and e.lsSeq == e.eventTotal - 1

// A swing on the old trend's side (side -1 low, 1 high) while watching:
// beyond the extreme it shows the old trend carrying on. True when that
// confirms the LS.
method lsSwing(SEngine e, int side, float price) =>
    bool confirm = false
    if e.lsWatching() and e.lsDir == -side
        if side < 0 ? price < e.lsExtreme : price > e.lsExtreme
            e.lsBeyond := true
        confirm := e.lsTriggered and e.lsBeyond
    confirm

// A close while watching. True when it confirms the LS.
method lsClose(SEngine e, float c) =>
    bool confirm = false
    if e.lsWatching()
        bool bullish = e.lsDir > 0
        if bullish ? c < e.lsOrigin : c > e.lsOrigin
            e.lsTriggered := true
        confirm := e.lsTriggered and (e.lsBeyond or (bullish ? c < e.lsExtreme : c > e.lsExtreme))
    confirm

// The CHoCH was a liquidity sweep: it is relabelled LS and the trend it
// changed is restored, as if it had never printed. It also leaves the CHoCH
// trap, and any CHoCH attempt still pending ends.
method confirmLs(SEngine e, int bar) =>
    SEvent ev = e.lsEvent
    ev.ls := true
    ev.lsBar := bar
    e.dir := e.lsPriorDir
    e.lastBos := e.lsPriorBos
    int t = e.trapChochs.size()
    if t > 0
        if e.trapChochs.get(t - 1).seq == ev.seq
            e.trapChochs.pop()
    e.newLs.push(ev)
    e.lsTotal += 1
    e.lsSeq := -1
    e.chochDir := 0

// A pivot high is accepted if it extends the current high leg or starts a new
// high leg. It is labelled HH/LH against the previous high leg.
method onPivotHigh(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == 1
    bool accepted = false
    if sameLeg
        if v > e.lastHigh
            e.lastHigh := v
            kind := e.haveHighRef ? (v > e.highRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveHighRef := e.haveHigh
        e.highRef := e.lastHigh
        kind := e.haveHigh ? (v > e.lastHigh ? 1 : -1) : 0
        e.haveHigh := true
        e.lastHigh := v
        e.lastSide := 1
        accepted := true
    if accepted
        // A higher pivot in the same leg replaces the leg's high; the first
        // high of a new leg ends the low leg, identifying its low.
        if sameLeg
            e.highPt.superseded := true
            e.dropped.push(e.highPt)
        else
            e.identifySwing(e.lowPt)
            e.highRefPt := e.highPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, 1, kind), e.highRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.highPt := p
        e.lastHighKind := kind
        e.lastHighTime := pivotTime
        // An HH beyond the old uptrend's extreme after a failed bearish CHoCH
        // confirms the LS; a pending CHoCH attempt ends with it.
        if e.lsSwing(1, v)
            e.confirmLs(curBar)
        // Only swings formed after the breaking close can cancel a CHoCH, and
        // an equal high never does.
        else if e.chochDir > 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir < 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

method onPivotLow(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == -1
    bool accepted = false
    if sameLeg
        if v < e.lastLow
            e.lastLow := v
            kind := e.haveLowRef ? (v < e.lowRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveLowRef := e.haveLow
        e.lowRef := e.lastLow
        kind := e.haveLow ? (v < e.lastLow ? 1 : -1) : 0
        e.haveLow := true
        e.lastLow := v
        e.lastSide := -1
        accepted := true
    if accepted
        if sameLeg
            e.lowPt.superseded := true
            e.dropped.push(e.lowPt)
        else
            e.identifySwing(e.highPt)
            e.lowRefPt := e.lowPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, -1, kind), e.lowRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.lowPt := p
        e.lastLowKind := kind
        e.lastLowTime := pivotTime
        if e.lsSwing(-1, v)
            e.confirmLs(curBar)
        else if e.chochDir < 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir > 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

// A structure line never clips through a candle: it ends on the first candle
// after its swing whose wick or body reaches the level (high at or above a
// swing high, low at or below a swing low). The candle that closes through
// the level always touches it, so a break's line ends there at the latest.
// The swings that can still become levels (the latest swing and the previous
// leg's swing on each side) and the four levels record their first touch as
// candles close; the candles between a pivot and its confirmation never
// reach it.
method touchLevel(SLevel lv, int side, float h, float l, int curBar, int curTime) =>
    if lv.active and lv.touchBar < 0 and (side > 0 ? h >= lv.price : l <= lv.price)
        lv.touchBar := curBar
        lv.touchTime := curTime
    lv.touchBar

touchPoint(SPoint p, float h, float l, int curBar, int curTime) =>
    if not na(p)
        if p.levelTouchBar < 0 and (p.side > 0 ? h >= p.level : l <= p.level)
            p.levelTouchBar := curBar
            p.levelTouchTime := curTime
    p

// Only a candle close through an identified swing is a break; a wick is a
// sweep.
//  * The most recent identified LH broken while the trend is not bullish
//    starts a bullish CHoCH (an LH broken with an HH is the CHoCH, not a BOS).
//  * The most recent identified HH broken is a bullish BOS. Bearish mirrors
//    both.
method onClose(SEngine e, float c, float h, float l, int curBar, int curTime) =>
    e.hh.touchLevel(1, h, l, curBar, curTime)
    e.lh.touchLevel(1, h, l, curBar, curTime)
    e.ll.touchLevel(-1, h, l, curBar, curTime)
    e.hl.touchLevel(-1, h, l, curBar, curTime)
    // LS first: the restored trend then decides the breaks below, so the
    // protected swing's break is a pullback and a close beyond the old extreme
    // is that trend's BOS.
    if e.lsClose(c)
        e.confirmLs(curBar)
    if e.lh.active and c > e.lh.price
        e.lh.active := false
        if e.dir <= 0 and e.chochDir <= 0
            e.cancelChoch()
            e.startChoch(1, curBar, curTime, e.lh)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.hh.active and c > e.hh.price
        e.hh.active := false
        if e.chochDir <= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, 1, true, e.hh.swingTime, e.hh.price, e.hh.swingBar, e.hh.touchBar, e.hh.touchTime)
    if e.hl.active and c < e.hl.price
        e.hl.active := false
        if e.dir >= 0 and e.chochDir >= 0
            e.cancelChoch()
            e.startChoch(-1, curBar, curTime, e.hl)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.ll.active and c < e.ll.price
        e.ll.active := false
        if e.chochDir >= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, -1, true, e.ll.swingTime, e.ll.price, e.ll.swingBar, e.ll.touchBar, e.ll.touchTime)
    e.dir

// Strong/Weak High/Low after one candle (Smart Money Engine): a break on this
// candle (a new event, or an LS confirmed on it) protects the latest swing on
// the other side of the resulting trend, then the trailing extreme on the
// trend's side follows the candle. The protected swing is Strong, the
// trailing extreme Weak: Strong Low / Weak High in a bullish trend, Strong
// High / Weak Low in a bearish one.
method trailExtremes(SEngine e, float h, float l, int curTime) =>
    bool broke = e.newEvents.size() > 0 or e.newLs.size() > 0
    if broke and e.dir > 0 and not na(e.lowPt)
        e.trailLow := e.lowPt.price
        e.trailLowTime := e.lowPt.pivotTime
    if broke and e.dir < 0 and not na(e.highPt)
        e.trailHigh := e.highPt.price
        e.trailHighTime := e.highPt.pivotTime
    if e.dir > 0 and (na(e.trailHigh) or h > e.trailHigh)
        e.trailHigh := h
        e.trailHighTime := curTime
    if e.dir < 0 and (na(e.trailLow) or l < e.trailLow)
        e.trailLow := l
        e.trailLowTime := curTime
    e.dir

// One closed candle: the swing confirmed on it (its pivot is Swing Detection
// Length candles back), then the candle's close, then the trailing extremes
// and the touches of the swings that can still become levels.
// A candle that is both a swing high and a swing low (an outside candle, about
// 4% of swing candles at 1 candle a side) is taken in the order its price most
// likely went: a bullish candle made its low first (lowFirst), a bearish or
// flat one its high first.
method step(SEngine e, bool isPh, bool isPl, float phV, float plV, int pivotBar, int pivotTime, float equalTol, float c, float h, float l, int curBar, int curTime, bool lowFirst) =>
    e.newPoints.clear()
    e.dropped.clear()
    e.newEvents.clear()
    e.newLs.clear()
    if lowFirst and isPl
        e.onPivotLow(plV, pivotBar, pivotTime, equalTol, curBar)
    if isPh
        e.onPivotHigh(phV, pivotBar, pivotTime, equalTol, curBar)
    if isPl and not lowFirst
        e.onPivotLow(plV, pivotBar, pivotTime, equalTol, curBar)
    e.onClose(c, h, l, curBar, curTime)
    e.trailExtremes(h, l, curTime)
    touchPoint(e.highPt, h, l, curBar, curTime)
    touchPoint(e.lowPt, h, l, curBar, curTime)
    touchPoint(e.highRefPt, h, l, curBar, curTime)
    touchPoint(e.lowRefPt, h, l, curBar, curTime)

// Consolidation / Undefined, 1 = sporadic 5-label sequence, 2 = multiple
// CHoCHs without a BoS, 3 = both.
method classify(SEngine e, float atrNow) =>
    int cons = 0
    int labels = 0
    int firstIdx = -1
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labels += 1
                firstIdx := k
                if labels >= SPORADIC_LABELS
                    break
    e.labelsFromIdx := labels >= SPORADIC_LABELS ? firstIdx : -1
    if e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        int flips = 0
        int prevDir = 0
        int m = e.events.size()
        if m > 0
            for i = m - 1 to 0
                SEvent ev = e.events.get(i)
                if ev.breakBar < fromBar
                    break
                // An LS is not a break: it never flips the structure.
                if ev.ls
                    continue
                if prevDir != 0 and ev.dir != prevDir
                    flips += 1
                prevDir := ev.dir
        if flips >= SPORADIC_FLIPS
            cons := 1
    e.trapFromIdx := -1
    int t = e.trapChochs.size()
    if t >= 2
        SEvent latest = e.trapChochs.get(t - 1)
        for i = 0 to t - 2
            SEvent ev = e.trapChochs.get(i)
            if math.abs(ev.level - latest.level) <= CHOCH_TRAP_AREA_ATR * atrNow
                cons += 2
                e.trapFromIdx := i
                break
    e.consolidation := cons
    cons

labelDigit(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? 5 : 6) : p.side > 0 ? (p.kind > 0 ? 1 : 2) : (p.kind > 0 ? 3 : 4)

eventDigit(SEvent ev) =>
    ev.bos ? (ev.dir > 0 ? 1 : 2) : (ev.dir > 0 ? 3 : 4)

// Numeric evidence for the dashboard (strings are built on the chart):
// label digits 1 HH, 2 LH, 3 LL, 4 HL, 5 EQH, 6 EQL; break digits 1 bull
// BoS, 2 bear BoS, 3 bull CHoCH, 4 bear CHoCH.
method summary(SEngine e) =>
    int labelsCode = 0
    float rangeLo = na
    float rangeHi = na
    int n = e.points.size()
    if e.labelsFromIdx >= 0 and n > 0
        for k = e.labelsFromIdx to n - 1
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labelsCode := labelsCode * 10 + labelDigit(p)
                rangeHi := na(rangeHi) ? p.price : math.max(rangeHi, p.price)
                rangeLo := na(rangeLo) ? p.price : math.min(rangeLo, p.price)
    int breaksCode = 0
    int breaksCount = 0
    int m = e.events.size()
    if e.consolidation % 2 == 1 and m > 0 and e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        array<int> breaks = array.new<int>()
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if ev.breakBar < fromBar
                break
            if not ev.ls
                breaks.unshift(i)
        breaksCount := breaks.size()
        if breaksCount > 0
            for j = math.max(0, breaksCount - 9) to breaksCount - 1
                breaksCode := breaksCode * 10 + eventDigit(e.events.get(breaks.get(j)))
    int trapCode = 0
    int trapCount = 0
    float trap1 = na
    float trap2 = na
    float trap3 = na
    float trap4 = na
    int t = e.trapChochs.size()
    if e.consolidation >= 2 and e.trapFromIdx >= 0 and t > 0
        trapCount := t - e.trapFromIdx
        int slot = 0
        for i = math.max(e.trapFromIdx, t - 4) to t - 1
            SEvent ev = e.trapChochs.get(i)
            trapCode := trapCode * 10 + eventDigit(ev)
            if slot == 0
                trap1 := ev.level
            else if slot == 1
                trap2 := ev.level
            else if slot == 2
                trap3 := ev.level
            else
                trap4 := ev.level
            slot += 1
    int latestCode = 0
    float latestLevel = na
    if m > 0
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if not ev.ls
                latestCode := eventDigit(ev)
                latestLevel := ev.level
                break
    // New on this candle: an LS first (5 a failed bullish CHoCH, 6 a failed
    // bearish one), then the events.
    int newCode = 0
    int lsFresh = e.newLs.size()
    if lsFresh > 0
        for i = 0 to lsFresh - 1
            newCode := newCode * 10 + (e.newLs.get(i).dir > 0 ? 5 : 6)
    int fresh = e.newEvents.size()
    if fresh > 0
        for i = 0 to math.min(fresh, 3) - 1
            newCode := newCode * 10 + eventDigit(e.newEvents.get(i))
    float hhV = e.hh.active ? e.hh.price : na
    float lhV = e.lh.active ? e.lh.price : na
    float llV = e.ll.active ? e.ll.price : na
    float hlV = e.hl.active ? e.hl.price : na
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV]

// A swing high must be at least as high as the L candles on its left and
// strictly higher than the L candles on its right (a double top is one swing
// at its latest candle). Swing lows mirror this.
pivotHighFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = high[len]
        for j = len + 1 to 2 * len
            if high[j] > v
                ok := false
        for j = 0 to len - 1
            if high[j] >= v
                ok := false
    ok

pivotLowFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = low[len]
        for j = len + 1 to 2 * len
            if low[j] < v
                ok := false
        for j = 0 to len - 1
            if low[j] <= v
                ok := false
    ok

// Average true range over SWING_ATR_LENGTH candles (fewer at the start).
swingAtrSeries() =>
    float tr = ta.tr(true)
    float avg = ta.sma(tr, SWING_ATR_LENGTH)
    float acc = ta.cum(tr)
    na(avg) ? acc / (bar_index + 1) : avg

// Structure of the timeframe this runs on (inside request.security), with
// pivots of `length` candles on each side.
structureRequest(int length) =>
    var SEngine e = newEngine()
    float atrS = swingAtrSeries()
    bool ph = pivotHighFound(length)
    bool pl = pivotLowFound(length)
    e.step(ph, pl, high[length], low[length], bar_index - length, time[length], equalThreshold * nz(atrS[length]), close, high, low, bar_index, time, ph and pl and close[length] > open[length])
    e.classify(atrS)
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV] = e.summary()
    // Flags cross request.security as 0/1 so a missing value is simply 0.
    [e.dir, e.lastBos ? 1 : 0, e.consolidation, labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV, e.eventTotal + e.lsTotal, e.lastHigh, e.lastHighKind, e.haveHigh ? 1 : 0, e.lastLow, e.lastLowKind, e.haveLow ? 1 : 0, e.trailHigh, e.trailLow]

// ----------------------------------------------- internal structure
// Internal Structure (Smart Money Engine): minor structure inside the swings,
// from pivots of the timeframe's Internal Structure Length candles (default
// 5, shorter than the Swing Detection Length). It gives more insight into the
// moves between swings without changing the Market Trend or alerts; its only
// effect elsewhere is Tradable (Early), which requires it to agree (see
// evaluateTradability).
//  * Each internal pivot high (low) becomes the internal high (low) level.
//  * The first close above the internal high is an internal bullish BOS, or
//    an internal bullish CHoCH when the internal trend was bearish; bearish
//    mirrors this. Each level is broken once, and the break sets the
//    internal trend.
//  * On the chart its breaks are drawn as dashed width-1 lines with faded
//    captions, except where the internal pivot is also a swing of the main
//    structure, which draws that level itself.
// Only closed candles are used.
type SInternal
    int trend = 0
    bool lastChoch = false
    float breakLevel = na
    float highLevel = na
    int highBar = na
    int highTime = na
    bool highBroken = false
    float lowLevel = na
    int lowBar = na
    int lowTime = na
    bool lowBroken = false
    // The first candle after each pivot that touched its level (-1 until
    // one does): where a break's line ends.
    int highTouchBar = -1
    int highTouchTime = na
    int lowTouchBar = -1
    int lowTouchTime = na
    // Breaks made on this candle, and whether each was a CHoCH.
    bool bullBreak = false
    bool bullChoch = false
    bool bearBreak = false
    bool bearChoch = false

// One closed candle: the internal pivots confirmed on it, the touches of
// their levels, then its close.
method update(SInternal s, bool ph, bool pl, float phV, float plV, int pivotBar, int pivotTime, float c, float h, float l, int curBar, int curTime) =>
    s.bullBreak := false
    s.bearBreak := false
    if ph
        s.highLevel := phV
        s.highBar := pivotBar
        s.highTime := pivotTime
        s.highBroken := false
        s.highTouchBar := -1
    if pl
        s.lowLevel := plV
        s.lowBar := pivotBar
        s.lowTime := pivotTime
        s.lowBroken := false
        s.lowTouchBar := -1
    if not na(s.highLevel) and s.highTouchBar < 0 and h >= s.highLevel
        s.highTouchBar := curBar
        s.highTouchTime := curTime
    if not na(s.lowLevel) and s.lowTouchBar < 0 and l <= s.lowLevel
        s.lowTouchBar := curBar
        s.lowTouchTime := curTime
    if not na(s.highLevel) and not s.highBroken and c > s.highLevel
        s.highBroken := true
        s.lastChoch := s.trend < 0
        s.trend := 1
        s.breakLevel := s.highLevel
        s.bullBreak := true
        s.bullChoch := s.lastChoch
    if not na(s.lowLevel) and not s.lowBroken and c < s.lowLevel
        s.lowBroken := true
        s.lastChoch := s.trend > 0
        s.trend := -1
        s.breakLevel := s.lowLevel
        s.bearBreak := true
        s.bearChoch := s.lastChoch
    s

// The internal structure of the timeframe this runs on.
internalRequest(int length) =>
    var SInternal s = SInternal.new()
    s.update(pivotHighFound(length), pivotLowFound(length), high[length], low[length], bar_index - length, time[length], close, high, low, bar_index, time)
    [s.trend, s.lastChoch ? 1 : 0, s.breakLevel]

validSession(string s) =>
    bool ok = str.length(s) == 9 and str.match(s, "^[0-9]{4}-[0-9]{4}$") != ""
    if ok
        float sh = str.tonumber(str.substring(s, 0, 2))
        float sm = str.tonumber(str.substring(s, 2, 4))
        float eh = str.tonumber(str.substring(s, 5, 7))
        float em = str.tonumber(str.substring(s, 7, 9))
        ok := sh <= 23 and eh <= 23 and sm <= 59 and em <= 59
    ok

// Whether the current candle opens inside the session. Presets use named time
// zones, so daylight saving time is handled; the custom session uses Custom
// Session Timezone. Equal start and end means all day; 2200-0600 crosses
// midnight.
sessionOk() =>
    bool ok = true
    if useSession and sessionPreset != "24x7"
        string sess = customSession
        string tz = customTimezone
        if sessionPreset == "New York"
            sess := "0930-1600"
            tz := "America/New_York"
        else if sessionPreset == "London"
            sess := "0800-1700"
            tz := "Europe/London"
        else if sessionPreset == "Tokyo"
            sess := "0900-1500"
            tz := "Asia/Tokyo"
        else if sessionPreset == "Sydney"
            sess := "0800-1700"
            tz := "Australia/Sydney"
        if validSession(sess)
            int begin = int(str.tonumber(str.substring(sess, 0, 2))) * 60 + int(str.tonumber(str.substring(sess, 2, 4)))
            int finish = int(str.tonumber(str.substring(sess, 5, 7))) * 60 + int(str.tonumber(str.substring(sess, 7, 9)))
            int minuteOfDay = hour(time, tz) * 60 + minute(time, tz)
            ok := begin == finish ? true : begin < finish ? minuteOfDay >= begin and minuteOfDay < finish : minuteOfDay >= begin or minuteOfDay < finish
        else
            ok := false
    ok

// Each request returns the state after the last closed candle of its
// timeframe ([1] with lookahead on), so nothing repaints.
htfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(htfSwingLength)
    float maE = ta.ema(close, htfMaLength)
    float maS = ta.sma(close, htfMaLength)
    float maV = htfMaType == "EMA" ? maE : maS
    [diPlus, diMinus, adxV] = ta.dmi(adxLength, adxLength)
    float atrV = ta.sma(ta.tr(true), atrLength)
    int sess = sessionOk() ? 1 : 0
    [iT, iC, iL] = internalRequest(htfInternalLength)
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], nc[1], vhh[1], vlh[1], vll[1], vhl[1], et[1], close[1], open[1], maV[1], adxV[1], atrV[1], sess[1], th[1], tl[1], iT[1], iC[1], iL[1]]

mtfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(mtfSwingLength)
    [iT, iC, iL] = internalRequest(mtfInternalLength)
    float atrS = swingAtrSeries()
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], vhh[1], vlh[1], vll[1], vhl[1], th[1], tl[1], iT[1], iC[1], iL[1], hp[1], hv[1], lp[1], lv[1], atrS[1]]

ltfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(ltfSwingLength)
    float trL = ta.tr(true)
    float volAvg = nz(ta.sma(volume, VOLUME_AVERAGE_LENGTH)[1])
    float volRatio = volAvg > 0 ? nz(volume) / volAvg : 0.0
    float trAvg = nz(ta.sma(trL, MOMENTUM_AVERAGE_LENGTH)[1])
    float momRatio = trAvg > 0 ? trL / trAvg : 0.0
    [iT, iC, iL] = internalRequest(ltfInternalLength)
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], vhh[1], vlh[1], vll[1], vhl[1], close[1], volAvg[1], volRatio[1], trAvg[1], momRatio[1], th[1], tl[1], iT[1], iC[1], iL[1]]

mtfMaRequest() =>
    float e1 = ta.ema(close, mtfMaLength)
    float s1 = ta.sma(close, mtfMaLength)
    float m = mtfMaType == "EMA" ? e1 : s1
    [m[1], open[1], close[1]]

[hDir, hBos, hCons, hLabels, hRangeLo, hRangeHi, hBreaks, hBreaksN, hTrap, hTrapN, hT1, hT2, hT3, hT4, hLatest, hLatestLv, hNew, hHH, hLH, hLL, hHL, hEvents, hClose, hOpen, hMa, hAdx, hAtr, hSession, hTrailHigh, hTrailLow, hInTrend, hInChoch, hInLevel] = request.security(syminfo.tickerid, htfTf, htfRequest(), lookahead = barmerge.lookahead_on)
[mDir, mBos, mCons, mLabels, mRangeLo, mRangeHi, mBreaks, mBreaksN, mTrap, mTrapN, mT1, mT2, mT3, mT4, mLatest, mLatestLv, mHH, mLH, mLL, mHL, mTrailHigh, mTrailLow, mInTrend, mInChoch, mInLevel, mLastHigh, mHaveHigh, mLastLow, mHaveLow, mAtr] = request.security(syminfo.tickerid, mtfTf, mtfRequest(), lookahead = barmerge.lookahead_on)
[lDir, lBos, lCons, lLabels, lRangeLo, lRangeHi, lBreaks, lBreaksN, lTrap, lTrapN, lT1, lT2, lT3, lT4, lLatest, lLatestLv, lHH, lLH, lLL, lHL, lClose, lVolAvg, lVolRatio, lTrAvg, lMomRatio, lTrailHigh, lTrailLow, lInTrend, lInChoch, lInLevel] = request.security(syminfo.tickerid, ltfTf, ltfRequest(), lookahead = barmerge.lookahead_on)
[mtfMaValue, mtfMaOpen, mtfMaClose] = request.security(syminfo.tickerid, mtfTf, mtfMaRequest(), lookahead = barmerge.lookahead_on)

// ---------------------------------------------------- chart structure
// Labels and signals follow the chart timeframe, while the dashboard stays on
// the structure timeframe. Only confirmed candles are processed. The chart
// uses the Swing Detection and Internal Structure Lengths of the matching
// HTF, MTF or LTF inputs; any other chart timeframe uses the HTF lengths.
chartSeconds = timeframe.in_seconds()
chartTfIndex = chartSeconds == timeframe.in_seconds(htfTf) ? 0 : chartSeconds == timeframe.in_seconds(mtfTf) ? 1 : chartSeconds == timeframe.in_seconds(ltfTf) ? 2 : 0
chartLength = chartTfIndex == 1 ? mtfSwingLength : chartTfIndex == 2 ? ltfSwingLength : htfSwingLength
chartInternalLength = chartTfIndex == 1 ? mtfInternalLength : chartTfIndex == 2 ? ltfInternalLength : htfInternalLength
float chartAtr = swingAtrSeries()
bool chartPh = pivotHighFound(chartLength)
bool chartPl = pivotLowFound(chartLength)
bool chartInternalPh = pivotHighFound(chartInternalLength)
bool chartInternalPl = pivotLowFound(chartInternalLength)
var SEngine chartEngine = newEngine()
var SInternal chartInternal = SInternal.new()

labelSize = labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : labelSizeInput == "Large" ? size.large : size.small
lineStyle = lineStyleInput == "Solid" ? line.style_solid : lineStyleInput == "Dotted" ? line.style_dotted : line.style_dashed

// The drawn history covers Bars To Process structure candles.
htfSeconds = timeframe.in_seconds(htfTf)
// The LTF chart draws its own LTF Independent Processed Bars (83% Strategy).
displayBars = chartTfIndex == 2 ? ltfBarsToProcess : math.max(2 * math.max(htfSwingLength, mtfSwingLength, ltfSwingLength) + 2, int(math.ceil(float(barsToProcess) * htfSeconds / math.max(chartSeconds, 1))))
drawFrom = last_bar_index - displayBars
var int drawFromTime = na
if bar_index == math.max(drawFrom, 0)
    drawFromTime := time

swingName(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? "EQH" : "EQL") : p.side > 0 ? (p.kind > 0 ? "HH" : "LH") : (p.kind > 0 ? "LL" : "HL")

// A BOS, CHoCH or LS caption, centred on its line (the candle midway between
// the broken swing and the first candle that touched its level, where the
// line ends): above a line broken upwards, below one broken downwards.
breakLabel(SEvent ev, string txt, color textColor) =>
    label.new(int(math.round(0.5 * (ev.swingBar + ev.endBar))), ev.level, txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = ev.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = textColor, size = labelSize)

// Only the newest swing on each side can be superseded, so the chart keeps
// the label (and EQH/EQL line) of the newest high and low to delete when that
// happens. The drawing of the latest CHoCH, replaced if it becomes an LS.
var int lastChochSeq = -1
var label lastChochLabel = na
var line lastChochLine = na
var label highSwingLabel = na
var line highEqualLine = na
var int highSwingId = -1
var label lowSwingLabel = na
var line lowEqualLine = na
var int lowSwingId = -1

// Whether the main structure has a swing (side 1 high, -1 low) at a candle.
mainSwingAt(SEngine e, int side, int pivotTime) =>
    bool found = false
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if p.side == side and p.pivotTime == pivotTime
                found := true
                break
    found

// The internal structure's BOS/CHoCH (Smart Money Engine): a dashed width-1
// line from the internal pivot to the first candle that touched its level
// (the candle that closed through it at the latest) and a faded caption
// centred on it, above a line broken upwards and below one broken downwards.
internalBreak(int dir, bool choch, float level, int swingTime, int swingBar, int endBar, int endTime) =>
    color clr = dir > 0 ? internalBullColor : internalBearColor
    line ln = line.new(swingTime, level, endTime, level, xloc = xloc.bar_time, color = clr, style = line.style_dashed, width = 1)
    label lbl = label.new(int(math.round(0.5 * (swingBar + endBar))), level, choch ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = dir > 0 ? label.style_label_down : label.style_label_up, textcolor = color.new(clr, 30), size = labelSize)
    [ln, lbl]

// An internal pivot that is also a swing of the main structure is left to
// the main structure, which draws that level. The main swing is confirmed
// Swing Detection Length candles after its pivot, so the internal breaks
// drawn meanwhile are kept (side and pivot time) to delete when it is.
var bool internalHighMain = false
var bool internalLowMain = false
var array<line> internalLines = array.new<line>()
var array<label> internalLabels = array.new<label>()
var array<int> internalSides = array.new<int>()
var array<int> internalSwingTimes = array.new<int>()
MAX_INTERNAL_KEPT = 120

if barstate.isconfirmed
    chartEngine.step(chartPh, chartPl, high[chartLength], low[chartLength], bar_index - chartLength, time[chartLength], equalThreshold * nz(chartAtr[chartLength]), close, high, low, bar_index, time, chartPh and chartPl and close[chartLength] > open[chartLength])
    int droppedCount = chartEngine.dropped.size()
    if droppedCount > 0
        for i = 0 to droppedCount - 1
            SPoint gone = chartEngine.dropped.get(i)
            if gone.side > 0 and gone.id == highSwingId
                label.delete(highSwingLabel)
                line.delete(highEqualLine)
                highSwingId := -1
            if gone.side < 0 and gone.id == lowSwingId
                label.delete(lowSwingLabel)
                line.delete(lowEqualLine)
                lowSwingId := -1
    int pointCount = chartEngine.newPoints.size()
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if showSwingPoints and p.kind != 0 and p.pivotBar >= drawFrom
                color swingColor = p.side > 0 ? HIGH_LABEL_COLOR : LOW_LABEL_COLOR
                label lbl = label.new(p.pivotTime, p.price, swingName(p), xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = p.side > 0 ? label.style_label_down : label.style_label_up, textcolor = swingColor, size = labelSize)
                // An equal high or low is joined to the swing it equals.
                line eq = na
                if showEqual and p.equalId >= 0 and p.equalBar >= drawFrom
                    eq := line.new(p.equalTime, p.equalPrice, p.pivotTime, p.price, xloc = xloc.bar_time, color = swingColor, style = line.style_dotted, width = 1)
                if p.side > 0
                    highSwingLabel := lbl
                    highEqualLine := eq
                    highSwingId := p.id
                else
                    lowSwingLabel := lbl
                    lowEqualLine := eq
                    lowSwingId := p.id
    // Internal structure, after the main swings of this candle.
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if p.side > 0 and p.pivotTime == chartInternal.highTime
                internalHighMain := true
            if p.side < 0 and p.pivotTime == chartInternal.lowTime
                internalLowMain := true
            int kept = internalSides.size()
            if kept > 0
                for k = kept - 1 to 0
                    if internalSides.get(k) == p.side and internalSwingTimes.get(k) == p.pivotTime
                        line.delete(internalLines.get(k))
                        label.delete(internalLabels.get(k))
                        internalLines.remove(k)
                        internalLabels.remove(k)
                        internalSides.remove(k)
                        internalSwingTimes.remove(k)
    chartInternal.update(chartInternalPh, chartInternalPl, high[chartInternalLength], low[chartInternalLength], bar_index - chartInternalLength, time[chartInternalLength], close, high, low, bar_index, time)
    if chartInternalPh
        internalHighMain := mainSwingAt(chartEngine, 1, chartInternal.highTime)
    if chartInternalPl
        internalLowMain := mainSwingAt(chartEngine, -1, chartInternal.lowTime)
    if showInternal and bar_index >= drawFrom
        if chartInternal.bullBreak and not internalHighMain
            [ln, lbl] = internalBreak(1, chartInternal.bullChoch, chartInternal.highLevel, chartInternal.highTime, chartInternal.highBar, chartInternal.highTouchBar, chartInternal.highTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(1)
            internalSwingTimes.push(chartInternal.highTime)
        if chartInternal.bearBreak and not internalLowMain
            [ln, lbl] = internalBreak(-1, chartInternal.bearChoch, chartInternal.lowLevel, chartInternal.lowTime, chartInternal.lowBar, chartInternal.lowTouchBar, chartInternal.lowTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(-1)
            internalSwingTimes.push(chartInternal.lowTime)
        while internalSides.size() > MAX_INTERNAL_KEPT
            internalLines.shift()
            internalLabels.shift()
            internalSides.shift()
            internalSwingTimes.shift()
    // An LS replaces the drawing of the CHoCH it reclassifies and keeps its
    // place, in its own colour. It is known before this candle's events.
    int lsCount = chartEngine.newLs.size()
    if lsCount > 0
        for i = 0 to lsCount - 1
            SEvent ev = chartEngine.newLs.get(i)
            if ev.seq == lastChochSeq
                label.delete(lastChochLabel)
                line.delete(lastChochLine)
                lastChochSeq := -1
            if showLs and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color lsColor = ev.dir > 0 ? bullLsColor : bearLsColor
                breakLabel(ev, "LS", lsColor)
                if showLines
                    line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = lsColor, style = lineStyle, width = lineWidth)
    int eventCount = chartEngine.newEvents.size()
    if eventCount > 0
        for i = 0 to eventCount - 1
            SEvent ev = chartEngine.newEvents.get(i)
            bool shown = ev.bos ? showBos : showChoch
            label lbl = na
            line ln = na
            // A break is drawn only with its broken swing, so every BOS, CHoCH
            // and LS starts from a marked swing.
            if shown and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color textColor = ev.dir > 0 ? (ev.bos ? bullBosColor : bullChochColor) : (ev.bos ? bearBosColor : bearChochColor)
                lbl := breakLabel(ev, ev.bos ? "BOS" : "CHoCH", textColor)
                if showLines
                    ln := line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = ev.bos ? color.blue : color.red, style = lineStyle, width = lineWidth)
            // Only the latest CHoCH can still become an LS.
            if not ev.bos
                lastChochSeq := ev.seq
                lastChochLabel := lbl
                lastChochLine := ln

var line lastHighLine = na
var line lastLowLine = na
var line strongWeakHighLine = na
var line strongWeakLowLine = na
var label strongWeakHighLabel = na
var label strongWeakLowLabel = na
if barstate.islast
    line.delete(lastHighLine)
    line.delete(lastLowLine)
    line.delete(strongWeakHighLine)
    line.delete(strongWeakLowLine)
    label.delete(strongWeakHighLabel)
    label.delete(strongWeakLowLabel)
    // Strong/Weak High/Low (Smart Money Engine): dashed lines from the
    // trailing high and low to 20 candles right of the latest candle, with
    // their names just right of the line ends.
    int rightTime = time + 20 * chartSeconds * 1000
    if showStrongWeak and not na(chartEngine.trailHigh)
        strongWeakHighLine := line.new(chartEngine.trailHighTime, chartEngine.trailHigh, rightTime, chartEngine.trailHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakHighLabel := label.new(rightTime, chartEngine.trailHigh, chartEngine.dir < 0 ? "Strong High" : "Weak High", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = HIGH_LABEL_COLOR, size = labelSize)
    if showStrongWeak and not na(chartEngine.trailLow)
        strongWeakLowLine := line.new(chartEngine.trailLowTime, chartEngine.trailLow, rightTime, chartEngine.trailLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakLowLabel := label.new(rightTime, chartEngine.trailLow, chartEngine.dir > 0 ? "Strong Low" : "Weak Low", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = LOW_LABEL_COLOR, size = labelSize)
    if showSwingPoints and chartEngine.haveHigh
        lastHighLine := line.new(chartEngine.lastHighTime, chartEngine.lastHigh, time, chartEngine.lastHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dotted, width = 1)
    if showSwingPoints and chartEngine.haveLow
        lastLowLine := line.new(chartEngine.lastLowTime, chartEngine.lastLow, time, chartEngine.lastLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dotted, width = 1)

plot(useHtfMa and showHtfMaLine ? hMa : na, "HTF MA", color = htfMaColor, linewidth = 2)
plot(useMtfMa and showMtfMaLine ? mtfMaValue : na, "MTF MA", color = mtfMaColor, linewidth = 2)

// ------------------------------------------------------- trend breakdown
type TfView
    int dir
    bool lastBos
    int cons
    int labelsCode
    float rangeLo
    float rangeHi
    int breaksCode
    int breaksCount
    int trapCode
    int trapCount
    float trap1
    float trap2
    float trap3
    float trap4
    int latestCode
    float latestLevel
    float hh
    float lh
    float ll
    float hl
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh
    float trailLow

htfView = TfView.new(nz(hDir), nz(hBos) == 1, nz(hCons), nz(hLabels), hRangeLo, hRangeHi, nz(hBreaks), nz(hBreaksN), nz(hTrap), nz(hTrapN), hT1, hT2, hT3, hT4, nz(hLatest), hLatestLv, hHH, hLH, hLL, hHL, hTrailHigh, hTrailLow)
mtfView = TfView.new(nz(mDir), nz(mBos) == 1, nz(mCons), nz(mLabels), mRangeLo, mRangeHi, nz(mBreaks), nz(mBreaksN), nz(mTrap), nz(mTrapN), mT1, mT2, mT3, mT4, nz(mLatest), mLatestLv, mHH, mLH, mLL, mHL, mTrailHigh, mTrailLow)
ltfView = TfView.new(nz(lDir), nz(lBos) == 1, nz(lCons), nz(lLabels), lRangeLo, lRangeHi, nz(lBreaks), nz(lBreaksN), nz(lTrap), nz(lTrapN), lT1, lT2, lT3, lT4, nz(lLatest), lLatestLv, lHH, lLH, lLL, lHL, lTrailHigh, lTrailLow)

// The Internal Structure of a trend timeframe.
type InternalView
    int trend
    bool lastChoch
    float level

htfInternal = InternalView.new(nz(hInTrend), nz(hInChoch) == 1, hInLevel)
mtfInternal = InternalView.new(nz(mInTrend), nz(mInChoch) == 1, mInLevel)
ltfInternal = InternalView.new(nz(lInTrend), nz(lInChoch) == 1, lInLevel)

biasDirection(TfView v) =>
    v.cons != 0 ? 0 : v.dir

definiteBias(TfView v) =>
    biasDirection(v) != 0 and v.lastBos

biasText(TfView v) =>
    string s = "Consolidation / Undefined"
    int d = biasDirection(v)
    if d > 0
        s := v.lastBos ? "Bullish" : "Bullish Transition"
    else if d < 0
        s := v.lastBos ? "Bearish" : "Bearish Transition"
    s

triggerText(TfView v) =>
    string s = ""
    if v.dir == 0
        s := "No structure break yet"
    else
        if v.cons % 2 == 1
            s := "Sporadic 5-label sequence"
        if v.cons >= 2
            s := s + (s == "" ? "" : " + ") + "Multiple CHoCHs without BoS"
        if s == ""
            s := v.lastBos ? "Clear trending structure" : "Clear structure (CHoCH awaiting BoS)"
    s

priceText(float p) =>
    str.tostring(p, format.mintick)

labelName(int d) =>
    d == 1 ? "HH" : d == 2 ? "LH" : d == 3 ? "LL" : d == 4 ? "HL" : d == 5 ? "EQH" : "EQL"

breakName(int d) =>
    d == 1 ? "bull BoS" : d == 2 ? "bear BoS" : d == 3 ? "bull CHoCH" : "bear CHoCH"

// The digits of a code, oldest first.
codeDigits(int code) =>
    array<int> digits = array.new<int>()
    string raw = code > 0 ? str.tostring(code) : ""
    int len = str.length(raw)
    if len > 0
        for i = 0 to len - 1
            digits.push(int(str.tonumber(str.substring(raw, i, i + 1))))
    digits

evidenceText(TfView v) =>
    string labels = ""
    array<int> ld = codeDigits(v.labelsCode)
    if ld.size() > 0
        for i = 0 to ld.size() - 1
            labels := labels + (labels == "" ? "" : " ") + labelName(ld.get(i))
    string out = labels == "" ? "" : "Labels " + labels
    if v.cons % 2 == 1
        string breaks = v.breaksCount > 9 ? "..." : ""
        array<int> bd = codeDigits(v.breaksCode)
        if bd.size() > 0
            for i = 0 to bd.size() - 1
                breaks := breaks + (breaks == "" ? "" : ", ") + breakName(bd.get(i))
        out := out + "; breaks " + breaks
    if v.cons >= 2
        string chochs = v.trapCount > 4 ? "..." : ""
        array<int> td = codeDigits(v.trapCode)
        array<float> lv = array.from(v.trap1, v.trap2, v.trap3, v.trap4)
        if td.size() > 0
            for i = 0 to td.size() - 1
                chochs := chochs + (chochs == "" ? "" : ", ") + breakName(td.get(i)) + " " + priceText(lv.get(i))
        out := out + (out == "" ? "" : " | ") + chochs + "; no confirming BoS since"
    if v.cons == 0 and v.latestCode > 0
        out := out + (out == "" ? "" : "; ") + "latest " + breakName(v.latestCode) + " " + priceText(v.latestLevel)
    out == "" ? "No labels yet" : out

trendWord(int d) =>
    d > 0 ? "bullish" : "bearish"

// What to do on one timeframe's trend: one action and the level that decides
// it.
recommendationText(TfView v) =>
    int d = biasDirection(v)
    string s = ""
    if v.dir == 0
        s := "Stand aside until a BOS sets the trend."
    else if d == 0
        s := "Stand aside"
        if not na(v.rangeLo) and not na(v.rangeHi)
            s := s + " or trade only the range edges (" + priceText(v.rangeLo) + " to " + priceText(v.rangeHi) + ")"
        if not na(v.hh) and not na(v.ll)
            s := s + "; a close above HH " + priceText(v.hh) + " or below LL " + priceText(v.ll) + " starts a new trend."
        else
            s := s + " until a BOS starts a new trend."
    else if d > 0
        if not v.lastBos
            s := not na(v.hh) ? "Wait for a close above HH " + priceText(v.hh) + " (bullish BOS) before buying." : "Wait for a bullish BOS before buying."
        else
            s := not na(v.hl) ? "Look for buys on pullbacks while price holds above HL " + priceText(v.hl) + "." : "Look for buys on pullbacks."
    else
        if not v.lastBos
            s := not na(v.ll) ? "Wait for a close below LL " + priceText(v.ll) + " (bearish BOS) before selling." : "Wait for a bearish BOS before selling."
        else
            s := not na(v.lh) ? "Look for sells on pullbacks while price holds below LH " + priceText(v.lh) + "." : "Look for sells on pullbacks."
    s

// The internal structure's dashboard output: its trend and latest break.
internalTrendText(InternalView iv) =>
    iv.trend == 0 ? "Undefined" : (iv.trend > 0 ? "Bullish" : "Bearish") + (iv.lastChoch ? " (CHoCH)" : " (BOS)")

// How the internal structure relates to the timeframe's Market Trend.
internalAgreementText(InternalView iv, TfView v, string name) =>
    int d = biasDirection(v)
    string s = ""
    if iv.trend == 0
        s := "No internal break yet to compare with the " + name + " Market Trend."
    else if d == 0
        s := "The " + name + " Market Trend is ranging; the internal structure is " + trendWord(iv.trend) + "."
    else if d == iv.trend
        s := "Agrees with the " + name + " Market Trend."
    else
        s := "Opposes the " + name + " Market Trend: a " + trendWord(iv.trend) + " move inside the " + trendWord(d) + " trend (a pullback until the swing structure breaks)."
    s

internalTooltip(InternalView iv, TfView v, string name, int level) =>
    string t = "Internal structure (level " + str.tostring(level) + ": " + str.tostring(detectionCandles(level)) + "-candle swings)\nInternal trend: "
    t := t + (iv.trend == 0 ? "no internal level broken yet" : (iv.trend > 0 ? "Bullish" : "Bearish") + " since a " + trendWord(iv.trend) + " " + (iv.lastChoch ? "CHoCH" : "BOS") + " through " + priceText(iv.level))
    t + "\n" + internalAgreementText(iv, v, name)

// Strong/Weak High/Low of a timeframe: the swing protected by the latest break
// is Strong, the trailing extreme on the trend's side Weak.
strongWeakText(TfView v) =>
    string hi = na(v.trailHigh) ? "no swing high yet" : (v.dir < 0 ? "Strong High " : "Weak High ") + priceText(v.trailHigh)
    string lo = na(v.trailLow) ? "no swing low yet" : (v.dir > 0 ? "Strong Low " : "Weak Low ") + priceText(v.trailLow)
    hi + " | " + lo

breakdownText(TfView v) =>
    "Current Trend Classification: " + biasText(v) + "\nTrigger Condition Met: " + triggerText(v) + "\nStructural Evidence: " + evidenceText(v) + "\nStrong/Weak: " + strongWeakText(v) + "\nTrade Recommendations: " + recommendationText(v)

tfName(string tf) =>
    int secs = timeframe.in_seconds(tf)
    string s = ""
    if secs < 60
        s := str.tostring(secs) + "S"
    else if secs < 3600
        s := "M" + str.tostring(int(secs / 60))
    else if secs < 86400
        s := "H" + str.tostring(int(secs / 3600))
    else if secs < 604800
        s := "D" + str.tostring(int(secs / 86400))
    else if secs < 2419200
        s := "W" + str.tostring(int(secs / 604800))
    else
        s := "MN" + str.tostring(int(math.round(secs / 2592000)))
    s

// "H4", "H4 and H1" or "H4, H1 and M15": the selected trend timeframes.
trendTimeframesText() =>
    array<string> names = array.new<string>()
    if useHtf
        names.push(tfName(htfTf))
    if useMtf
        names.push(tfName(mtfTf))
    if useLtf
        names.push(tfName(ltfTf))
    string r = ""
    int count = names.size()
    if count > 0
        for i = 0 to count - 1
            r := r + (i == 0 ? "" : i == count - 1 ? " and " : ", ") + names.get(i)
    r

// Why a timeframe has no trend direction.
noTrendText(string name, TfView v) =>
    string s = name + " has no structure break yet."
    if v.dir != 0
        string why = v.cons % 2 == 1 ? "breaks in both directions over its last 5 swings" : ""
        if v.cons >= 2
            why := why + (why == "" ? "" : "; ") + "repeated CHoCHs in one area with no BOS"
        s := name + " is ranging (" + why + ")."
    s

transitionText(string name, TfView v) =>
    name + " is only in a " + trendWord(v.dir) + " transition (a CHoCH not yet confirmed by a BOS)."

// Timeframe names joined for a sentence: "H4", "H4 and M15".
joinNames(array<string> names) =>
    string r = ""
    int count = names.size()
    if count > 0
        for i = 0 to count - 1
            r := r + (i == 0 ? "" : i == count - 1 ? " and " : ", ") + names.get(i)
    r

// Market Tradability (2 Tradable, 1 Tradable (Early), 0 Not Tradable):
//  * Tradable: the HTF trend is established (latest break a BOS, not
//    Consolidation / Undefined); every selected timeframe has a direction and
//    they agree; a selected LTF is itself established.
//  * Tradable (Early), with Allow Tradable (Early): the same, except that the
//    HTF and/or a selected LTF is only a transition (a CHoCH not yet confirmed
//    by a BOS), the HTF agrees with every selected timeframe, and the internal
//    structure of the HTF and of every selected timeframe agrees with that
//    direction. Internal agreement made such transitions reach their BOS
//    markedly more often, but they still failed about a third of the time,
//    so it is shown apart from Tradable.
// The reason says why in one sentence, naming the timeframes.
evaluateTradability(TfView htf, TfView mtf, TfView ltf, InternalView hi, InternalView mi, InternalView li) =>
    bool htfDef = definiteBias(htf)
    bool ltfDef = definiteBias(ltf)
    int hd = biasDirection(htf)
    int md = biasDirection(mtf)
    int ld = biasDirection(ltf)
    bool available = (not useHtf or hd != 0) and (not useMtf or md != 0) and (not useLtf or ld != 0)
    bool agree = (not useHtf or not useMtf or hd == md) and (not useHtf or not useLtf or hd == ld) and (not useMtf or not useLtf or md == ld)
    bool ok = htfDef and available and agree and (not useLtf or ltfDef)
    int selected = (useHtf ? 1 : 0) + (useMtf ? 1 : 0) + (useLtf ? 1 : 0)
    // Tradable (Early): every direction agrees with the HTF and only the HTF
    // and/or the selected LTF is still a transition.
    bool earlyCandidate = allowEarly and hd != 0 and (not useMtf or md == hd) and (not useLtf or ld == hd)
    array<string> pending = array.new<string>()
    if not htfDef
        pending.push(tfName(htfTf))
    if useLtf and not ltfDef
        pending.push(tfName(ltfTf))
    array<string> disagree = array.new<string>()
    if hi.trend != hd
        disagree.push(tfName(htfTf))
    if useMtf and mi.trend != hd
        disagree.push(tfName(mtfTf))
    if useLtf and li.trend != hd
        disagree.push(tfName(ltfTf))
    int state = 0
    string reason = ""
    if ok
        state := 2
        int direction = useHtf ? hd : useMtf ? md : ld
        reason := trendTimeframesText() + (selected == 1 ? " is " : selected == 2 ? " are both " : " are all ") + trendWord(direction) + ", and the " + tfName(htfTf) + " trend is confirmed by a BOS"
        if useLtf
            reason := reason + ", as is the " + tfName(ltfTf) + " trend"
        reason := reason + "."
    else if earlyCandidate and pending.size() > 0 and disagree.size() == 0
        state := 1
        int named = selected + (useHtf ? 0 : 1)
        string names = useHtf ? trendTimeframesText() : tfName(htfTf) + (selected == 1 ? " and " : ", ") + trendTimeframesText()
        reason := names + (named == 1 ? " is " : named == 2 ? " are both " : " are all ") + trendWord(hd) + " and " + (named == 1 ? "its" : "their") + " internal structure agrees, but the " + joinNames(pending) + (pending.size() == 1 ? " trend is only a transition (a CHoCH" : " trends are only transitions (CHoCHs") + " not yet confirmed by a BOS)."
    else
        if hd == 0
            reason := noTrendText(tfName(htfTf), htf)
        else if not htfDef
            reason := transitionText(tfName(htfTf), htf)
        else if useMtf and md == 0
            reason := noTrendText(tfName(mtfTf), mtf)
        else if useLtf and ld == 0
            reason := noTrendText(tfName(ltfTf), ltf)
        else if not agree
            string first = useHtf ? tfName(htfTf) : tfName(mtfTf)
            int firstDir = useHtf ? hd : md
            bool mtfConflict = useHtf and useMtf and md != hd
            string other = mtfConflict ? tfName(mtfTf) : tfName(ltfTf)
            int otherDir = mtfConflict ? md : ld
            reason := first + " is " + trendWord(firstDir) + " but " + other + " is " + trendWord(otherDir) + "."
        else
            reason := transitionText(tfName(ltfTf), ltf)
        // A transition that would be Tradable (Early) but for the internal
        // structure says which timeframes do not agree yet.
        if earlyCandidate and pending.size() > 0 and disagree.size() > 0
            reason := str.substring(reason, 0, str.length(reason) - 1) + ", and the " + joinNames(disagree) + " internal structure is not " + trendWord(hd) + " yet."
    [state, reason]

// Tradable (Early): early entries in the trend's direction while the
// transition holds, and the BOS that would confirm it.
earlyRecommendationText(TfView htf) =>
    int d = biasDirection(htf)
    string action = d > 0 ? "buys" : "sells"
    string s = ""
    if definiteBias(htf)
        s := tfName(htfTf) + " is " + trendWord(d) + " and the internal structure agrees: early " + action + " are possible before " + tfName(ltfTf) + " confirms with a " + trendWord(d) + " BOS."
    else
        s := "Early " + action + " only"
        if d > 0 and not na(htf.hl)
            s := s + ", while price holds above HL " + priceText(htf.hl)
        if d < 0 and not na(htf.lh)
            s := s + ", while price holds below LH " + priceText(htf.lh)
        if d > 0 and not na(htf.hh)
            s := s + "; a close above HH " + priceText(htf.hh) + " (bullish BOS) confirms the trend"
        if d < 0 and not na(htf.ll)
            s := s + "; a close below LL " + priceText(htf.ll) + " (bearish BOS) confirms the trend"
        s := s + "."
    s

// The dashboard's recommendation: the HTF's, unless an established HTF trend
// is held back by a selected lower timeframe, which it then names, or the
// market is only Tradable (Early).
tradeRecommendation(TfView htf, TfView mtf, TfView ltf, int tradability) =>
    int d = biasDirection(htf)
    string s = recommendationText(htf)
    if tradability == 1
        s := earlyRecommendationText(htf)
    else if tradability == 0 and d != 0 and htf.lastBos
        string action = d > 0 ? "buying" : "selling"
        string lead = tfName(htfTf) + " is " + trendWord(d) + ", but wait for "
        if useMtf and biasDirection(mtf) != d
            s := lead + tfName(mtfTf) + " to turn " + trendWord(d) + " before " + action + "."
        else if useLtf and (biasDirection(ltf) != d or not definiteBias(ltf))
            s := lead + tfName(ltfTf) + " to confirm with a " + trendWord(d) + " BOS before " + action + "."
    s

// Healthy Extension blocks only an overextended market. In the HTF trend
// direction, the extension is how far the latest LTF close is beyond the
// latest MTF swing on the other side (the swing low in a bullish trend, the
// swing high in a bearish one), in MTF ATR (14 candles); more than
// MAX_EXTENSION_ATR (10) is overextended. With no trend direction or no MTF
// swing yet, or price back beyond that swing, the market is not overextended.
// On real data the 6% of Tradable candles beyond 10 MTF ATR were followed by
// a 1 ATR pullback before a 1 ATR move on 56% of the time (48% for the rest).
// Returns na when there is nothing to measure.
trendExtension(TfView htf, float ltfClose, float mtfAtr, float lastLow, bool haveLow, float lastHigh, bool haveHigh) =>
    float ext = na
    int d = biasDirection(htf)
    if d != 0 and not na(mtfAtr) and mtfAtr > 0 and not na(ltfClose)
        if d > 0 and haveLow
            ext := (ltfClose - lastLow) / mtfAtr
        else if d < 0 and haveHigh
            ext := (lastHigh - ltfClose) / mtfAtr
    ext

// "4.2 H1 ATR" for the dashboard.
extensionText(float extension) =>
    str.tostring(extension, "0.0") + " " + tfName(mtfTf) + " ATR"

passText(bool pass) =>
    pass ? "PASS" : "BLOCKED"

// Entry filters for the latest closed structure candle: the tooltip of the
// Market Tradability row. The HTF MA filter compares the latest closed HTF
// candle with the HTF MA, the MTF MA filter the latest closed MTF candle with
// the MTF MA. They never change structure, trend or alerts.
entryFilterTooltip() =>
    bool htfLong = true
    bool htfShort = true
    string htfText = "off"
    if useHtfMa
        htfLong := HTF_MA_FULL_BODY ? (hClose > hMa and hOpen > hMa and hClose > hOpen) : hClose > hMa
        htfShort := HTF_MA_FULL_BODY ? (hClose < hMa and hOpen < hMa and hClose < hOpen) : hClose < hMa
        htfText := htfLong ? "long" : htfShort ? "short" : "neutral"
    bool mtfLong = not useMtfMa
    bool mtfShort = not useMtfMa
    string mtfText = "off"
    if useMtfMa
        mtfText := "unavailable"
        if not na(mtfMaValue) and not na(mtfMaOpen) and not na(mtfMaClose)
            mtfLong := MTF_MA_FULL_BODY ? (mtfMaClose > mtfMaValue and mtfMaOpen > mtfMaValue and mtfMaClose > mtfMaOpen) : mtfMaClose > mtfMaValue
            mtfShort := MTF_MA_FULL_BODY ? (mtfMaClose < mtfMaValue and mtfMaOpen < mtfMaValue and mtfMaClose < mtfMaOpen) : mtfMaClose < mtfMaValue
            mtfText := mtfLong ? "long" : mtfShort ? "short" : "neutral"
    bool sess = nz(hSession) == 1
    bool adxPass = not useAdx or (not na(hAdx) and hAdx >= ADX_MINIMUM)
    bool atrPass = true
    if useAtr
        atrPass := not na(hAtr) and (ATR_MODE == "Minimum" ? hAtr >= ATR_MINIMUM : ATR_MODE == "Maximum" ? hAtr <= ATR_MAXIMUM : hAtr >= ATR_MINIMUM and hAtr <= ATR_MAXIMUM)
    bool longDir = htfLong and mtfLong and sess
    bool shortDir = htfShort and mtfShort and sess
    bool chochAdx = not useAdx or not ADX_BOS_AND_CHOCH or adxPass
    string out = "Entry filters, latest closed " + tfName(htfTf) + " candle"
    out := out + "\nBOS: long " + passText(longDir and adxPass and atrPass) + ", short " + passText(shortDir and adxPass and atrPass)
    out := out + "\nCHoCH: long " + passText(longDir and chochAdx and atrPass) + ", short " + passText(shortDir and chochAdx and atrPass)
    out := out + "\nHTF MA " + htfText + " | MTF MA " + mtfText + " | Session " + (useSession ? (sess ? "in" : "out") : "off")
    out := out + "\nADX " + (useAdx ? str.tostring(hAdx, "0.0") + " " + passText(adxPass) : "off") + " | ATR " + (useAtr ? str.tostring(hAtr, format.mintick) + " " + passText(atrPass) : "off")
    out

// Optimal Conditions: every enabled requirement must pass.
evaluateOptimal(bool biasReady, bool healthy, float extension, bool goodVolume, float volumeRatio, bool goodMomentum, float momentumRatio) =>
    bool optimal = (not useCorrOpt or biasReady) and (not useExtOpt or healthy) and (not useVolOpt or goodVolume) and (not useMomOpt or goodMomentum)
    string reason = ""
    if optimal
        reason := "All selected requirements are met"
    else
        if useCorrOpt and not biasReady
            reason := "the selected timeframes do not correlate (see Tradability Reason)"
        if useExtOpt and not healthy
            reason := reason + (reason == "" ? "" : "; ") + "price is overextended" + (na(extension) ? "" : " (" + extensionText(extension) + " beyond the latest " + tfName(mtfTf) + " swing)")
        if useVolOpt and not goodVolume
            reason := reason + (reason == "" ? "" : "; ") + (volumeRatio < VOLUME_MIN_RATIO ? "volume is too low" : "volume is too high")
        if useMomOpt and not goodMomentum
            reason := reason + (reason == "" ? "" : "; ") + (momentumRatio < MOMENTUM_MIN_RATIO ? "momentum is too low (price is sluggish)" : "momentum is too high (price would need to be chased)")
    [optimal, reason]

// ================================================================ 83% Strategy
// Trades the 83% retracement of a heavy LTF impulse in the direction of an
// established MTF trend, using Base's structure (above) for the swings and the
// market filters, and Fib Base's Fibonacci engine for the levels. Same rules as
// 83% Strategy.mq5:
//  * Bullish (buys only): Market Tradability reads Tradable (bullish) and the
//    Optimal Conditions read OPTIMAL; the MTF's most recent structure is a
//    bullish BOS (the break of an HH that makes a new HH); on the LTF chart
//    (M30, Swing Detection level 3 by default), within the last LTF
//    Independent Processed Bars (25) candles, A is the most recent HL with
//    heavy buying pressure and B the HH it formed. The Fibonacci runs from B
//    (0%) to A (100%) and the entry is a limit order at 83%.
//  * Invalid: price makes a new HH (trades above B) before touching 83%; the
//    HL is then used up. Bearish mirrors all of this.
//  * Heavy pressure: within Impulse Candles candles of A (A's candle
//    included), a candle closes at least Impulse Min ATR LTF ATR beyond A, the
//    14-candle ATR taken at A.
//  * A setup is known once B is a confirmed swing; if price reached the entry
//    level before that, it is missed rather than traded late.
//  * Risk: Risk % of the balance (initial capital plus net profit) at the
//    stop, cut after every run of consecutive losses in a day and restored the
//    next day; at most Max Trades a day, on the selected days, one position at
//    a time. Quantity = balance x risk / (stop distance x point value).
//  * Take profit TP Buffer ATR before B; the stop SL Buffer ATR behind A gives
//    the natural reward-to-risk, the closer of 1:2 and 1:3 is used and the
//    stop moved to match. The stop moves to the entry once a candle has
//    covered Breakeven % of the way to the take profit.
// Differences from the EA: orders are limit orders placed at a candle's close
// (the EA enters at the market on the first tick at the level); breakeven is
// checked at candle closes; Pine has no spread; days are in the exchange time
// zone; and a new MTF/HTF candle reaches the filters one LTF candle after it
// closes (Base's request.security reads the latest closed candle).

// Fib Base's fibLevelCalc: the price of a ratio along the leg, measured from
// the high (fromHigh) or from the low.
fibLevelCalc(float ratio, bool fromHigh, float hi, float lo) =>
    fromHigh ? hi - (hi - lo) * ratio : lo + (hi - lo) * ratio

fibLabelText(float ratio, float price) =>
    string pct = str.tostring(ratio * 100, "0.00") + "%"
    fibLabelInput == "Ratio" ? str.tostring(ratio) : fibLabelInput == "Price" ? str.tostring(price, format.mintick) : fibLabelInput == "Percent + Price" ? pct + " (" + str.tostring(price, format.mintick) + ")" : pct

S83_ARMED = 0
S83_TOUCHED = 1
S83_INVALID = 2
S83_EXPIRED = 3
S83_MISSED = 4
S83_REPLACED = 5
S83_WAITING = 6
S83_CONFIRMED = 7
S83_FAILED = 8

// One setup: A (the HL/LH the heavy move started from), B (the HH/LL it
// formed), the entry level between them, its state and its drawings.
type S83Setup
    int dir
    float aPrice
    int aTime
    int aBar
    float bPrice
    int bTime
    int bBar
    float level
    float impulse
    int createdBar
    int state = 0
    int endBar = na
    int endTime = na
    string note = ""
    bool traded = false
    float entry = na
    float sl = na
    float tp = na
    float rr = na
    int entryTime = na
    // Engulfing confirmation: the touch, then the engulfing candle.
    int touchBar = na
    int touchTime = na
    int confirmTime = na
    int confirmSecs = 0
    float confirmPrice = na
    array<line> lines
    array<label> levelLabels
    array<label> labels
    array<box> boxes

// The price of a ratio of a setup's leg: 0 at B, 1 at A.
s83Price(S83Setup s, float ratio) =>
    s.dir > 0 ? fibLevelCalc(ratio, true, s.bPrice, s.aPrice) : fibLevelCalc(ratio, false, s.aPrice, s.bPrice)

s83LevelText() =>
    str.tostring(entryLevel * 100, "0") + "%"

s83SetupText(S83Setup s) =>
    (s.dir > 0 ? "Buy: A HL " : "Sell: A LH ") + priceText(s.aPrice) + " -> B " + (s.dir > 0 ? "HH " : "LL ") + priceText(s.bPrice) + "; " + s83LevelText() + " at " + priceText(s.level)

alignDown(float p) =>
    math.floor(p / syminfo.mintick + 1e-8) * syminfo.mintick

alignUp(float p) =>
    math.ceil(p / syminfo.mintick - 1e-8) * syminfo.mintick

// Take profit, stop loss and reward-to-risk for an entry at `entry`, and
// whether that stop is behind A (an entry well past the entry level after a
// strong engulfing can leave a 1:2 / 1:3 stop in front of A).
s83Plan(S83Setup s, float entry, float atr) =>
    float tp = s.dir > 0 ? alignDown(s.bPrice - tpBufferAtr * atr) : alignUp(s.bPrice + tpBufferAtr * atr)
    float reward = s.dir > 0 ? tp - entry : entry - tp
    float atrStop = s.dir > 0 ? s.aPrice - slBufferAtr * atr : s.aPrice + slBufferAtr * atr
    float atrRisk = s.dir > 0 ? entry - atrStop : atrStop - entry
    bool ok = reward > 0 and atrRisk > 0 and atr > 0
    float rr = ok and reward / atrRisk < 0.5 * (rrLow + rrHigh) ? rrLow : rrHigh
    float sl = s.dir > 0 ? alignDown(entry - reward / rr) : alignUp(entry + reward / rr)
    bool behind = s.dir > 0 ? sl < s.aPrice : sl > s.aPrice
    [tp, sl, rr, ok, behind]

// Engulfing (body): the previous candle closed against the setup's direction,
// this one with it, closing beyond the previous open from an open at or
// beyond the previous close.
s83Engulf(int d, float pO, float pC, float cO, float cC) =>
    d > 0 ? pC < pO and cC > cO and cC > pO and cO <= pC : pC > pO and cC < cO and cC < pO and cO >= pC

s83Live(S83Setup s) =>
    s.state == S83_ARMED or s.state == S83_WAITING

s83TfText(int secs) =>
    secs % 3600 == 0 ? "H" + str.tostring(secs / 3600) : "M" + str.tostring(secs / 60)

// Heavy pressure: the furthest close beyond A within Impulse Candles candles
// of it, in LTF ATR at A.
s83Impulse(int aBar, int bBar, int dir, float aPrice) =>
    float atrA = chartAtr[bar_index - aBar]
    float best = 0.0
    int last = math.min(aBar + impulseCandles, bBar)
    for k = aBar to last
        float c = close[bar_index - k]
        best := math.max(best, dir > 0 ? c - aPrice : aPrice - c)
    nz(atrA) > 0 ? best / atrA : 0.0

s83TradingDay(int d) =>
    d == dayofweek.monday ? tradeMon : d == dayofweek.tuesday ? tradeTue : d == dayofweek.wednesday ? tradeWed : d == dayofweek.thursday ? tradeThu : d == dayofweek.friday ? tradeFri : d == dayofweek.saturday ? tradeSat : tradeSun

s83DayName(int d) =>
    d == dayofweek.monday ? "Monday" : d == dayofweek.tuesday ? "Tuesday" : d == dayofweek.wednesday ? "Wednesday" : d == dayofweek.thursday ? "Thursday" : d == dayofweek.friday ? "Friday" : d == dayofweek.saturday ? "Saturday" : "Sunday"

// Market Tradability's state alone (2 Tradable, 1 Tradable (Early), 0 Not
// Tradable), for every candle; evaluateTradability gives the same state with
// its reason for the dashboard.
tradabilityState(TfView htf, TfView mtf, TfView ltf, InternalView hi, InternalView mi, InternalView li) =>
    bool htfDef = definiteBias(htf)
    bool ltfDef = definiteBias(ltf)
    int hd = biasDirection(htf)
    int md = biasDirection(mtf)
    int ld = biasDirection(ltf)
    bool available = (not useHtf or hd != 0) and (not useMtf or md != 0) and (not useLtf or ld != 0)
    bool agree = (not useHtf or not useMtf or hd == md) and (not useHtf or not useLtf or hd == ld) and (not useMtf or not useLtf or md == ld)
    bool ok = htfDef and available and agree and (not useLtf or ltfDef)
    bool earlyCandidate = allowEarly and hd != 0 and (not useMtf or md == hd) and (not useLtf or ld == hd)
    bool pending = not htfDef or (useLtf and not ltfDef)
    bool disagree = hi.trend != hd or (useMtf and mi.trend != hd) or (useLtf and li.trend != hd)
    ok ? 2 : earlyCandidate and pending and not disagree ? 1 : 0

// ------------------------------------------------ Deriv synthetic indices
// Deriv's synthetic indices (Volatility, Crash / Boom, Jump, Step, Range Break,
// DEX, Drift Switch ...) are generated prices that tick at a fixed rate around
// the clock, so their volume measures nothing and is often missing on
// TradingView. Base's Market Volume requirement is not applied to them, nor to
// any symbol without volume data (it would block every trade). Auto
// recognises them by ticker, description or the DERIV prefix.
string s83SymText = str.upper(syminfo.ticker + " | " + syminfo.description + " | " + syminfo.prefix)
bool s83AutoSynthetic = syminfo.prefix == "DERIV" or str.contains(s83SymText, "VOLATILITY") or str.contains(s83SymText, "CRASH") or str.contains(s83SymText, "BOOM") or str.contains(s83SymText, "JUMP") or str.contains(s83SymText, "STEP") or str.contains(s83SymText, "RANGE BREAK") or str.contains(s83SymText, "DEX ") or str.contains(s83SymText, "DRIFT SWITCH") or str.contains(s83SymText, "HYBRID") or str.startswith(str.upper(syminfo.ticker), "R_") or str.startswith(str.upper(syminfo.ticker), "1HZ")
bool s83Synthetic = symbolProfile == "Deriv Synthetic Index" or (symbolProfile == "Auto" and s83AutoSynthetic)
bool s83NoVolume = ta.cum(nz(volume)) == 0
bool s83VolumeNA = s83Synthetic or s83NoVolume
string s83VolumeNote = s83Synthetic ? "synthetic index" : s83NoVolume ? "no volume data" : ""

// ------------------------------------------------- engulfing confirmation
// The lower-timeframe candles (M15) of each LTF candle, for the touch, the
// failures and the lower-timeframe engulfing in their own order. On a chart
// that is not above the lower timeframe the chart's own candles are used
// (the strategy only trades on the LTF chart anyway).
string s83LowerReq = timeframe.in_seconds(engulfLowerTf) < timeframe.in_seconds() ? engulfLowerTf : timeframe.period
int s83LowerSecs = timeframe.in_seconds(s83LowerReq)
[s83LwT, s83LwO, s83LwH, s83LwL, s83LwC] = request.security_lower_tf(syminfo.tickerid, s83LowerReq, [time, open, high, low, close])
var float s83PrevO = na
var float s83PrevC = na
s83ConfirmText() =>
    string lowerName = tfName(s83LowerReq)
    useLowerEngulf and useLtfEngulf and lowerName != tfName(ltfTf) ? lowerName + " or " + tfName(ltfTf) : useLowerEngulf ? lowerName : tfName(ltfTf)

// ------------------------------------------------- market filters per candle
// The latest closed LTF candle is the chart's own when the chart is the LTF.
bool s83OnLtf = timeframe.in_seconds() == timeframe.in_seconds(ltfTf)
float s83VolAvg = nz(ta.sma(volume, VOLUME_AVERAGE_LENGTH)[1])
float s83VolRatio = s83VolAvg > 0 ? nz(volume) / s83VolAvg : 0.0
float s83TrAvg = nz(ta.sma(ta.tr(true), MOMENTUM_AVERAGE_LENGTH)[1])
float s83MomRatio = s83TrAvg > 0 ? ta.tr(true) / s83TrAvg : 0.0
int s83Tradability = tradabilityState(htfView, mtfView, ltfView, htfInternal, mtfInternal, ltfInternal)
int s83MarketDir = useHtf ? biasDirection(htfView) : useMtf ? biasDirection(mtfView) : biasDirection(ltfView)
float s83Extension = trendExtension(htfView, close, mAtr, mLastLow, nz(mHaveLow) == 1, mLastHigh, nz(mHaveHigh) == 1)
bool s83Healthy = na(s83Extension) or s83Extension <= MAX_EXTENSION_ATR
bool s83GoodVolume = s83VolumeNA or (s83VolAvg > 0 and s83VolRatio >= VOLUME_MIN_RATIO and s83VolRatio <= VOLUME_MAX_RATIO)
bool s83GoodMomentum = s83TrAvg > 0 and s83MomRatio >= MOMENTUM_MIN_RATIO and s83MomRatio <= MOMENTUM_MAX_RATIO
bool s83Optimal = (not useCorrOpt or s83Tradability != 0) and (not useExtOpt or s83Healthy) and (not useVolOpt or s83GoodVolume) and (not useMomOpt or s83GoodMomentum)
string s83OptimalReason = useCorrOpt and s83Tradability == 0 ? "timeframes do not correlate" : useExtOpt and not s83Healthy ? "overextended" : useVolOpt and not s83GoodVolume ? (s83VolRatio < VOLUME_MIN_RATIO ? "volume too low" : "volume too high") : useMomOpt and not s83GoodMomentum ? (s83MomRatio < MOMENTUM_MIN_RATIO ? "momentum too low" : "momentum too high") : ""

// Why an armed setup in direction `dir` cannot be entered on the next candle,
// or "" when it can (market filters only).
s83FilterText(int dir) =>
    string r = ""
    if not definiteBias(mtfView) or biasDirection(mtfView) != dir
        r := "the latest " + tfName(mtfTf) + " structure is not a " + trendWord(dir) + " BOS (" + biasText(mtfView) + ")"
    else if not (s83Tradability == 2 or (allowEarlyEntries and s83Tradability == 1))
        r := "Market Tradability is not Tradable"
    else if s83MarketDir != dir
        r := "Market Tradability is " + trendWord(s83MarketDir)
    else if not s83Optimal
        r := "not Optimal (" + s83OptimalReason + ")"
    r

// ------------------------------------------------------- daily bookkeeping
// A day is the exchange's calendar day. A trade is a loss when it closed more
// than half its initial risk beyond its entry (a breakeven exit is not); a win
// or breakeven ends a run of losses, and every Losses Before Cut consecutive
// losses cut the risk once more until the day ends.
var int s83Day = na
var int s83TradesToday = 0
var int s83LossesInRow = 0
var int s83Cuts = 0
var int s83KnownTrades = 0
var int s83KnownClosed = 0
var array<float> s83TradeRisk = array.new<float>()
var float s83PlannedRiskBuy = na
var float s83PlannedRiskSell = na
var float s83PlannedSlBuy = na
var float s83PlannedTpBuy = na
var float s83PlannedRrBuy = na
var float s83PlannedSlSell = na
var float s83PlannedTpSell = na
var float s83PlannedRrSell = na
var string s83LastNote = ""
var bool s83Breakeven = false
// The setup of the order placed for each side, matched to its fill.
var S83Setup s83PendingBuy = na
var S83Setup s83PendingSell = na
// The entry filters behind the pending orders, for the dashboard.
var int s83FilterDir = 0
var string s83FilterNow = ""

s83RiskPct() =>
    riskPercent * math.pow(riskCutFactor, s83Cuts)

// ------------------------------------------------------------------ setups
var S83Setup s83Buy = na
var S83Setup s83Sell = na
var array<int> s83UsedBuy = array.new<int>()
var array<int> s83UsedSell = array.new<int>()
fibLineStyle83 = fibLineStyleInput == "Solid" ? line.style_solid : fibLineStyleInput == "Dashed" ? line.style_dashed : line.style_dotted

method s83AddLevel(S83Setup s, float ratio, color c, int rightTime) =>
    float p = s83Price(s, ratio)
    s.lines.push(line.new(s.aTime, p, rightTime, p, xloc = xloc.bar_time, color = c, style = fibLineStyle83, width = fibLineWidth))
    s.levelLabels.push(label.new(rightTime, p, fibLabelText(ratio, p), xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = c, size = labelSize))

// Fib Base's levels (B 0%, the optional ones, the entry level, A 100%) and
// A / B, drawn when the setup is armed.
method s83DrawNew(S83Setup s) =>
    s.lines := array.new<line>()
    s.levelLabels := array.new<label>()
    s.labels := array.new<label>()
    s.boxes := array.new<box>()
    int rightTime = time + fibRightOffset * chartSeconds * 1000
    if showFib83
        if fibShow1
            s.s83AddLevel(fibRatio1, fibColor1, rightTime)
        if fibShow2
            s.s83AddLevel(fibRatio2, fibColor2, rightTime)
        if fibShow3
            s.s83AddLevel(fibRatio3, fibColor3, rightTime)
        if fibShow4
            s.s83AddLevel(fibRatio4, fibColor4, rightTime)
        if fibShow5
            s.s83AddLevel(fibRatio5, fibColor5, rightTime)
        if fibShow6
            s.s83AddLevel(fibRatio6, fibColor6, rightTime)
        s.s83AddLevel(entryLevel, entryLevelColor, rightTime)
    if showSetupPoints
        color pc = s.dir > 0 ? bullSetupColor : bearSetupColor
        s.labels.push(label.new(s.aTime, s.aPrice, "A", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_up : label.style_label_down, textcolor = pc, size = size.normal))
        s.labels.push(label.new(s.bTime, s.bPrice, "B", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = pc, size = size.normal))

method s83Extend(S83Setup s, int rightTime) =>
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, rightTime)
        for lb in s.levelLabels
            label.set_x(lb, rightTime)

method s83Delete(S83Setup s) =>
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        for lb in s.levelLabels
            label.delete(lb)
        for lb in s.labels
            label.delete(lb)
        for bx in s.boxes
            box.delete(bx)

// The traded position, as in the strategy's examples: the target zone (entry
// to take profit) and stop zone (entry to stop loss) from the entry.
method s83DrawTrade(S83Setup s) =>
    if showPositionBoxes and not na(s.boxes)
        int boxEnd = s.entryTime + positionBoxCandles * chartSeconds * 1000
        s.boxes.push(box.new(s.entryTime, math.max(s.entry, s.tp), boxEnd, math.min(s.entry, s.tp), xloc = xloc.bar_time, bgcolor = targetZoneColor, border_width = 0))
        s.boxes.push(box.new(s.entryTime, math.max(s.entry, s.sl), boxEnd, math.min(s.entry, s.sl), xloc = xloc.bar_time, bgcolor = stopZoneColor, border_width = 0))
        s.labels.push(label.new(boxEnd, s.tp, "1:" + str.tostring(s.rr, "0") + "  TP " + priceText(s.tp) + "  SL " + priceText(s.sl), xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = chart.fg_color, size = labelSize))

// A finished setup: its levels end Fib Right Offset candles after the
// candle that ended it. A touched one (with confirmation: its touch and the
// engulfing) gets C, and its position once traded; a failed one is dotted
// with its reason.
method s83Finish(S83Setup s) =>
    s.s83Extend(s.endTime + fibRightOffset * chartSeconds * 1000)
    color pc = s.dir > 0 ? bullSetupColor : bearSetupColor
    if showSetupPoints and not na(s.touchTime) and (s.state != S83_FAILED or showFailedSetups)
        s.labels.push(label.new(s.touchTime, s.level, "touch", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_up : label.style_label_down, textcolor = pc, size = size.small))
    if s.state == S83_TOUCHED or s.state == S83_CONFIRMED
        float cPrice = s.state == S83_CONFIRMED ? s.confirmPrice : s.level
        if showSetupPoints
            s.labels.push(label.new(s.endTime, cPrice, "C", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_up : label.style_label_down, textcolor = pc, size = size.normal))
            if s.state == S83_CONFIRMED
                s.labels.push(label.new(s.endTime, cPrice, s83TfText(s.confirmSecs) + " engulfing", xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = s.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = pc, size = size.small))
        if s.traded
            s.s83DrawTrade()
        else if s.note != ""
            s.labels.push(label.new(s.endTime, cPrice, s.note, xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_right, textcolor = color.gray, size = labelSize))
    else if not showFailedSetups
        s.s83Delete()
    else
        for ln in s.lines
            line.set_style(ln, line.style_dotted)
        s.labels.push(label.new(s.endTime, s.level, s.note, xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_right, textcolor = color.gray, size = labelSize))

s83Ends(S83Setup s, int st, string why) =>
    s.state := st
    s.endBar := bar_index
    s.endTime := time
    if why != ""
        s.note := why
    s.s83Finish()

// Ends a setup without drawing yet (its candle time `t`).
s83End(S83Setup s, int st, int t, string why) =>
    s.state := st
    s.endBar := bar_index
    s.endTime := t
    s.note := why

// One candle of a live setup (see 83% Strategy.mq5's S83Step): the LTF candle
// itself, or with Engulfing Confirmation each lower-timeframe candle in turn.
//  * Armed: a touch of the entry level makes it touched (waiting for an
//    engulfing with confirmation); otherwise going beyond B invalidates it.
//  * Waiting: a close beyond A (the HL/LH broke) or going beyond B fails it;
//    otherwise a lower-timeframe engulfing in its direction, on the touching
//    candle or later, confirms it at that candle's close.
s83Step(S83Setup s, int cT, float cO, float cH, float cL, float cC, bool isLower) =>
    int d = s.dir
    if s.state == S83_ARMED
        if d > 0 ? cL <= s.level : cH >= s.level
            if engulfConfirm
                s.state := S83_WAITING
                s.touchBar := bar_index
                s.touchTime := cT
            else
                s.state := S83_TOUCHED
                s.endBar := bar_index
                s.endTime := time
        else if d > 0 ? cH > s.bPrice : cL < s.bPrice
            s83End(s, S83_INVALID, isLower ? cT : time, "invalidated: a new " + (d > 0 ? "HH" : "LL") + " first")
    if s.state == S83_WAITING
        if d > 0 ? cC < s.aPrice : cC > s.aPrice
            s83End(s, S83_FAILED, cT, "failed: a close through A before an engulfing")
        else if d > 0 ? cH > s.bPrice : cL < s.bPrice
            s83End(s, S83_FAILED, cT, "failed: a new " + (d > 0 ? "HH" : "LL") + " before an engulfing")
        else if isLower and useLowerEngulf and not na(s83PrevO) and s83Engulf(d, s83PrevO, s83PrevC, cO, cC)
            s83End(s, S83_CONFIRMED, cT, "")
            s.confirmTime := cT + s83LowerSecs * 1000
            s.confirmSecs := s83LowerSecs
            s.confirmPrice := cC
    s.state

// One closed LTF candle (see 83% Strategy.mq5's S83ScanSetups):
//  1. each live setup steps through the candle (with Engulfing Confirmation,
//     through each lower-timeframe candle inside it, in order; see s83Step).
//     Then a setup waiting for its engulfing is confirmed by an LTF
//     engulfing, or fails once the wait runs out; a live setup whose A left
//     the processed candles expires (armed) or fails (waiting);
//  2. each swing confirmed on the candle that is an HH (LL), not an EQH/EQL,
//     starts a setup with the swing before it on the other side when that is
//     an HL (LH) not used before, within the processed candles, with heavy
//     pressure. If the entry level was reached while B was being confirmed
//     the setup is missed; otherwise it is armed and replaces any armed
//     setup in its direction.
if barstate.isconfirmed and s83OnLtf
    // The day and the trades since the last candle.
    int today = year * 10000 + month * 100 + dayofmonth
    if na(s83Day) or today != s83Day
        s83Day := today
        s83TradesToday := 0
        s83LossesInRow := 0
        s83Cuts := 0
    int tradeCount = strategy.closedtrades + strategy.opentrades
    while s83KnownTrades < tradeCount
        int k = s83KnownTrades
        bool isLong = k < strategy.closedtrades ? strategy.closedtrades.size(k) > 0 : strategy.opentrades.size(k - strategy.closedtrades) > 0
        s83TradeRisk.push(isLong ? s83PlannedRiskBuy : s83PlannedRiskSell)
        s83TradesToday += 1
        S83Setup s = isLong ? s83PendingBuy : s83PendingSell
        if not na(s) and not s.traded and (s.state == S83_ARMED or s.state == S83_CONFIRMED)
            s.traded := true
            s.entry := k < strategy.closedtrades ? strategy.closedtrades.entry_price(k) : strategy.opentrades.entry_price(k - strategy.closedtrades)
            s.sl := isLong ? s83PlannedSlBuy : s83PlannedSlSell
            s.tp := isLong ? s83PlannedTpBuy : s83PlannedTpSell
            s.rr := isLong ? s83PlannedRrBuy : s83PlannedRrSell
            s.entryTime := time
            s83Breakeven := false
            s83LastNote := (isLong ? "buy at " : "sell at ") + priceText(s.entry) + ", SL " + priceText(s.sl) + ", TP " + priceText(s.tp) + " (1:" + str.tostring(s.rr, "0") + ")"
            // A confirmed setup was drawn when it was confirmed; its position now.
            if s.state == S83_CONFIRMED
                s.s83DrawTrade()
            if s83Alerts
                alert("83% Strategy " + syminfo.ticker + ": " + s83LastNote, alert.freq_once_per_bar_close)
        s83KnownTrades += 1
    while s83KnownClosed < strategy.closedtrades
        int k = s83KnownClosed
        float risk = k < s83TradeRisk.size() ? s83TradeRisk.get(k) : na
        float entryPx = strategy.closedtrades.entry_price(k)
        float exitPx = strategy.closedtrades.exit_price(k)
        bool isLong = strategy.closedtrades.size(k) > 0
        bool loss = na(risk) ? strategy.closedtrades.profit(k) < 0 : (isLong ? entryPx - exitPx : exitPx - entryPx) > 0.5 * risk
        if loss
            s83LossesInRow += 1
            if lossesBeforeCut > 0 and s83LossesInRow % lossesBeforeCut == 0
                s83Cuts += 1
        else
            s83LossesInRow := 0
        s83KnownClosed += 1

    // 1. Live setups through this candle: the candle itself, or with Engulfing
    //    Confirmation each of its lower-timeframe candles in turn. Then, at the
    //    LTF close, a waiting setup is confirmed by an LTF engulfing (on the
    //    touching candle or later) or fails when Confirmation Window LTF
    //    candles have closed since the touch; a live setup whose A left the
    //    processed candles expires.
    bool buyWasLive = not na(s83Buy) and s83Live(s83Buy)
    bool sellWasLive = not na(s83Sell) and s83Live(s83Sell)
    if engulfConfirm
        int nLower = s83LwT.size()
        if nLower > 0
            for j = 0 to nLower - 1
                int cT = s83LwT.get(j)
                float cO = s83LwO.get(j)
                float cH = s83LwH.get(j)
                float cL = s83LwL.get(j)
                float cC = s83LwC.get(j)
                if not na(s83Buy) and s83Live(s83Buy)
                    s83Step(s83Buy, cT, cO, cH, cL, cC, true)
                if not na(s83Sell) and s83Live(s83Sell)
                    s83Step(s83Sell, cT, cO, cH, cL, cC, true)
                s83PrevO := cO
                s83PrevC := cC
    else
        if not na(s83Buy) and s83Live(s83Buy)
            s83Step(s83Buy, time, open, high, low, close, false)
        if not na(s83Sell) and s83Live(s83Sell)
            s83Step(s83Sell, time, open, high, low, close, false)
    for side = 0 to 1
        S83Setup s = side == 0 ? s83Buy : s83Sell
        bool wasLive = side == 0 ? buyWasLive : sellWasLive
        if wasLive
            if s.state == S83_WAITING
                if useLtfEngulf and bar_index >= s.touchBar and s83Engulf(s.dir, open[1], close[1], open, close)
                    s83End(s, S83_CONFIRMED, time, "")
                    s.confirmTime := time + chartSeconds * 1000
                    s.confirmSecs := chartSeconds
                    s.confirmPrice := close
                else if bar_index - s.touchBar + 1 >= confirmWindow
                    s83End(s, S83_FAILED, time, "failed: no " + s83ConfirmText() + " engulfing within " + str.tostring(confirmWindow) + " " + tfName(ltfTf) + " candles")
            if s83Live(s) and s.aBar < bar_index - ltfBarsToProcess + 1
                s83End(s, s.state == S83_ARMED ? S83_EXPIRED : S83_FAILED, time, "expired: A left the processed candles")
            if not s83Live(s)
                if side == 0
                    s83UsedBuy.push(s.aTime)
                else
                    s83UsedSell.push(s.aTime)
                // A touched (limit) setup: traded on this candle, or why not.
                if s.state == S83_TOUCHED
                    s.note := s.traded ? "" : s83LevelText() + " touched; not traded: " + s.note
                    if not s.traded
                        s83LastNote := s.note
                // A confirmed setup is drawn once its entry is decided below.
                if s.state != S83_CONFIRMED
                    s.s83Finish()
    while s83UsedBuy.size() > 200
        s83UsedBuy.shift()
    while s83UsedSell.size() > 200
        s83UsedSell.shift()

    // 2. New HH / LL swings.
    int newCount = chartEngine.newPoints.size()
    if newCount > 0
        for i = 0 to newCount - 1
            SPoint q = chartEngine.newPoints.get(i)
            if q.kind > 0 and q.equalId < 0
                int dir = q.side
                // A: the swing before q on the other side.
                SPoint a = na
                int n = chartEngine.points.size()
                bool past = false
                for k = n - 1 to 0
                    SPoint p = chartEngine.points.get(k)
                    if past and p.side == -dir
                        a := p
                        break
                    if p.id == q.id
                        past := true
                bool used = not na(a) and (dir > 0 ? s83UsedBuy.includes(a.pivotTime) : s83UsedSell.includes(a.pivotTime))
                if not na(a) and a.kind < 0 and not used and a.pivotBar >= bar_index - ltfBarsToProcess + 1
                    float impulse = s83Impulse(a.pivotBar, q.pivotBar, dir, a.price)
                    if impulse >= impulseMinAtr
                        S83Setup s = S83Setup.new(dir, a.price, a.pivotTime, a.pivotBar, q.price, q.pivotTime, q.pivotBar, na, impulse, bar_index)
                        s.level := s83Price(s, entryLevel)
                        bool missed = false
                        for j = q.pivotBar + 1 to bar_index
                            if dir > 0 ? low[bar_index - j] <= s.level : high[bar_index - j] >= s.level
                                missed := true
                        s.s83DrawNew()
                        if missed
                            s83Ends(s, S83_MISSED, "missed: " + s83LevelText() + " reached before B was confirmed")
                            if dir > 0
                                s83UsedBuy.push(a.pivotTime)
                            else
                                s83UsedSell.push(a.pivotTime)
                        else
                            S83Setup old = dir > 0 ? s83Buy : s83Sell
                            if not na(old) and s83Live(old)
                                s83Ends(old, S83_REPLACED, "replaced by a newer setup")
                            if dir > 0
                                s83Buy := s
                            else
                                s83Sell := s
                            if s83Alerts
                                alert("83% Strategy " + syminfo.ticker + ": setup armed - " + s83SetupText(s), alert.freq_once_per_bar_close)

    // Breakeven: once a candle has covered Breakeven % of the way to the take
    // profit, the stop moves to the entry from the next candle.
    if strategy.position_size != 0 and breakevenPercent > 0 and not s83Breakeven
        bool isLong = strategy.position_size > 0
        S83Setup s = isLong ? s83PendingBuy : s83PendingSell
        // Not on the entry candle itself: its high (low) may have come before the fill.
        if not na(s) and s.traded and strategy.opentrades.entry_bar_index(0) < bar_index
            float progress = isLong ? high - s.entry : s.entry - low
            if progress >= breakevenPercent / 100 * math.abs(s.tp - s.entry)
                s83Breakeven := true
                strategy.exit(isLong ? "83% buy exit" : "83% sell exit", from_entry = isLong ? "83% buy" : "83% sell", stop = s.entry, limit = s.tp, comment_loss = "BE", comment_profit = "TP")

    s83FilterDir := not na(s83Buy) and s83Live(s83Buy) ? 1 : not na(s83Sell) and s83Live(s83Sell) ? -1 : biasDirection(mtfView)
    s83FilterNow := s83FilterDir == 0 ? "the " + tfName(mtfTf) + " has no trend" : s83FilterText(s83FilterDir)

    // Orders for the next candle.
    int nextDay = dayofweek(time_close)
    bool flat = strategy.position_size == 0
    int nextDayKey = year(time_close) * 10000 + month(time_close) * 100 + dayofmonth(time_close)
    int tradesNextDay = nextDayKey == s83Day ? s83TradesToday : 0
    // With Engulfing Confirmation: a market order at this candle's close for
    // each setup confirmed during it (the EA enters on the first tick after
    // the engulfing candle closes, which may be an M15 candle mid-way through
    // this one).
    if engulfConfirm
        for side = 0 to 1
            S83Setup s = side == 0 ? s83Buy : s83Sell
            string id = side == 0 ? "83% buy" : "83% sell"
            if not na(s) and s.state == S83_CONFIRMED and s.endBar == bar_index
                string event = s83TfText(s.confirmSecs) + " engulfing after the " + s83LevelText() + " touch"
                string why = not flat ? "a position is already open" : not s83TradingDay(nextDay) ? s83DayName(nextDay) + " is not a trading day" : tradesNextDay >= maxTradesPerDay ? "the maximum of " + str.tostring(maxTradesPerDay) + " trades today is reached" : s83FilterText(s.dir)
                [ptp, psl, prr, pok, pbehind] = s83Plan(s, close, chartAtr)
                float balance = strategy.initial_capital + strategy.netprofit
                float riskCash = balance * s83RiskPct() / 100
                float dist = math.abs(close - psl)
                float qty = pok and dist > 0 ? math.floor(riskCash / (dist * syminfo.pointvalue) / qtyStep) * qtyStep : 0.0
                if pok and minQty > 0 and qty < minQty
                    qty := minQtyRiskMultiple > 0 and minQty * dist * syminfo.pointvalue <= minQtyRiskMultiple * riskCash ? minQty : 0.0
                if why == ""
                    why := not pok ? "the take profit is not beyond the entry" : not pbehind ? "the price is too far from the " + s83LevelText() + " level: a 1:" + str.tostring(prr, "0") + " stop would not be behind " + (s.dir > 0 ? "the HL" : "the LH") : qty <= 0 ? (minQty > 0 ? "the position size is below the minimum quantity of " + str.tostring(minQty) : "the position size rounds to zero") : ""
                if why == ""
                    strategy.entry(id, side == 0 ? strategy.long : strategy.short, qty = qty, comment = id)
                    strategy.exit(id + " exit", from_entry = id, stop = psl, limit = ptp, comment_loss = "SL", comment_profit = "TP")
                    flat := false
                    if side == 0
                        s83PendingBuy := s
                        s83PlannedRiskBuy := dist
                        s83PlannedSlBuy := psl
                        s83PlannedTpBuy := ptp
                        s83PlannedRrBuy := prr
                    else
                        s83PendingSell := s
                        s83PlannedRiskSell := dist
                        s83PlannedSlSell := psl
                        s83PlannedTpSell := ptp
                        s83PlannedRrSell := prr
                else
                    s.note := event + "; not traded: " + why
                    s83LastNote := s.note
                s.s83Finish()
    // Without confirmation: a limit order at the entry level of each armed
    // setup whose filters pass, one-cancels-the-other between the two.
    if not engulfConfirm
        for side = 0 to 1
            S83Setup s = side == 0 ? s83Buy : s83Sell
            string id = side == 0 ? "83% buy" : "83% sell"
            bool live = not na(s) and s.state == S83_ARMED
            string why = ""
            if live
                if not flat
                    why := "a position is already open"
                else if not s83TradingDay(nextDay)
                    why := s83DayName(nextDay) + " is not a trading day"
                else if tradesNextDay >= maxTradesPerDay
                    why := "the maximum of " + str.tostring(maxTradesPerDay) + " trades today is reached"
                else
                    why := s83FilterText(s.dir)
            float tp = na
            float sl = na
            float rr = na
            float qty = na
            if live and why == ""
                [ptp, psl, prr, pok, pbehind] = s83Plan(s, s.level, chartAtr)
                float balance = strategy.initial_capital + strategy.netprofit
                float riskCash = balance * s83RiskPct() / 100
                float dist = math.abs(s.level - psl)
                qty := pok and dist > 0 ? math.floor(riskCash / (dist * syminfo.pointvalue) / qtyStep) * qtyStep : 0.0
                // Below the symbol's minimum quantity: no trade, or the minimum
                // when it risks at most Minimum Quantity Max Risk times the plan.
                if pok and minQty > 0 and qty < minQty
                    qty := minQtyRiskMultiple > 0 and minQty * dist * syminfo.pointvalue <= minQtyRiskMultiple * riskCash ? minQty : 0.0
                tp := ptp
                sl := psl
                rr := prr
                if not pok
                    why := "the take profit is not beyond the entry"
                else if qty <= 0
                    why := minQty > 0 ? "the position size is below the minimum quantity of " + str.tostring(minQty) : "the position size rounds to zero"
            if live and why == ""
                strategy.entry(id, side == 0 ? strategy.long : strategy.short, qty = qty, limit = s.level, oca_name = "83% entry", oca_type = strategy.oca.cancel, comment = id)
                strategy.exit(id + " exit", from_entry = id, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
                if side == 0
                    s83PendingBuy := s
                    s83PlannedRiskBuy := math.abs(s.level - sl)
                    s83PlannedSlBuy := sl
                    s83PlannedTpBuy := tp
                    s83PlannedRrBuy := rr
                else
                    s83PendingSell := s
                    s83PlannedRiskSell := math.abs(s.level - sl)
                    s83PlannedSlSell := sl
                    s83PlannedTpSell := tp
                    s83PlannedRrSell := rr
            else
                strategy.cancel(id)
                if live
                    s.note := why

// The latest armed setups: their levels reach Fib Right Offset candles past
// the latest candle, with the planned position from it.
var array<box> s83PlanBoxes = array.new<box>()
var array<label> s83PlanLabels = array.new<label>()
if barstate.islast and s83OnLtf
    for bx in s83PlanBoxes
        box.delete(bx)
    s83PlanBoxes.clear()
    for lb in s83PlanLabels
        label.delete(lb)
    s83PlanLabels.clear()
    int rightTime = time + fibRightOffset * chartSeconds * 1000
    for side = 0 to 1
        S83Setup s = side == 0 ? s83Buy : s83Sell
        if not na(s) and s83Live(s)
            s.s83Extend(rightTime)
            if showPositionBoxes and s.state == S83_ARMED
                [ptp, psl, prr, pok, pbehind] = s83Plan(s, s.level, chartAtr)
                if pok
                    int boxEnd = time + positionBoxCandles * chartSeconds * 1000
                    s83PlanBoxes.push(box.new(time, math.max(s.level, ptp), boxEnd, math.min(s.level, ptp), xloc = xloc.bar_time, bgcolor = color.new(targetZoneColor, 90), border_width = 0))
                    s83PlanBoxes.push(box.new(time, math.max(s.level, psl), boxEnd, math.min(s.level, psl), xloc = xloc.bar_time, bgcolor = color.new(stopZoneColor, 90), border_width = 0))
                    s83PlanLabels.push(label.new(boxEnd, ptp, "Planned 1:" + str.tostring(prr, "0") + "  TP " + priceText(ptp) + "  SL " + priceText(psl), xloc = xloc.bar_time, yloc = yloc.price, color = color(na), style = label.style_label_left, textcolor = chart.fg_color, size = labelSize))

// ---------------------------------------------------------------- dashboard
dashPosition = dashPositionInput == "Top Left" ? position.top_left : dashPositionInput == "Bottom Left" ? position.bottom_left : dashPositionInput == "Bottom Right" ? position.bottom_right : position.top_right
// Keep the dashboard legible against either chart theme.  An opaque panel and
// force_overlay ensure it remains visible on the main chart even if the
// strategy is moved to a separate pane. Component names are bold, and only
// the outputs are coloured:
// trends green (Bullish, Bullish Transition), red (Bearish, Bearish
// Transition) or grey (Consolidation / Undefined); tradability and conditions
// green when they pass and red when they do not; Tradable (Early) amber.
DASH_TEXT_COLOR = chart.fg_color
DASH_BACKGROUND_COLOR = color.new(chart.bg_color, 5)
DASH_POSITIVE_COLOR = color.green
DASH_NEGATIVE_COLOR = color.red
DASH_NEUTRAL_COLOR = color.gray
DASH_EARLY_COLOR = #FF8C00
var table dash = table.new(dashPosition, 2, 40, bgcolor = DASH_BACKGROUND_COLOR, frame_color = color.new(DASH_TEXT_COLOR, 35), frame_width = 1, border_color = color.new(DASH_TEXT_COLOR, 80), border_width = 1, force_overlay = true)

trendColor(TfView v) =>
    int d = biasDirection(v)
    d > 0 ? DASH_POSITIVE_COLOR : d < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

passColor(bool pass) =>
    pass ? DASH_POSITIVE_COLOR : DASH_NEGATIVE_COLOR

internalColor(InternalView iv) =>
    iv.trend > 0 ? DASH_POSITIVE_COLOR : iv.trend < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

// One row: the component name in bold, then its coloured output.
dashRow(int row, string component, string output, color outputColor, string tip) =>
    table.cell(dash, 0, row, component, text_color = DASH_TEXT_COLOR, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip, text_formatting = text.format_bold)
    table.cell(dash, 1, row, output, text_color = outputColor, text_halign = text.align_left, text_valign = text.align_top, text_size = size.small, tooltip = tip)

// Long outputs (the Tradability Reason and Trade Recommendations) wrap onto
// new lines of at most DASH_WRAP_CHARS characters, broken between words.
DASH_WRAP_CHARS = 48
wrapText(string s) =>
    array<string> words = str.split(s, " ")
    string out = ""
    string line = ""
    int n = words.size()
    if n > 0
        for i = 0 to n - 1
            string w = words.get(i)
            if w != ""
                if line != "" and str.length(line) + 1 + str.length(w) > DASH_WRAP_CHARS
                    out := out + (out == "" ? "" : "\n") + line
                    line := ""
                line := line + (line == "" ? "" : " ") + w
    out + (out == "" or line == "" ? "" : "\n") + line

if barstate.islast
    [tradability, tradeReason] = evaluateTradability(htfView, mtfView, ltfView, htfInternal, mtfInternal, ltfInternal)
    bool early = tradability == 1
    // The timeframes correlate whenever the market is Tradable or Tradable
    // (Early): in both, every selected timeframe agrees on the direction.
    bool correlated = tradability != 0
    float extension = trendExtension(htfView, lClose, mAtr, mLastLow, nz(mHaveLow) == 1, mLastHigh, nz(mHaveHigh) == 1)
    bool healthy = na(extension) or extension <= MAX_EXTENSION_ATR
    float volRatio = nz(lVolRatio)
    bool goodVolume = s83VolumeNA or (nz(lVolAvg) > 0 and volRatio >= VOLUME_MIN_RATIO and volRatio <= VOLUME_MAX_RATIO)
    float momRatio = nz(lMomRatio)
    bool goodMomentum = nz(lTrAvg) > 0 and momRatio >= MOMENTUM_MIN_RATIO and momRatio <= MOMENTUM_MAX_RATIO
    [optimal, optimalReason] = evaluateOptimal(correlated, healthy, extension, goodVolume, volRatio, goodMomentum, momRatio)
    table.clear(dash, 0, 0, 1, 39)
    int row = 0
    // Each Market Trend with its Internal Structure below it.
    if useHtf
        dashRow(row, "HTF Market Trend (" + tfName(htfTf) + "):", biasText(htfView), trendColor(htfView), breakdownText(htfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(htfInternal), internalColor(htfInternal), internalTooltip(htfInternal, htfView, tfName(htfTf), htfInternalLevel))
            row += 1
    if useMtf
        dashRow(row, "MTF Market Trend (" + tfName(mtfTf) + "):", biasText(mtfView), trendColor(mtfView), breakdownText(mtfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(mtfInternal), internalColor(mtfInternal), internalTooltip(mtfInternal, mtfView, tfName(mtfTf), mtfInternalLevel))
            row += 1
    if useLtf
        dashRow(row, "LTF Market Trend (" + tfName(ltfTf) + "):", biasText(ltfView), trendColor(ltfView), breakdownText(ltfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(ltfInternal), internalColor(ltfInternal), internalTooltip(ltfInternal, ltfView, tfName(ltfTf), ltfInternalLevel))
            row += 1
    dashRow(row, "Market Tradability:", tradability == 2 ? "Tradable" : early ? "Tradable (Early)" : "Not Tradable", early ? DASH_EARLY_COLOR : passColor(tradability == 2), entryFilterTooltip())
    row += 1
    dashRow(row, "Tradability Reason:", wrapText(tradeReason), DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, "Trade Recommendations:", wrapText(tradeRecommendation(htfView, mtfView, ltfView, tradability)), DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, " ", " ", DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, "Optimal Conditions:", optimal ? "OPTIMAL" : "NOT OPTIMAL", passColor(optimal), optimalReason)
    row += 1
    if useCorrOpt
        dashRow(row, "Timeframe Correlation:", passText(correlated), passColor(correlated), optimalReason)
        row += 1
    if useExtOpt
        dashRow(row, "Healthy Extension:", passText(healthy) + (na(extension) ? "" : " (" + extensionText(extension) + ")"), passColor(healthy), optimalReason)
        row += 1
    if useVolOpt
        dashRow(row, "Market Volume:", s83VolumeNA ? "PASS (not applied: " + s83VolumeNote + ")" : passText(goodVolume) + " (" + str.tostring(volRatio, "0.00") + "x average)", passColor(goodVolume), optimalReason)
        row += 1
    if useMomOpt
        dashRow(row, "Price Momentum:", passText(goodMomentum) + " (" + str.tostring(momRatio, "0.00") + "x average range)", passColor(goodMomentum), optimalReason)
        row += 1
    // 83% Strategy: its state, the armed setups, the entry filters behind the
    // pending orders, today's risk and the latest outcome.
    dashRow(row, " ", " ", DASH_TEXT_COLOR, "")
    row += 1
    bool buyArmed = not na(s83Buy) and s83Live(s83Buy)
    bool sellArmed = not na(s83Sell) and s83Live(s83Sell)
    string waitText = ": waiting for a " + s83ConfirmText() + " engulfing"
    string s83State = not s83OnLtf ? "Open a " + tfName(ltfTf) + " chart to trade" : strategy.position_size > 0 ? "Buy position open" : strategy.position_size < 0 ? "Sell position open" : buyArmed and sellArmed ? "Buy and sell setups live" : buyArmed ? (s83Buy.state == S83_WAITING ? "Buy setup touched" + waitText : "Buy setup armed") : sellArmed ? (s83Sell.state == S83_WAITING ? "Sell setup touched" + waitText : "Sell setup armed") : "Waiting for a setup"
    color s83Color = not s83OnLtf ? DASH_NEGATIVE_COLOR : strategy.position_size > 0 or (buyArmed and not sellArmed) ? DASH_POSITIVE_COLOR : strategy.position_size < 0 or (sellArmed and not buyArmed) ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR
    dashRow(row, "Symbol:", s83Synthetic ? "Deriv synthetic index" : "Standard symbol", DASH_TEXT_COLOR, s83Synthetic ? "Generated prices with a fixed tick rate: Market Volume is not applied." : "Set Symbol Profile to Deriv Synthetic Index if this is one.")
    row += 1
    dashRow(row, "83% Strategy (" + tfName(ltfTf) + "):", s83State, s83Color, "Buys (sells) at the " + s83LevelText() + " retracement of the latest " + tfName(ltfTf) + " HL-to-HH (LH-to-LL) leg with heavy pressure, within the last " + str.tostring(ltfBarsToProcess) + " " + tfName(ltfTf) + " candles" + (engulfConfirm ? ", once a " + s83ConfirmText() + " engulfing in the trade direction follows the touch." : "."))
    row += 1
    if buyArmed
        dashRow(row, "Setup:", wrapText(s83SetupText(s83Buy)), DASH_TEXT_COLOR, "Heavy pressure " + str.tostring(s83Buy.impulse, "0.0") + " " + tfName(ltfTf) + " ATR")
        row += 1
    if sellArmed
        dashRow(row, "Setup:", wrapText(s83SetupText(s83Sell)), DASH_TEXT_COLOR, "Heavy pressure " + str.tostring(s83Sell.impulse, "0.0") + " " + tfName(ltfTf) + " ATR")
        row += 1
    if s83OnLtf
        dashRow(row, "Entry Filters:", wrapText(s83FilterNow == "" ? "PASS (" + trendWord(s83FilterDir) + ")" : "BLOCKED: " + s83FilterNow), passColor(s83FilterNow == ""), "")
        row += 1
        string riskText = str.tostring(s83TradesToday) + "/" + str.tostring(maxTradesPerDay) + " trades, risk " + str.tostring(s83RiskPct(), "0.00") + "%" + (s83LossesInRow > 0 ? ", " + str.tostring(s83LossesInRow) + (s83LossesInRow == 1 ? " loss" : " losses") + " in a row" : "")
        dashRow(row, "Risk Today:", riskText, DASH_TEXT_COLOR, "Risk " + str.tostring(riskPercent, "0.00") + "% per trade, x" + str.tostring(riskCutFactor, "0.00") + " after every " + str.tostring(lossesBeforeCut) + " consecutive losses, reset each day.")
        row += 1
    if s83LastNote != ""
        dashRow(row, "Last Setup:", wrapText(s83LastNote), DASH_TEXT_COLOR, "")
        row += 1

// ------------------------------------------------------------------- alerts
// Structure-timeframe events that became known on its latest closed candle.
eventsText(int code) =>
    string s = ""
    array<int> digits = codeDigits(code)
    if digits.size() > 0
        for i = 0 to digits.size() - 1
            int d = digits.get(i)
            string one = d == 5 ? "LS (bullish CHoCH failed)" : d == 6 ? "LS (bearish CHoCH failed)" : (d == 1 or d == 2 ? "BOS " : "CHoCH ") + (d == 1 or d == 3 ? "bullish" : "bearish")
            s := s + (s == "" ? "" : " + ") + one
    s

int newCode = nz(hNew)
bool newStructure = nz(hEvents) != nz(hEvents[1]) and newCode > 0
string newCodeText = str.tostring(newCode)
bool newBullBos = newStructure and str.contains(newCodeText, "1")
bool newBearBos = newStructure and str.contains(newCodeText, "2")
bool newBullChoch = newStructure and str.contains(newCodeText, "3")
bool newBearChoch = newStructure and str.contains(newCodeText, "4")
bool newBullLs = newStructure and str.contains(newCodeText, "5")
bool newBearLs = newStructure and str.contains(newCodeText, "6")
if enableAlerts and newStructure
    alert(syminfo.ticker + " " + tfName(htfTf) + " " + eventsText(newCode), alert.freq_once_per_bar)
alertcondition(newBullBos, "Structure TF bullish BOS", "{{ticker}}: bullish BOS on the structure timeframe")
alertcondition(newBearBos, "Structure TF bearish BOS", "{{ticker}}: bearish BOS on the structure timeframe")
alertcondition(newBullChoch, "Structure TF bullish CHoCH", "{{ticker}}: bullish CHoCH on the structure timeframe")
alertcondition(newBearChoch, "Structure TF bearish CHoCH", "{{ticker}}: bearish CHoCH on the structure timeframe")
alertcondition(newBullLs, "Structure TF LS (bullish CHoCH failed)", "{{ticker}}: a bullish CHoCH failed (LS) on the structure timeframe")
alertcondition(newBearLs, "Structure TF LS (bearish CHoCH failed)", "{{ticker}}: a bearish CHoCH failed (LS) on the structure timeframe")
