//@version=6
// Base - Market Structure (TradingView port of Base.mq5 v2.39)
//
// Reads market structure from closed candles only:
//  * HH/HL/LH/LL swings: pivots of each timeframe's Swing Detection Length
//    candles on each side (Smart Money Engine swing detection; 10 by
//    default, lower is more sensitive).
//  * Only identified swings are broken: a swing is identified once the
//    opposite leg after it has begun, so it can no longer be replaced and
//    stays marked on the chart.
//  * BOS: the most recent identified HH (LL) is broken by a close, creating a
//    new HH (LL).
//  * CHoCH: while the trend is not already bullish, the most recent identified
//    LH is broken by a close and the next swing high is an HH (bearish mirrors
//    this).
//  * EQH/EQL: a swing within the EQH/EQL Threshold (ATR) of the previous
//    swing on its side is an equal high/low. It keeps that swing's role, its
//    break level is the pair's outer edge, and it neither confirms nor
//    cancels a CHoCH.
//  * LS (liquidity sweep): a CHoCH that reversed a trend fails when, before
//    anything else prints, a close breaks its protected swing and the old
//    trend carries on beyond its extreme. The CHoCH is relabelled LS (deep
//    yellow) and the trend before it is restored.
//  * BOS, CHoCH and LS lines end on the first candle whose wick or body
//    touches their level, so they never clip through a candle. Captions are
//    centred on the line: above a line broken upwards, below one broken
//    downwards.
//  * Trend: Bullish / Bearish after a BOS, Bullish / Bearish Transition after
//    a CHoCH, Consolidation / Undefined when the structure is sporadic or
//    trapped.
//  * Strong/Weak High/Low (Smart Money Engine): each break protects the
//    latest swing on the other side (Strong); the trend's trailing extreme is
//    Weak.
//  * Internal Structure (Smart Money Engine): minor BOS/CHoCH from shorter
//    pivots (Internal Structure Length, 5 by default), dashed and faded on
//    the chart and one dashboard row per timeframe.
//  * Dashboard: the Market Trend and Internal Structure of each selected
//    timeframe, Market Tradability and its reason, the trade recommendation
//    and Optimal Conditions. It is an analysis tool and never places orders.
indicator("Base - Market Structure", shorttitle = "Base", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ---------------------------------------------------------------- inputs
grpTf = "Timeframes"
htfTf = input.timeframe("240", "HTF", group = grpTf)
mtfTf = input.timeframe("60", "MTF", group = grpTf)
ltfTf = input.timeframe("15", "LTF", group = grpTf)

grpTrend = "Trend Analysis Timeframes"
useHtf = input.bool(true, "Use HTF", group = grpTrend)
useMtf = input.bool(true, "Use MTF", group = grpTrend)
useLtf = input.bool(false, "Use LTF", group = grpTrend)

grpProc = "Structure Bar Processing"
barsToProcess = input.int(100, "Bars To Process", minval = 100, maxval = 100000, group = grpProc)

grpSwing = "Swing Detection"
htfSwingLength = input.int(10, "HTF Swing Detection Length", minval = 2, maxval = 50, group = grpSwing)
mtfSwingLength = input.int(10, "MTF Swing Detection Length", minval = 2, maxval = 50, group = grpSwing)
ltfSwingLength = input.int(10, "LTF Swing Detection Length", minval = 2, maxval = 50, group = grpSwing)
showSwingPoints = input.bool(true, "Show Swing Points", group = grpSwing)
showStrongWeak = input.bool(true, "Show Strong/Weak High/Low", group = grpSwing)

grpInternal = "Internal Structure"
showInternal = input.bool(true, "Show Internal Structure", group = grpInternal)
showInternalOnDashboard = input.bool(true, "Show Internal Structure On Dashboard", group = grpInternal)
htfInternalLength = input.int(5, "HTF Internal Structure Length", minval = 2, maxval = 50, group = grpInternal)
mtfInternalLength = input.int(5, "MTF Internal Structure Length", minval = 2, maxval = 50, group = grpInternal)
ltfInternalLength = input.int(5, "LTF Internal Structure Length", minval = 2, maxval = 50, group = grpInternal)
internalBullColor = input.color(#089981, "Internal Bullish Color", group = grpInternal)
internalBearColor = input.color(#F23645, "Internal Bearish Color", group = grpInternal)

grpBos = "BOS Display"
showBos = input.bool(true, "Show BOS Labels", group = grpBos)
bullBosColor = input.color(color.blue, "Bullish BOS Color", group = grpBos)
bearBosColor = input.color(color.blue, "Bearish BOS Color", group = grpBos)

grpChoch = "CHoCH Display"
showChoch = input.bool(true, "Show CHoCH Labels", group = grpChoch)
bullChochColor = input.color(color.red, "Bullish CHoCH Color", group = grpChoch)
bearChochColor = input.color(color.red, "Bearish CHoCH Color", group = grpChoch)

grpLs = "LS Display"
showLs = input.bool(true, "Show LS Labels", group = grpLs)
bullLsColor = input.color(#E5B800, "Bullish LS Color (a failed bullish CHoCH)", group = grpLs)
bearLsColor = input.color(#E5B800, "Bearish LS Color (a failed bearish CHoCH)", group = grpLs)

grpLines = "Labels and Lines"
labelSizeInput = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpLines)
showLines = input.bool(true, "Show Structure Lines", group = grpLines)
lineStyleInput = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpLines)
lineWidth = input.int(2, "Line Width", minval = 1, maxval = 4, group = grpLines)

grpEqual = "EQH/EQL"
showEqual = input.bool(true, "Show EQH/EQL", group = grpEqual)
equalThreshold = input.float(0.1, "EQH/EQL Threshold (ATR, 0 = off)", minval = 0.0, maxval = 0.5, step = 0.05, group = grpEqual)

grpHtfMa = "MA Filter (HTF)"
useHtfMa = input.bool(true, "Use HTF MA Filter", group = grpHtfMa)
htfMaLength = input.int(50, "HTF MA Length", minval = 1, group = grpHtfMa)
htfMaType = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = grpHtfMa)
showHtfMaLine = input.bool(false, "Show HTF MA Line", group = grpHtfMa)
htfMaColor = input.color(color.blue, "HTF MA Color", group = grpHtfMa)

grpMtfMa = "MA Filter (MTF)"
useMtfMa = input.bool(true, "Use MTF MA Filter", group = grpMtfMa)
mtfMaLength = input.int(100, "MTF MA Length", minval = 1, group = grpMtfMa)
mtfMaType = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = grpMtfMa)
showMtfMaLine = input.bool(false, "Show MTF MA Line", group = grpMtfMa)
mtfMaColor = input.color(color.orange, "MTF MA Color", group = grpMtfMa)

grpSession = "Session Filter"
useSession = input.bool(false, "Use Session Filter", group = grpSession)
sessionPreset = input.string("New York", "Session Preset", options = ["New York", "London", "Tokyo", "Sydney", "Custom", "24x7"], group = grpSession)
customSession = input.string("0930-1600", "Custom Session (HHMM-HHMM)", group = grpSession)
customTimezone = input.string("UTC", "Custom Session Timezone (e.g. UTC, GMT+2, America/New_York)", group = grpSession)

grpAdx = "ADX Filter"
useAdx = input.bool(true, "Use ADX Filter", group = grpAdx)
adxLength = input.int(14, "ADX Length", minval = 1, group = grpAdx)

grpAtr = "ATR Filter"
useAtr = input.bool(true, "Use ATR Filter", group = grpAtr)
atrLength = input.int(14, "ATR Length", minval = 1, group = grpAtr)

grpOpt = "Optimal Conditions"
useCorrOpt = input.bool(true, "Use Timeframe Correlation For Optimal", group = grpOpt)
useExtOpt = input.bool(false, "Use Healthy Extension For Optimal", group = grpOpt)
useVolOpt = input.bool(true, "Use Market Volume For Optimal", group = grpOpt)
useMomOpt = input.bool(false, "Use Price Momentum For Optimal", group = grpOpt)

grpDash = "Dashboard and Alerts"
dashPositionInput = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = grpDash)
enableAlerts = input.bool(false, "Alert On Structure-Timeframe BOS / CHoCH / LS", group = grpDash)

// ------------------------------------------------------ internal tuning
// Kept out of the inputs, as in Base.mq5.
HTF_MA_FULL_BODY = false
MTF_MA_FULL_BODY = false
ADX_MINIMUM = 25.0
ADX_BOS_AND_CHOCH = false
ATR_MODE = "Minimum"
ATR_MINIMUM = 1.0
ATR_MAXIMUM = 10.0
MAX_EXTENSION_ATR = 3.0
VOLUME_AVERAGE_LENGTH = 20
VOLUME_MIN_RATIO = 0.50
VOLUME_MAX_RATIO = 2.00
MOMENTUM_AVERAGE_LENGTH = 20
MOMENTUM_MIN_RATIO = 0.50
MOMENTUM_MAX_RATIO = 2.00

// Swing detection (Smart Money Engine): a swing high is a pivot of the
// timeframe's Swing Detection Length candles on each side (see
// pivotHighFound), which is also how many candles it takes to confirm. A
// lower length finds more, faster swings; a higher length fewer, cleaner
// ones. The internal structure uses the same pivots with the shorter Internal
// Structure Length. The 14-candle ATR sizes the EQH/EQL threshold and the
// CHoCH trap area.
SWING_ATR_LENGTH = 14

// Consolidation / Undefined: the breaks since the oldest of the last
// SPORADIC_LABELS labels flip direction SPORADIC_FLIPS times, or two CHoCHs
// since the last confirming BOS lie within CHOCH_TRAP_AREA_ATR ATR.
SPORADIC_LABELS = 5
SPORADIC_FLIPS = 2
CHOCH_TRAP_AREA_ATR = 4.0

// Kept history: enough for the last five labels and the recent breaks.
MAX_POINTS = 80
MAX_EVENTS = 200
MAX_TRAP = 50

HIGH_LABEL_COLOR = #CD5C5C
LOW_LABEL_COLOR = #008080

if not useHtf and not useMtf and not useLtf
    runtime.error("Enable at least one trend analysis timeframe")
if not useCorrOpt and not useExtOpt and not useVolOpt and not useMomOpt
    runtime.error("Enable at least one Optimal Conditions requirement")

// ------------------------------------------------------ structure engine
// An equal high or low (EQH/EQL, see markEqual) keeps the role of the swing
// it equals, and its break level is the outer edge of the pair.
type SPoint
    int id
    int pivotBar
    int pivotTime
    float price
    int side
    int kind
    bool superseded = false
    int equalId = -1
    float equalPrice = na
    int equalTime = na
    int equalBar = -1
    float level = na
    int levelTime = na
    int levelBar = -1
    // The first candle after levelBar whose wick or body reached the level
    // (-1 until one does), tracked while the swing can still become a level.
    int levelTouchBar = -1
    int levelTouchTime = na

type SEvent
    int bar
    int breakBar
    int breakTime
    int dir
    bool bos
    int swingTime
    float level
    int seq = 0
    bool ls = false
    int lsBar = -1
    int swingBar = -1
    // Where its line ends: the first candle that touched the level.
    int endBar = -1
    int endTime = na

type SLevel
    bool active = false
    float price = na
    int swingTime = na
    int point = -1
    int swingBar = -1
    int touchBar = -1
    int touchTime = na

type SEngine
    array<SPoint> points
    array<SEvent> events
    array<SEvent> trapChochs
    array<SPoint> newPoints
    array<SPoint> dropped
    array<SEvent> newEvents
    SLevel hh
    SLevel lh
    SLevel ll
    SLevel hl
    SPoint highPt
    SPoint lowPt
    // The previous leg's swing on each side: the one a new swing is labelled
    // against, and the one it may equal (EQH/EQL).
    SPoint highRefPt
    SPoint lowRefPt
    int nextId = 0
    int lastSide = 0
    bool haveHighRef = false
    bool haveLowRef = false
    float highRef = 0.0
    float lowRef = 0.0
    int dir = 0
    bool lastBos = false
    bool haveHigh = false
    bool haveLow = false
    float lastHigh = 0.0
    float lastLow = 0.0
    int lastHighKind = 0
    int lastLowKind = 0
    int lastHighTime = na
    int lastLowTime = na
    int chochDir = 0
    int chochBreakBar = -1
    int chochBreakTime = na
    float chochLevel = na
    int chochLevelTime = na
    int chochLevelPoint = -1
    int chochLevelBar = -1
    int chochTouchBar = -1
    int chochTouchTime = na
    int eventTotal = 0
    int consolidation = 0
    int labelsFromIdx = -1
    int trapFromIdx = -1
    // LS watch on the latest CHoCH (see lsClose).
    SEvent lsEvent
    int lsSeq = -1
    int lsDir = 0
    float lsOrigin = na
    float lsExtreme = na
    int lsPriorDir = 0
    bool lsPriorBos = false
    bool lsTriggered = false
    bool lsBeyond = false
    int lsTotal = 0
    array<SEvent> newLs
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh = na
    int trailHighTime = na
    float trailLow = na
    int trailLowTime = na

newEngine() =>
    SEngine.new(points = array.new<SPoint>(), events = array.new<SEvent>(), trapChochs = array.new<SEvent>(), newPoints = array.new<SPoint>(), dropped = array.new<SPoint>(), newEvents = array.new<SEvent>(), hh = SLevel.new(), lh = SLevel.new(), ll = SLevel.new(), hl = SLevel.new(), newLs = array.new<SEvent>())

method setLevel(SLevel lv, SPoint p) =>
    lv.active := true
    lv.price := p.level
    lv.swingTime := p.levelTime
    lv.swingBar := p.levelBar
    lv.point := p.id
    lv.touchBar := p.levelTouchBar
    lv.touchTime := p.levelTouchTime

// A swing is identified once the opposite leg after it has begun: no later
// pivot can replace it, so it stays marked on the chart. Only then does it
// become the HH/LH (or LL/HL) whose close-through is a break.
method identifySwing(SEngine e, SPoint p) =>
    if not na(p)
        if p.side > 0
            if p.kind > 0
                e.hh.setLevel(p)
            else if p.kind < 0
                e.lh.setLevel(p)
        else
            if p.kind > 0
                e.ll.setLevel(p)
            else if p.kind < 0
                e.hl.setLevel(p)
    p

method highId(SEngine e) =>
    int id = -1
    if not na(e.highPt)
        id := e.highPt.id
    id

method lowId(SEngine e) =>
    int id = -1
    if not na(e.lowPt)
        id := e.lowPt.id
    id

method addPoint(SEngine e, int pivotBar, int pivotTime, float price, int side, int kind) =>
    e.nextId += 1
    SPoint p = SPoint.new(e.nextId, pivotBar, pivotTime, price, side, kind, level = price, levelTime = pivotTime, levelBar = pivotBar)
    e.points.push(p)
    if e.points.size() > MAX_POINTS
        e.points.shift()
    e.newPoints.push(p)
    p

// A BOS that follows an event in the same direction confirms that direction
// and ends any CHoCH trap; every other CHoCH joins the trap window.
// e.dir is the direction of the latest event that is not an LS.
// EQH / EQL: a swing within the EQH/EQL Threshold (ATR) of the previous swing
// on its side (the swing its HH/LH or LL/HL label is judged against) is an
// equal high or low. The two swings are one liquidity pool, so the new swing
// keeps the role of the swing it equals instead of being called higher or
// lower by a hair, and the pool's outer edge is the level a close must break.
// An untyped first swing has no role to pass on.
markEqual(SPoint p, SPoint ref, float tol) =>
    if not na(ref) and tol > 0
        if ref.kind != 0 and math.abs(p.price - ref.price) < tol
            p.kind := ref.kind
            p.equalId := ref.id
            p.equalPrice := ref.price
            p.equalTime := ref.pivotTime
            p.equalBar := ref.pivotBar
            if p.side > 0 ? ref.level > p.level : ref.level < p.level
                p.level := ref.level
                p.levelTime := ref.levelTime
                p.levelBar := ref.levelBar
                p.levelTouchBar := ref.levelTouchBar
                p.levelTouchTime := ref.levelTouchTime
    p

method addEvent(SEngine e, int bar, int breakBar, int breakTime, int dir, bool bos, int swingTime, float level, int swingBar, int endBar, int endTime) =>
    SEvent ev = SEvent.new(bar, breakBar, breakTime, dir, bos, swingTime, level, e.eventTotal, swingBar = swingBar, endBar = endBar, endTime = endTime)
    int prevDir = e.dir
    e.events.push(ev)
    if e.events.size() > MAX_EVENTS
        e.events.shift()
    if bos and prevDir == dir
        e.trapChochs.clear()
    else if not bos
        e.trapChochs.push(ev)
        if e.trapChochs.size() > MAX_TRAP
            e.trapChochs.shift()
    e.newEvents.push(ev)
    e.eventTotal += 1
    e.dir := dir
    e.lastBos := bos

method startChoch(SEngine e, int dir, int bar, int barTime, SLevel lv) =>
    e.chochDir := dir
    e.chochBreakBar := bar
    e.chochBreakTime := barTime
    e.chochLevel := lv.price
    e.chochLevelTime := lv.swingTime
    e.chochLevelPoint := lv.point
    e.chochLevelBar := lv.swingBar
    e.chochTouchBar := lv.touchBar
    e.chochTouchTime := lv.touchTime

// Drops a candidate. While the broken LH/HL is still the latest swing on its
// side it stays the most recent LH/HL, so a later close through it is a
// fresh break.
method cancelChoch(SEngine e) =>
    if e.chochDir > 0 and e.highId() == e.chochLevelPoint
        e.lh := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    if e.chochDir < 0 and e.lowId() == e.chochLevelPoint
        e.hl := SLevel.new(true, e.chochLevel, e.chochLevelTime, e.chochLevelPoint, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0

// The swings after the broken LH have made an HH (bullish), or after the
// broken HL an LL (bearish), and no LL (HH) has formed after it since. An
// equal high or low (EQH/EQL) is neither: it did not go beyond the swing it
// equals, so it neither confirms nor cancels a CHoCH.
method chochComplete(SEngine e) =>
    SPoint ext = na
    SPoint opp = na
    if e.chochDir > 0
        ext := e.highPt
        opp := e.lowPt
    else
        ext := e.lowPt
        opp := e.highPt
    bool done = false
    if not na(ext)
        if ext.id > e.chochLevelPoint and ext.kind > 0 and ext.equalId < 0
            if na(opp)
                done := true
            else
                done := opp.id < ext.id or opp.kind < 0 or opp.equalId >= 0
    done

// A CHoCH that reversed a trend is watched while it is the latest event: if
// the old trend carries on instead, it was a liquidity sweep (LS).
//  * Protected swing (origin): the swing the breaking move started from, the
//    last low before the HH of a bullish CHoCH (the last high before the LL
//    of a bearish one).
//  * Extreme: the old trend's most recent identified LL (bullish CHoCH) or
//    HH (bearish CHoCH).
//  * Trigger: a close through the protected swing.
//  * Confirmation: the old trend carries on beyond its extreme, by a close
//    (which is also the old trend's BOS) or by a swing, before anything else
//    prints. A BOS in the CHoCH's direction or an opposite CHoCH ends the
//    watch, and the CHoCH stands.
method confirmChoch(SEngine e, int bar) =>
    int priorDir = e.dir
    bool priorBos = e.lastBos
    int direction = e.chochDir
    e.addEvent(bar, e.chochBreakBar, e.chochBreakTime, direction, false, e.chochLevelTime, e.chochLevel, e.chochLevelBar, e.chochTouchBar, e.chochTouchTime)
    e.chochDir := 0
    e.lsSeq := -1
    SPoint origin = direction > 0 ? e.lowPt : e.highPt
    SLevel extreme = direction > 0 ? e.ll : e.hh
    if priorDir != 0 and not na(origin) and not na(extreme.swingTime)
        e.lsEvent := e.events.last()
        e.lsSeq := e.lsEvent.seq
        e.lsDir := direction
        e.lsOrigin := origin.price
        e.lsExtreme := extreme.price
        e.lsPriorDir := priorDir
        e.lsPriorBos := priorBos
        e.lsTriggered := false
        e.lsBeyond := false
    e.lsSeq

method lsWatching(SEngine e) =>
    e.lsSeq >= 0 and e.lsSeq == e.eventTotal - 1

// A swing on the old trend's side (side -1 low, 1 high) while watching:
// beyond the extreme it shows the old trend carrying on. True when that
// confirms the LS.
method lsSwing(SEngine e, int side, float price) =>
    bool confirm = false
    if e.lsWatching() and e.lsDir == -side
        if side < 0 ? price < e.lsExtreme : price > e.lsExtreme
            e.lsBeyond := true
        confirm := e.lsTriggered and e.lsBeyond
    confirm

// A close while watching. True when it confirms the LS.
method lsClose(SEngine e, float c) =>
    bool confirm = false
    if e.lsWatching()
        bool bullish = e.lsDir > 0
        if bullish ? c < e.lsOrigin : c > e.lsOrigin
            e.lsTriggered := true
        confirm := e.lsTriggered and (e.lsBeyond or (bullish ? c < e.lsExtreme : c > e.lsExtreme))
    confirm

// The CHoCH was a liquidity sweep: it is relabelled LS and the trend it
// changed is restored, as if it had never printed. It also leaves the CHoCH
// trap, and any CHoCH attempt still pending ends.
method confirmLs(SEngine e, int bar) =>
    SEvent ev = e.lsEvent
    ev.ls := true
    ev.lsBar := bar
    e.dir := e.lsPriorDir
    e.lastBos := e.lsPriorBos
    int t = e.trapChochs.size()
    if t > 0
        if e.trapChochs.get(t - 1).seq == ev.seq
            e.trapChochs.pop()
    e.newLs.push(ev)
    e.lsTotal += 1
    e.lsSeq := -1
    e.chochDir := 0

// A pivot high is accepted if it extends the current high leg or starts a new
// high leg. It is labelled HH/LH against the previous high leg.
method onPivotHigh(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == 1
    bool accepted = false
    if sameLeg
        if v > e.lastHigh
            e.lastHigh := v
            kind := e.haveHighRef ? (v > e.highRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveHighRef := e.haveHigh
        e.highRef := e.lastHigh
        kind := e.haveHigh ? (v > e.lastHigh ? 1 : -1) : 0
        e.haveHigh := true
        e.lastHigh := v
        e.lastSide := 1
        accepted := true
    if accepted
        // A higher pivot in the same leg replaces the leg's high; the first
        // high of a new leg ends the low leg, identifying its low.
        if sameLeg
            e.highPt.superseded := true
            e.dropped.push(e.highPt)
        else
            e.identifySwing(e.lowPt)
            e.highRefPt := e.highPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, 1, kind), e.highRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.highPt := p
        e.lastHighKind := kind
        e.lastHighTime := pivotTime
        // An HH beyond the old uptrend's extreme after a failed bearish CHoCH
        // confirms the LS; a pending CHoCH attempt ends with it.
        if e.lsSwing(1, v)
            e.confirmLs(curBar)
        // Only swings formed after the breaking close can cancel a CHoCH, and
        // an equal high never does.
        else if e.chochDir > 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir < 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

method onPivotLow(SEngine e, float v, int pivotBar, int pivotTime, float equalTol, int curBar) =>
    int kind = 0
    bool sameLeg = e.lastSide == -1
    bool accepted = false
    if sameLeg
        if v < e.lastLow
            e.lastLow := v
            kind := e.haveLowRef ? (v < e.lowRef ? 1 : -1) : 0
            accepted := true
    else
        e.haveLowRef := e.haveLow
        e.lowRef := e.lastLow
        kind := e.haveLow ? (v < e.lastLow ? 1 : -1) : 0
        e.haveLow := true
        e.lastLow := v
        e.lastSide := -1
        accepted := true
    if accepted
        if sameLeg
            e.lowPt.superseded := true
            e.dropped.push(e.lowPt)
        else
            e.identifySwing(e.highPt)
            e.lowRefPt := e.lowPt
        SPoint p = markEqual(e.addPoint(pivotBar, pivotTime, v, -1, kind), e.lowRefPt, equalTol)
        kind := p.kind
        bool equal = p.equalId >= 0
        e.lowPt := p
        e.lastLowKind := kind
        e.lastLowTime := pivotTime
        if e.lsSwing(-1, v)
            e.confirmLs(curBar)
        else if e.chochDir < 0 and kind < 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir > 0 and kind > 0 and pivotBar > e.chochBreakBar and not equal
            e.cancelChoch()
        else if e.chochDir != 0 and e.chochComplete()
            e.confirmChoch(curBar)
    accepted

// A structure line never clips through a candle: it ends on the first candle
// after its swing whose wick or body reaches the level (high at or above a
// swing high, low at or below a swing low). The candle that closes through
// the level always touches it, so a break's line ends there at the latest.
// The swings that can still become levels (the latest swing and the previous
// leg's swing on each side) and the four levels record their first touch as
// candles close; the candles between a pivot and its confirmation never
// reach it.
method touchLevel(SLevel lv, int side, float h, float l, int curBar, int curTime) =>
    if lv.active and lv.touchBar < 0 and (side > 0 ? h >= lv.price : l <= lv.price)
        lv.touchBar := curBar
        lv.touchTime := curTime
    lv.touchBar

touchPoint(SPoint p, float h, float l, int curBar, int curTime) =>
    if not na(p)
        if p.levelTouchBar < 0 and (p.side > 0 ? h >= p.level : l <= p.level)
            p.levelTouchBar := curBar
            p.levelTouchTime := curTime
    p

// Only a candle close through an identified swing is a break; a wick is a
// sweep.
//  * The most recent identified LH broken while the trend is not bullish
//    starts a bullish CHoCH (an LH broken with an HH is the CHoCH, not a BOS).
//  * The most recent identified HH broken is a bullish BOS. Bearish mirrors
//    both.
method onClose(SEngine e, float c, float h, float l, int curBar, int curTime) =>
    e.hh.touchLevel(1, h, l, curBar, curTime)
    e.lh.touchLevel(1, h, l, curBar, curTime)
    e.ll.touchLevel(-1, h, l, curBar, curTime)
    e.hl.touchLevel(-1, h, l, curBar, curTime)
    // LS first: the restored trend then decides the breaks below, so the
    // protected swing's break is a pullback and a close beyond the old extreme
    // is that trend's BOS.
    if e.lsClose(c)
        e.confirmLs(curBar)
    if e.lh.active and c > e.lh.price
        e.lh.active := false
        if e.dir <= 0 and e.chochDir <= 0
            e.cancelChoch()
            e.startChoch(1, curBar, curTime, e.lh)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.hh.active and c > e.hh.price
        e.hh.active := false
        if e.chochDir <= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, 1, true, e.hh.swingTime, e.hh.price, e.hh.swingBar, e.hh.touchBar, e.hh.touchTime)
    if e.hl.active and c < e.hl.price
        e.hl.active := false
        if e.dir >= 0 and e.chochDir >= 0
            e.cancelChoch()
            e.startChoch(-1, curBar, curTime, e.hl)
            if e.chochComplete()
                e.confirmChoch(curBar)
    if e.ll.active and c < e.ll.price
        e.ll.active := false
        if e.chochDir >= 0
            e.cancelChoch()
            e.addEvent(curBar, curBar, curTime, -1, true, e.ll.swingTime, e.ll.price, e.ll.swingBar, e.ll.touchBar, e.ll.touchTime)
    e.dir

// Strong/Weak High/Low after one candle (Smart Money Engine): a break on this
// candle (a new event, or an LS confirmed on it) protects the latest swing on
// the other side of the resulting trend, then the trailing extreme on the
// trend's side follows the candle. The protected swing is Strong, the
// trailing extreme Weak: Strong Low / Weak High in a bullish trend, Strong
// High / Weak Low in a bearish one.
method trailExtremes(SEngine e, float h, float l, int curTime) =>
    bool broke = e.newEvents.size() > 0 or e.newLs.size() > 0
    if broke and e.dir > 0 and not na(e.lowPt)
        e.trailLow := e.lowPt.price
        e.trailLowTime := e.lowPt.pivotTime
    if broke and e.dir < 0 and not na(e.highPt)
        e.trailHigh := e.highPt.price
        e.trailHighTime := e.highPt.pivotTime
    if e.dir > 0 and (na(e.trailHigh) or h > e.trailHigh)
        e.trailHigh := h
        e.trailHighTime := curTime
    if e.dir < 0 and (na(e.trailLow) or l < e.trailLow)
        e.trailLow := l
        e.trailLowTime := curTime
    e.dir

// One closed candle: the swing confirmed on it (its pivot is Swing Detection
// Length candles back), then the candle's close, then the trailing extremes
// and the touches of the swings that can still become levels.
method step(SEngine e, bool isPh, bool isPl, float phV, float plV, int pivotBar, int pivotTime, float equalTol, float c, float h, float l, int curBar, int curTime) =>
    e.newPoints.clear()
    e.dropped.clear()
    e.newEvents.clear()
    e.newLs.clear()
    if isPh
        e.onPivotHigh(phV, pivotBar, pivotTime, equalTol, curBar)
    if isPl
        e.onPivotLow(plV, pivotBar, pivotTime, equalTol, curBar)
    e.onClose(c, h, l, curBar, curTime)
    e.trailExtremes(h, l, curTime)
    touchPoint(e.highPt, h, l, curBar, curTime)
    touchPoint(e.lowPt, h, l, curBar, curTime)
    touchPoint(e.highRefPt, h, l, curBar, curTime)
    touchPoint(e.lowRefPt, h, l, curBar, curTime)

// Consolidation / Undefined, 1 = sporadic 5-label sequence, 2 = multiple
// CHoCHs without a BoS, 3 = both.
method classify(SEngine e, float atrNow) =>
    int cons = 0
    int labels = 0
    int firstIdx = -1
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labels += 1
                firstIdx := k
                if labels >= SPORADIC_LABELS
                    break
    e.labelsFromIdx := labels >= SPORADIC_LABELS ? firstIdx : -1
    if e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        int flips = 0
        int prevDir = 0
        int m = e.events.size()
        if m > 0
            for i = m - 1 to 0
                SEvent ev = e.events.get(i)
                if ev.breakBar < fromBar
                    break
                // An LS is not a break: it never flips the structure.
                if ev.ls
                    continue
                if prevDir != 0 and ev.dir != prevDir
                    flips += 1
                prevDir := ev.dir
        if flips >= SPORADIC_FLIPS
            cons := 1
    e.trapFromIdx := -1
    int t = e.trapChochs.size()
    if t >= 2
        SEvent latest = e.trapChochs.get(t - 1)
        for i = 0 to t - 2
            SEvent ev = e.trapChochs.get(i)
            if math.abs(ev.level - latest.level) <= CHOCH_TRAP_AREA_ATR * atrNow
                cons += 2
                e.trapFromIdx := i
                break
    e.consolidation := cons
    cons

labelDigit(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? 5 : 6) : p.side > 0 ? (p.kind > 0 ? 1 : 2) : (p.kind > 0 ? 3 : 4)

eventDigit(SEvent ev) =>
    ev.bos ? (ev.dir > 0 ? 1 : 2) : (ev.dir > 0 ? 3 : 4)

// Numeric evidence for the dashboard (strings are built on the chart):
// label digits 1 HH, 2 LH, 3 LL, 4 HL, 5 EQH, 6 EQL; break digits 1 bull
// BoS, 2 bear BoS, 3 bull CHoCH, 4 bear CHoCH.
method summary(SEngine e) =>
    int labelsCode = 0
    float rangeLo = na
    float rangeHi = na
    int n = e.points.size()
    if e.labelsFromIdx >= 0 and n > 0
        for k = e.labelsFromIdx to n - 1
            SPoint p = e.points.get(k)
            if not p.superseded and p.kind != 0
                labelsCode := labelsCode * 10 + labelDigit(p)
                rangeHi := na(rangeHi) ? p.price : math.max(rangeHi, p.price)
                rangeLo := na(rangeLo) ? p.price : math.min(rangeLo, p.price)
    int breaksCode = 0
    int breaksCount = 0
    int m = e.events.size()
    if e.consolidation % 2 == 1 and m > 0 and e.labelsFromIdx >= 0
        int fromBar = e.points.get(e.labelsFromIdx).pivotBar
        array<int> breaks = array.new<int>()
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if ev.breakBar < fromBar
                break
            if not ev.ls
                breaks.unshift(i)
        breaksCount := breaks.size()
        if breaksCount > 0
            for j = math.max(0, breaksCount - 9) to breaksCount - 1
                breaksCode := breaksCode * 10 + eventDigit(e.events.get(breaks.get(j)))
    int trapCode = 0
    int trapCount = 0
    float trap1 = na
    float trap2 = na
    float trap3 = na
    float trap4 = na
    int t = e.trapChochs.size()
    if e.consolidation >= 2 and e.trapFromIdx >= 0 and t > 0
        trapCount := t - e.trapFromIdx
        int slot = 0
        for i = math.max(e.trapFromIdx, t - 4) to t - 1
            SEvent ev = e.trapChochs.get(i)
            trapCode := trapCode * 10 + eventDigit(ev)
            if slot == 0
                trap1 := ev.level
            else if slot == 1
                trap2 := ev.level
            else if slot == 2
                trap3 := ev.level
            else
                trap4 := ev.level
            slot += 1
    int latestCode = 0
    float latestLevel = na
    if m > 0
        for i = m - 1 to 0
            SEvent ev = e.events.get(i)
            if not ev.ls
                latestCode := eventDigit(ev)
                latestLevel := ev.level
                break
    // New on this candle: an LS first (5 a failed bullish CHoCH, 6 a failed
    // bearish one), then the events.
    int newCode = 0
    int lsFresh = e.newLs.size()
    if lsFresh > 0
        for i = 0 to lsFresh - 1
            newCode := newCode * 10 + (e.newLs.get(i).dir > 0 ? 5 : 6)
    int fresh = e.newEvents.size()
    if fresh > 0
        for i = 0 to math.min(fresh, 3) - 1
            newCode := newCode * 10 + eventDigit(e.newEvents.get(i))
    float hhV = e.hh.active ? e.hh.price : na
    float lhV = e.lh.active ? e.lh.price : na
    float llV = e.ll.active ? e.ll.price : na
    float hlV = e.hl.active ? e.hl.price : na
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV]

// A swing high must be at least as high as the L candles on its left and
// strictly higher than the L candles on its right (a double top is one swing
// at its latest candle). Swing lows mirror this.
pivotHighFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = high[len]
        for j = len + 1 to 2 * len
            if high[j] > v
                ok := false
        for j = 0 to len - 1
            if high[j] >= v
                ok := false
    ok

pivotLowFound(int len) =>
    bool ok = bar_index >= 2 * len
    if ok
        float v = low[len]
        for j = len + 1 to 2 * len
            if low[j] < v
                ok := false
        for j = 0 to len - 1
            if low[j] <= v
                ok := false
    ok

// Average true range over SWING_ATR_LENGTH candles (fewer at the start).
swingAtrSeries() =>
    float tr = ta.tr(true)
    float avg = ta.sma(tr, SWING_ATR_LENGTH)
    float acc = ta.cum(tr)
    na(avg) ? acc / (bar_index + 1) : avg

// Structure of the timeframe this runs on (inside request.security), with
// pivots of `length` candles on each side.
structureRequest(int length) =>
    var SEngine e = newEngine()
    float atrS = swingAtrSeries()
    bool ph = pivotHighFound(length)
    bool pl = pivotLowFound(length)
    e.step(ph, pl, high[length], low[length], bar_index - length, time[length], equalThreshold * nz(atrS[length]), close, high, low, bar_index, time)
    e.classify(atrS)
    [labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV] = e.summary()
    // Flags cross request.security as 0/1 so a missing value is simply 0.
    [e.dir, e.lastBos ? 1 : 0, e.consolidation, labelsCode, rangeLo, rangeHi, breaksCode, breaksCount, trapCode, trapCount, trap1, trap2, trap3, trap4, latestCode, latestLevel, newCode, hhV, lhV, llV, hlV, e.eventTotal + e.lsTotal, e.lastHigh, e.lastHighKind, e.haveHigh ? 1 : 0, e.lastLow, e.lastLowKind, e.haveLow ? 1 : 0, e.trailHigh, e.trailLow]

// ----------------------------------------------- internal structure
// Internal Structure (Smart Money Engine): minor structure inside the swings,
// from pivots of the timeframe's Internal Structure Length candles (default
// 5, shorter than the Swing Detection Length). It gives more insight into the
// moves between swings without changing the Market Trend, Tradability,
// Optimal Conditions or alerts.
//  * Each internal pivot high (low) becomes the internal high (low) level.
//  * The first close above the internal high is an internal bullish BOS, or
//    an internal bullish CHoCH when the internal trend was bearish; bearish
//    mirrors this. Each level is broken once, and the break sets the
//    internal trend.
//  * On the chart its breaks are drawn as dashed width-1 lines with faded
//    captions, except where the internal pivot is also a swing of the main
//    structure, which draws that level itself.
// Only closed candles are used.
type SInternal
    int trend = 0
    bool lastChoch = false
    float breakLevel = na
    float highLevel = na
    int highBar = na
    int highTime = na
    bool highBroken = false
    float lowLevel = na
    int lowBar = na
    int lowTime = na
    bool lowBroken = false
    // The first candle after each pivot that touched its level (-1 until
    // one does): where a break's line ends.
    int highTouchBar = -1
    int highTouchTime = na
    int lowTouchBar = -1
    int lowTouchTime = na
    // Breaks made on this candle, and whether each was a CHoCH.
    bool bullBreak = false
    bool bullChoch = false
    bool bearBreak = false
    bool bearChoch = false

// One closed candle: the internal pivots confirmed on it, the touches of
// their levels, then its close.
method update(SInternal s, bool ph, bool pl, float phV, float plV, int pivotBar, int pivotTime, float c, float h, float l, int curBar, int curTime) =>
    s.bullBreak := false
    s.bearBreak := false
    if ph
        s.highLevel := phV
        s.highBar := pivotBar
        s.highTime := pivotTime
        s.highBroken := false
        s.highTouchBar := -1
    if pl
        s.lowLevel := plV
        s.lowBar := pivotBar
        s.lowTime := pivotTime
        s.lowBroken := false
        s.lowTouchBar := -1
    if not na(s.highLevel) and s.highTouchBar < 0 and h >= s.highLevel
        s.highTouchBar := curBar
        s.highTouchTime := curTime
    if not na(s.lowLevel) and s.lowTouchBar < 0 and l <= s.lowLevel
        s.lowTouchBar := curBar
        s.lowTouchTime := curTime
    if not na(s.highLevel) and not s.highBroken and c > s.highLevel
        s.highBroken := true
        s.lastChoch := s.trend < 0
        s.trend := 1
        s.breakLevel := s.highLevel
        s.bullBreak := true
        s.bullChoch := s.lastChoch
    if not na(s.lowLevel) and not s.lowBroken and c < s.lowLevel
        s.lowBroken := true
        s.lastChoch := s.trend > 0
        s.trend := -1
        s.breakLevel := s.lowLevel
        s.bearBreak := true
        s.bearChoch := s.lastChoch
    s

// The internal structure of the timeframe this runs on.
internalRequest(int length) =>
    var SInternal s = SInternal.new()
    s.update(pivotHighFound(length), pivotLowFound(length), high[length], low[length], bar_index - length, time[length], close, high, low, bar_index, time)
    [s.trend, s.lastChoch ? 1 : 0, s.breakLevel]

validSession(string s) =>
    bool ok = str.length(s) == 9 and str.match(s, "^[0-9]{4}-[0-9]{4}$") != ""
    if ok
        float sh = str.tonumber(str.substring(s, 0, 2))
        float sm = str.tonumber(str.substring(s, 2, 4))
        float eh = str.tonumber(str.substring(s, 5, 7))
        float em = str.tonumber(str.substring(s, 7, 9))
        ok := sh <= 23 and eh <= 23 and sm <= 59 and em <= 59
    ok

// Whether the current candle opens inside the session. Presets use named time
// zones, so daylight saving time is handled; the custom session uses Custom
// Session Timezone. Equal start and end means all day; 2200-0600 crosses
// midnight.
sessionOk() =>
    bool ok = true
    if useSession and sessionPreset != "24x7"
        string sess = customSession
        string tz = customTimezone
        if sessionPreset == "New York"
            sess := "0930-1600"
            tz := "America/New_York"
        else if sessionPreset == "London"
            sess := "0800-1700"
            tz := "Europe/London"
        else if sessionPreset == "Tokyo"
            sess := "0900-1500"
            tz := "Asia/Tokyo"
        else if sessionPreset == "Sydney"
            sess := "0800-1700"
            tz := "Australia/Sydney"
        if validSession(sess)
            int begin = int(str.tonumber(str.substring(sess, 0, 2))) * 60 + int(str.tonumber(str.substring(sess, 2, 4)))
            int finish = int(str.tonumber(str.substring(sess, 5, 7))) * 60 + int(str.tonumber(str.substring(sess, 7, 9)))
            int minuteOfDay = hour(time, tz) * 60 + minute(time, tz)
            ok := begin == finish ? true : begin < finish ? minuteOfDay >= begin and minuteOfDay < finish : minuteOfDay >= begin or minuteOfDay < finish
        else
            ok := false
    ok

// Each request returns the state after the last closed candle of its
// timeframe ([1] with lookahead on), so nothing repaints.
htfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(htfSwingLength)
    float maE = ta.ema(close, htfMaLength)
    float maS = ta.sma(close, htfMaLength)
    float maV = htfMaType == "EMA" ? maE : maS
    [diPlus, diMinus, adxV] = ta.dmi(adxLength, adxLength)
    float atrV = ta.sma(ta.tr(true), atrLength)
    int sess = sessionOk() ? 1 : 0
    [iT, iC, iL] = internalRequest(htfInternalLength)
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], nc[1], vhh[1], vlh[1], vll[1], vhl[1], et[1], close[1], open[1], maV[1], adxV[1], atrV[1], sess[1], th[1], tl[1], iT[1], iC[1], iL[1]]

mtfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(mtfSwingLength)
    [iT, iC, iL] = internalRequest(mtfInternalLength)
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], vhh[1], vlh[1], vll[1], vhl[1], th[1], tl[1], iT[1], iC[1], iL[1]]

ltfRequest() =>
    [d, b, cons, lc, rlo, rhi, bc, bn, tc, tn, t1, t2, t3, t4, lcd, llv, nc, vhh, vlh, vll, vhl, et, hp, hk, hv, lp, lk, lv, th, tl] = structureRequest(ltfSwingLength)
    float trL = ta.tr(true)
    float atrL = ta.sma(trL, atrLength)
    float volAvg = nz(ta.sma(volume, VOLUME_AVERAGE_LENGTH)[1])
    float volRatio = volAvg > 0 ? nz(volume) / volAvg : 0.0
    float trAvg = nz(ta.sma(trL, MOMENTUM_AVERAGE_LENGTH)[1])
    float momRatio = trAvg > 0 ? trL / trAvg : 0.0
    [iT, iC, iL] = internalRequest(ltfInternalLength)
    [d[1], b[1], cons[1], lc[1], rlo[1], rhi[1], bc[1], bn[1], tc[1], tn[1], t1[1], t2[1], t3[1], t4[1], lcd[1], llv[1], vhh[1], vlh[1], vll[1], vhl[1], hp[1], hk[1], hv[1], lp[1], lk[1], lv[1], close[1], atrL[1], volAvg[1], volRatio[1], trAvg[1], momRatio[1], th[1], tl[1], iT[1], iC[1], iL[1]]

mtfMaRequest() =>
    float e1 = ta.ema(close, mtfMaLength)
    float s1 = ta.sma(close, mtfMaLength)
    float m = mtfMaType == "EMA" ? e1 : s1
    [m[1], open[1], close[1]]

[hDir, hBos, hCons, hLabels, hRangeLo, hRangeHi, hBreaks, hBreaksN, hTrap, hTrapN, hT1, hT2, hT3, hT4, hLatest, hLatestLv, hNew, hHH, hLH, hLL, hHL, hEvents, hClose, hOpen, hMa, hAdx, hAtr, hSession, hTrailHigh, hTrailLow, hInTrend, hInChoch, hInLevel] = request.security(syminfo.tickerid, htfTf, htfRequest(), lookahead = barmerge.lookahead_on)
[mDir, mBos, mCons, mLabels, mRangeLo, mRangeHi, mBreaks, mBreaksN, mTrap, mTrapN, mT1, mT2, mT3, mT4, mLatest, mLatestLv, mHH, mLH, mLL, mHL, mTrailHigh, mTrailLow, mInTrend, mInChoch, mInLevel] = request.security(syminfo.tickerid, mtfTf, mtfRequest(), lookahead = barmerge.lookahead_on)
[lDir, lBos, lCons, lLabels, lRangeLo, lRangeHi, lBreaks, lBreaksN, lTrap, lTrapN, lT1, lT2, lT3, lT4, lLatest, lLatestLv, lHH, lLH, lLL, lHL, lLastHigh, lLastHighKind, lHaveHigh, lLastLow, lLastLowKind, lHaveLow, lClose, lAtr, lVolAvg, lVolRatio, lTrAvg, lMomRatio, lTrailHigh, lTrailLow, lInTrend, lInChoch, lInLevel] = request.security(syminfo.tickerid, ltfTf, ltfRequest(), lookahead = barmerge.lookahead_on)
[mtfMaValue, mtfMaOpen, mtfMaClose] = request.security(syminfo.tickerid, mtfTf, mtfMaRequest(), lookahead = barmerge.lookahead_on)

// ---------------------------------------------------- chart structure
// Labels and signals follow the chart timeframe, while the dashboard stays on
// the structure timeframe. Only confirmed candles are processed. The chart
// uses the Swing Detection and Internal Structure Lengths of the matching
// HTF, MTF or LTF inputs; any other chart timeframe uses the HTF lengths.
chartSeconds = timeframe.in_seconds()
chartTfIndex = chartSeconds == timeframe.in_seconds(htfTf) ? 0 : chartSeconds == timeframe.in_seconds(mtfTf) ? 1 : chartSeconds == timeframe.in_seconds(ltfTf) ? 2 : 0
chartLength = chartTfIndex == 1 ? mtfSwingLength : chartTfIndex == 2 ? ltfSwingLength : htfSwingLength
chartInternalLength = chartTfIndex == 1 ? mtfInternalLength : chartTfIndex == 2 ? ltfInternalLength : htfInternalLength
float chartAtr = swingAtrSeries()
bool chartPh = pivotHighFound(chartLength)
bool chartPl = pivotLowFound(chartLength)
bool chartInternalPh = pivotHighFound(chartInternalLength)
bool chartInternalPl = pivotLowFound(chartInternalLength)
var SEngine chartEngine = newEngine()
var SInternal chartInternal = SInternal.new()

labelSize = labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : labelSizeInput == "Large" ? size.large : size.small
lineStyle = lineStyleInput == "Solid" ? line.style_solid : lineStyleInput == "Dotted" ? line.style_dotted : line.style_dashed

// The drawn history covers Bars To Process structure candles.
htfSeconds = timeframe.in_seconds(htfTf)
displayBars = math.max(2 * math.max(htfSwingLength, mtfSwingLength, ltfSwingLength) + 2, int(math.ceil(float(barsToProcess) * htfSeconds / math.max(chartSeconds, 1))))
drawFrom = last_bar_index - displayBars
var int drawFromTime = na
if bar_index == math.max(drawFrom, 0)
    drawFromTime := time

swingName(SPoint p) =>
    showEqual and p.equalId >= 0 ? (p.side > 0 ? "EQH" : "EQL") : p.side > 0 ? (p.kind > 0 ? "HH" : "LH") : (p.kind > 0 ? "LL" : "HL")

// A BOS, CHoCH or LS caption, centred on its line (the candle midway between
// the broken swing and the first candle that touched its level, where the
// line ends): above a line broken upwards, below one broken downwards.
breakLabel(SEvent ev, string txt, color textColor) =>
    label.new(int(math.round(0.5 * (ev.swingBar + ev.endBar))), ev.level, txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = ev.dir > 0 ? label.style_label_down : label.style_label_up, textcolor = textColor, size = labelSize)

// Only the newest swing on each side can be superseded, so the chart keeps
// the label (and EQH/EQL line) of the newest high and low to delete when that
// happens. The drawing of the latest CHoCH, replaced if it becomes an LS.
var int lastChochSeq = -1
var label lastChochLabel = na
var line lastChochLine = na
var label highSwingLabel = na
var line highEqualLine = na
var int highSwingId = -1
var label lowSwingLabel = na
var line lowEqualLine = na
var int lowSwingId = -1

// Whether the main structure has a swing (side 1 high, -1 low) at a candle.
mainSwingAt(SEngine e, int side, int pivotTime) =>
    bool found = false
    int n = e.points.size()
    if n > 0
        for k = n - 1 to 0
            SPoint p = e.points.get(k)
            if p.side == side and p.pivotTime == pivotTime
                found := true
                break
    found

// The internal structure's BOS/CHoCH (Smart Money Engine): a dashed width-1
// line from the internal pivot to the first candle that touched its level
// (the candle that closed through it at the latest) and a faded caption
// centred on it, above a line broken upwards and below one broken downwards.
internalBreak(int dir, bool choch, float level, int swingTime, int swingBar, int endBar, int endTime) =>
    color clr = dir > 0 ? internalBullColor : internalBearColor
    line ln = line.new(swingTime, level, endTime, level, xloc = xloc.bar_time, color = clr, style = line.style_dashed, width = 1)
    label lbl = label.new(int(math.round(0.5 * (swingBar + endBar))), level, choch ? "CHoCH" : "BOS", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = dir > 0 ? label.style_label_down : label.style_label_up, textcolor = color.new(clr, 30), size = labelSize)
    [ln, lbl]

// An internal pivot that is also a swing of the main structure is left to
// the main structure, which draws that level. The main swing is confirmed
// Swing Detection Length candles after its pivot, so the internal breaks
// drawn meanwhile are kept (side and pivot time) to delete when it is.
var bool internalHighMain = false
var bool internalLowMain = false
var array<line> internalLines = array.new<line>()
var array<label> internalLabels = array.new<label>()
var array<int> internalSides = array.new<int>()
var array<int> internalSwingTimes = array.new<int>()
MAX_INTERNAL_KEPT = 120

if barstate.isconfirmed
    chartEngine.step(chartPh, chartPl, high[chartLength], low[chartLength], bar_index - chartLength, time[chartLength], equalThreshold * nz(chartAtr[chartLength]), close, high, low, bar_index, time)
    int droppedCount = chartEngine.dropped.size()
    if droppedCount > 0
        for i = 0 to droppedCount - 1
            SPoint gone = chartEngine.dropped.get(i)
            if gone.side > 0 and gone.id == highSwingId
                label.delete(highSwingLabel)
                line.delete(highEqualLine)
                highSwingId := -1
            if gone.side < 0 and gone.id == lowSwingId
                label.delete(lowSwingLabel)
                line.delete(lowEqualLine)
                lowSwingId := -1
    int pointCount = chartEngine.newPoints.size()
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if showSwingPoints and p.kind != 0 and p.pivotBar >= drawFrom
                color swingColor = p.side > 0 ? HIGH_LABEL_COLOR : LOW_LABEL_COLOR
                label lbl = label.new(p.pivotTime, p.price, swingName(p), xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = p.side > 0 ? label.style_label_down : label.style_label_up, textcolor = swingColor, size = labelSize)
                // An equal high or low is joined to the swing it equals.
                line eq = na
                if showEqual and p.equalId >= 0 and p.equalBar >= drawFrom
                    eq := line.new(p.equalTime, p.equalPrice, p.pivotTime, p.price, xloc = xloc.bar_time, color = swingColor, style = line.style_dotted, width = 1)
                if p.side > 0
                    highSwingLabel := lbl
                    highEqualLine := eq
                    highSwingId := p.id
                else
                    lowSwingLabel := lbl
                    lowEqualLine := eq
                    lowSwingId := p.id
    // Internal structure, after the main swings of this candle.
    if pointCount > 0
        for i = 0 to pointCount - 1
            SPoint p = chartEngine.newPoints.get(i)
            if p.side > 0 and p.pivotTime == chartInternal.highTime
                internalHighMain := true
            if p.side < 0 and p.pivotTime == chartInternal.lowTime
                internalLowMain := true
            int kept = internalSides.size()
            if kept > 0
                for k = kept - 1 to 0
                    if internalSides.get(k) == p.side and internalSwingTimes.get(k) == p.pivotTime
                        line.delete(internalLines.get(k))
                        label.delete(internalLabels.get(k))
                        internalLines.remove(k)
                        internalLabels.remove(k)
                        internalSides.remove(k)
                        internalSwingTimes.remove(k)
    chartInternal.update(chartInternalPh, chartInternalPl, high[chartInternalLength], low[chartInternalLength], bar_index - chartInternalLength, time[chartInternalLength], close, high, low, bar_index, time)
    if chartInternalPh
        internalHighMain := mainSwingAt(chartEngine, 1, chartInternal.highTime)
    if chartInternalPl
        internalLowMain := mainSwingAt(chartEngine, -1, chartInternal.lowTime)
    if showInternal and bar_index >= drawFrom
        if chartInternal.bullBreak and not internalHighMain
            [ln, lbl] = internalBreak(1, chartInternal.bullChoch, chartInternal.highLevel, chartInternal.highTime, chartInternal.highBar, chartInternal.highTouchBar, chartInternal.highTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(1)
            internalSwingTimes.push(chartInternal.highTime)
        if chartInternal.bearBreak and not internalLowMain
            [ln, lbl] = internalBreak(-1, chartInternal.bearChoch, chartInternal.lowLevel, chartInternal.lowTime, chartInternal.lowBar, chartInternal.lowTouchBar, chartInternal.lowTouchTime)
            internalLines.push(ln)
            internalLabels.push(lbl)
            internalSides.push(-1)
            internalSwingTimes.push(chartInternal.lowTime)
        while internalSides.size() > MAX_INTERNAL_KEPT
            internalLines.shift()
            internalLabels.shift()
            internalSides.shift()
            internalSwingTimes.shift()
    // An LS replaces the drawing of the CHoCH it reclassifies and keeps its
    // place, in its own colour. It is known before this candle's events.
    int lsCount = chartEngine.newLs.size()
    if lsCount > 0
        for i = 0 to lsCount - 1
            SEvent ev = chartEngine.newLs.get(i)
            if ev.seq == lastChochSeq
                label.delete(lastChochLabel)
                line.delete(lastChochLine)
                lastChochSeq := -1
            if showLs and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color lsColor = ev.dir > 0 ? bullLsColor : bearLsColor
                breakLabel(ev, "LS", lsColor)
                if showLines
                    line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = lsColor, style = lineStyle, width = lineWidth)
    int eventCount = chartEngine.newEvents.size()
    if eventCount > 0
        for i = 0 to eventCount - 1
            SEvent ev = chartEngine.newEvents.get(i)
            bool shown = ev.bos ? showBos : showChoch
            label lbl = na
            line ln = na
            // A break is drawn only with its broken swing, so every BOS, CHoCH
            // and LS starts from a marked swing.
            if shown and ev.breakBar >= drawFrom and ev.swingTime >= drawFromTime
                color textColor = ev.dir > 0 ? (ev.bos ? bullBosColor : bullChochColor) : (ev.bos ? bearBosColor : bearChochColor)
                lbl := breakLabel(ev, ev.bos ? "BOS" : "CHoCH", textColor)
                if showLines
                    ln := line.new(ev.swingTime, ev.level, ev.endTime, ev.level, xloc = xloc.bar_time, color = ev.bos ? color.blue : color.red, style = lineStyle, width = lineWidth)
            // Only the latest CHoCH can still become an LS.
            if not ev.bos
                lastChochSeq := ev.seq
                lastChochLabel := lbl
                lastChochLine := ln

var line lastHighLine = na
var line lastLowLine = na
var line strongWeakHighLine = na
var line strongWeakLowLine = na
var label strongWeakHighLabel = na
var label strongWeakLowLabel = na
if barstate.islast
    line.delete(lastHighLine)
    line.delete(lastLowLine)
    line.delete(strongWeakHighLine)
    line.delete(strongWeakLowLine)
    label.delete(strongWeakHighLabel)
    label.delete(strongWeakLowLabel)
    // Strong/Weak High/Low (Smart Money Engine): dashed lines from the
    // trailing high and low to 20 candles right of the latest candle, with
    // their names just right of the line ends.
    int rightTime = time + 20 * chartSeconds * 1000
    if showStrongWeak and not na(chartEngine.trailHigh)
        strongWeakHighLine := line.new(chartEngine.trailHighTime, chartEngine.trailHigh, rightTime, chartEngine.trailHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakHighLabel := label.new(rightTime, chartEngine.trailHigh, chartEngine.dir < 0 ? "Strong High" : "Weak High", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = HIGH_LABEL_COLOR, size = labelSize)
    if showStrongWeak and not na(chartEngine.trailLow)
        strongWeakLowLine := line.new(chartEngine.trailLowTime, chartEngine.trailLow, rightTime, chartEngine.trailLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dashed, width = 1)
        strongWeakLowLabel := label.new(rightTime, chartEngine.trailLow, chartEngine.dir > 0 ? "Strong Low" : "Weak Low", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = LOW_LABEL_COLOR, size = labelSize)
    if showSwingPoints and chartEngine.haveHigh
        lastHighLine := line.new(chartEngine.lastHighTime, chartEngine.lastHigh, time, chartEngine.lastHigh, xloc = xloc.bar_time, color = HIGH_LABEL_COLOR, style = line.style_dotted, width = 1)
    if showSwingPoints and chartEngine.haveLow
        lastLowLine := line.new(chartEngine.lastLowTime, chartEngine.lastLow, time, chartEngine.lastLow, xloc = xloc.bar_time, color = LOW_LABEL_COLOR, style = line.style_dotted, width = 1)

plot(useHtfMa and showHtfMaLine ? hMa : na, "HTF MA", color = htfMaColor, linewidth = 2)
plot(useMtfMa and showMtfMaLine ? mtfMaValue : na, "MTF MA", color = mtfMaColor, linewidth = 2)

// ------------------------------------------------------- trend breakdown
type TfView
    int dir
    bool lastBos
    int cons
    int labelsCode
    float rangeLo
    float rangeHi
    int breaksCode
    int breaksCount
    int trapCode
    int trapCount
    float trap1
    float trap2
    float trap3
    float trap4
    int latestCode
    float latestLevel
    float hh
    float lh
    float ll
    float hl
    // Strong/Weak High/Low (see trailExtremes).
    float trailHigh
    float trailLow

htfView = TfView.new(nz(hDir), nz(hBos) == 1, nz(hCons), nz(hLabels), hRangeLo, hRangeHi, nz(hBreaks), nz(hBreaksN), nz(hTrap), nz(hTrapN), hT1, hT2, hT3, hT4, nz(hLatest), hLatestLv, hHH, hLH, hLL, hHL, hTrailHigh, hTrailLow)
mtfView = TfView.new(nz(mDir), nz(mBos) == 1, nz(mCons), nz(mLabels), mRangeLo, mRangeHi, nz(mBreaks), nz(mBreaksN), nz(mTrap), nz(mTrapN), mT1, mT2, mT3, mT4, nz(mLatest), mLatestLv, mHH, mLH, mLL, mHL, mTrailHigh, mTrailLow)
ltfView = TfView.new(nz(lDir), nz(lBos) == 1, nz(lCons), nz(lLabels), lRangeLo, lRangeHi, nz(lBreaks), nz(lBreaksN), nz(lTrap), nz(lTrapN), lT1, lT2, lT3, lT4, nz(lLatest), lLatestLv, lHH, lLH, lLL, lHL, lTrailHigh, lTrailLow)

// The Internal Structure of a trend timeframe.
type InternalView
    int trend
    bool lastChoch
    float level

htfInternal = InternalView.new(nz(hInTrend), nz(hInChoch) == 1, hInLevel)
mtfInternal = InternalView.new(nz(mInTrend), nz(mInChoch) == 1, mInLevel)
ltfInternal = InternalView.new(nz(lInTrend), nz(lInChoch) == 1, lInLevel)

biasDirection(TfView v) =>
    v.cons != 0 ? 0 : v.dir

definiteBias(TfView v) =>
    biasDirection(v) != 0 and v.lastBos

biasText(TfView v) =>
    string s = "Consolidation / Undefined"
    int d = biasDirection(v)
    if d > 0
        s := v.lastBos ? "Bullish" : "Bullish Transition"
    else if d < 0
        s := v.lastBos ? "Bearish" : "Bearish Transition"
    s

triggerText(TfView v) =>
    string s = ""
    if v.dir == 0
        s := "No structure break yet"
    else
        if v.cons % 2 == 1
            s := "Sporadic 5-label sequence"
        if v.cons >= 2
            s := s + (s == "" ? "" : " + ") + "Multiple CHoCHs without BoS"
        if s == ""
            s := v.lastBos ? "Clear trending structure" : "Clear structure (CHoCH awaiting BoS)"
    s

priceText(float p) =>
    str.tostring(p, format.mintick)

labelName(int d) =>
    d == 1 ? "HH" : d == 2 ? "LH" : d == 3 ? "LL" : d == 4 ? "HL" : d == 5 ? "EQH" : "EQL"

breakName(int d) =>
    d == 1 ? "bull BoS" : d == 2 ? "bear BoS" : d == 3 ? "bull CHoCH" : "bear CHoCH"

// The digits of a code, oldest first.
codeDigits(int code) =>
    array<int> digits = array.new<int>()
    string raw = code > 0 ? str.tostring(code) : ""
    int len = str.length(raw)
    if len > 0
        for i = 0 to len - 1
            digits.push(int(str.tonumber(str.substring(raw, i, i + 1))))
    digits

evidenceText(TfView v) =>
    string labels = ""
    array<int> ld = codeDigits(v.labelsCode)
    if ld.size() > 0
        for i = 0 to ld.size() - 1
            labels := labels + (labels == "" ? "" : " ") + labelName(ld.get(i))
    string out = labels == "" ? "" : "Labels " + labels
    if v.cons % 2 == 1
        string breaks = v.breaksCount > 9 ? "..." : ""
        array<int> bd = codeDigits(v.breaksCode)
        if bd.size() > 0
            for i = 0 to bd.size() - 1
                breaks := breaks + (breaks == "" ? "" : ", ") + breakName(bd.get(i))
        out := out + "; breaks " + breaks
    if v.cons >= 2
        string chochs = v.trapCount > 4 ? "..." : ""
        array<int> td = codeDigits(v.trapCode)
        array<float> lv = array.from(v.trap1, v.trap2, v.trap3, v.trap4)
        if td.size() > 0
            for i = 0 to td.size() - 1
                chochs := chochs + (chochs == "" ? "" : ", ") + breakName(td.get(i)) + " " + priceText(lv.get(i))
        out := out + (out == "" ? "" : " | ") + chochs + "; no confirming BoS since"
    if v.cons == 0 and v.latestCode > 0
        out := out + (out == "" ? "" : "; ") + "latest " + breakName(v.latestCode) + " " + priceText(v.latestLevel)
    out == "" ? "No labels yet" : out

trendWord(int d) =>
    d > 0 ? "bullish" : "bearish"

// What to do on one timeframe's trend: one action and the level that decides
// it.
recommendationText(TfView v) =>
    int d = biasDirection(v)
    string s = ""
    if v.dir == 0
        s := "Stand aside until a BOS sets the trend."
    else if d == 0
        s := "Stand aside"
        if not na(v.rangeLo) and not na(v.rangeHi)
            s := s + " or trade only the range edges (" + priceText(v.rangeLo) + " to " + priceText(v.rangeHi) + ")"
        if not na(v.hh) and not na(v.ll)
            s := s + "; a close above HH " + priceText(v.hh) + " or below LL " + priceText(v.ll) + " starts a new trend."
        else
            s := s + " until a BOS starts a new trend."
    else if d > 0
        if not v.lastBos
            s := not na(v.hh) ? "Wait for a close above HH " + priceText(v.hh) + " (bullish BOS) before buying." : "Wait for a bullish BOS before buying."
        else
            s := not na(v.hl) ? "Look for buys on pullbacks while price holds above HL " + priceText(v.hl) + "." : "Look for buys on pullbacks."
    else
        if not v.lastBos
            s := not na(v.ll) ? "Wait for a close below LL " + priceText(v.ll) + " (bearish BOS) before selling." : "Wait for a bearish BOS before selling."
        else
            s := not na(v.lh) ? "Look for sells on pullbacks while price holds below LH " + priceText(v.lh) + "." : "Look for sells on pullbacks."
    s

// The internal structure's dashboard output: its trend and latest break.
internalTrendText(InternalView iv) =>
    iv.trend == 0 ? "Undefined" : (iv.trend > 0 ? "Bullish" : "Bearish") + (iv.lastChoch ? " (CHoCH)" : " (BOS)")

// How the internal structure relates to the timeframe's Market Trend.
internalAgreementText(InternalView iv, TfView v, string name) =>
    int d = biasDirection(v)
    string s = ""
    if iv.trend == 0
        s := "No internal break yet to compare with the " + name + " Market Trend."
    else if d == 0
        s := "The " + name + " Market Trend is ranging; the internal structure is " + trendWord(iv.trend) + "."
    else if d == iv.trend
        s := "Agrees with the " + name + " Market Trend."
    else
        s := "Opposes the " + name + " Market Trend: a " + trendWord(iv.trend) + " move inside the " + trendWord(d) + " trend (a pullback until the swing structure breaks)."
    s

internalTooltip(InternalView iv, TfView v, string name, int length) =>
    string t = "Internal structure (" + str.tostring(length) + "-candle swings)\nInternal trend: "
    t := t + (iv.trend == 0 ? "no internal level broken yet" : (iv.trend > 0 ? "Bullish" : "Bearish") + " since a " + trendWord(iv.trend) + " " + (iv.lastChoch ? "CHoCH" : "BOS") + " through " + priceText(iv.level))
    t + "\n" + internalAgreementText(iv, v, name)

// Strong/Weak High/Low of a timeframe: the swing protected by the latest break
// is Strong, the trailing extreme on the trend's side Weak.
strongWeakText(TfView v) =>
    string hi = na(v.trailHigh) ? "no swing high yet" : (v.dir < 0 ? "Strong High " : "Weak High ") + priceText(v.trailHigh)
    string lo = na(v.trailLow) ? "no swing low yet" : (v.dir > 0 ? "Strong Low " : "Weak Low ") + priceText(v.trailLow)
    hi + " | " + lo

breakdownText(TfView v) =>
    "Current Trend Classification: " + biasText(v) + "\nTrigger Condition Met: " + triggerText(v) + "\nStructural Evidence: " + evidenceText(v) + "\nStrong/Weak: " + strongWeakText(v) + "\nTrade Recommendations: " + recommendationText(v)

tfName(string tf) =>
    int secs = timeframe.in_seconds(tf)
    string s = ""
    if secs < 60
        s := str.tostring(secs) + "S"
    else if secs < 3600
        s := "M" + str.tostring(int(secs / 60))
    else if secs < 86400
        s := "H" + str.tostring(int(secs / 3600))
    else if secs < 604800
        s := "D" + str.tostring(int(secs / 86400))
    else if secs < 2419200
        s := "W" + str.tostring(int(secs / 604800))
    else
        s := "MN" + str.tostring(int(math.round(secs / 2592000)))
    s

// "H4", "H4 and H1" or "H4, H1 and M15": the selected trend timeframes.
trendTimeframesText() =>
    array<string> names = array.new<string>()
    if useHtf
        names.push(tfName(htfTf))
    if useMtf
        names.push(tfName(mtfTf))
    if useLtf
        names.push(tfName(ltfTf))
    string r = ""
    int count = names.size()
    if count > 0
        for i = 0 to count - 1
            r := r + (i == 0 ? "" : i == count - 1 ? " and " : ", ") + names.get(i)
    r

// Why a timeframe has no trend direction.
noTrendText(string name, TfView v) =>
    string s = name + " has no structure break yet."
    if v.dir != 0
        string why = v.cons % 2 == 1 ? "breaks in both directions over its last 5 swings" : ""
        if v.cons >= 2
            why := why + (why == "" ? "" : "; ") + "repeated CHoCHs in one area with no BOS"
        s := name + " is ranging (" + why + ")."
    s

transitionText(string name, TfView v) =>
    name + " is only in a " + trendWord(v.dir) + " transition (a CHoCH not yet confirmed by a BOS)."

// Market Tradability: the HTF trend must be established (latest break a BOS,
// not Consolidation / Undefined); every selected timeframe must have a
// direction and they must agree; a selected LTF must itself be established.
// The reason says why in one sentence, naming the timeframes.
evaluateTradability(TfView htf, TfView mtf, TfView ltf) =>
    bool htfDef = definiteBias(htf)
    bool ltfDef = definiteBias(ltf)
    int hd = biasDirection(htf)
    int md = biasDirection(mtf)
    int ld = biasDirection(ltf)
    bool available = (not useHtf or hd != 0) and (not useMtf or md != 0) and (not useLtf or ld != 0)
    bool agree = (not useHtf or not useMtf or hd == md) and (not useHtf or not useLtf or hd == ld) and (not useMtf or not useLtf or md == ld)
    bool ok = htfDef and available and agree and (not useLtf or ltfDef)
    string reason = ""
    if ok
        int selected = (useHtf ? 1 : 0) + (useMtf ? 1 : 0) + (useLtf ? 1 : 0)
        int direction = useHtf ? hd : useMtf ? md : ld
        reason := trendTimeframesText() + (selected == 1 ? " is " : selected == 2 ? " are both " : " are all ") + trendWord(direction) + ", and the " + tfName(htfTf) + " trend is confirmed by a BOS"
        if useLtf
            reason := reason + ", as is the " + tfName(ltfTf) + " trend"
        reason := reason + "."
    else if hd == 0
        reason := noTrendText(tfName(htfTf), htf)
    else if not htfDef
        reason := transitionText(tfName(htfTf), htf)
    else if useMtf and md == 0
        reason := noTrendText(tfName(mtfTf), mtf)
    else if useLtf and ld == 0
        reason := noTrendText(tfName(ltfTf), ltf)
    else if not agree
        string first = useHtf ? tfName(htfTf) : tfName(mtfTf)
        int firstDir = useHtf ? hd : md
        bool mtfConflict = useHtf and useMtf and md != hd
        string other = mtfConflict ? tfName(mtfTf) : tfName(ltfTf)
        int otherDir = mtfConflict ? md : ld
        reason := first + " is " + trendWord(firstDir) + " but " + other + " is " + trendWord(otherDir) + "."
    else
        reason := transitionText(tfName(ltfTf), ltf)
    [ok, reason]

// The dashboard's recommendation: the HTF's, unless an established HTF trend
// is held back by a selected lower timeframe, which it then names.
tradeRecommendation(TfView htf, TfView mtf, TfView ltf, bool tradable) =>
    int d = biasDirection(htf)
    string s = recommendationText(htf)
    if not tradable and d != 0 and htf.lastBos
        string action = d > 0 ? "buying" : "selling"
        string lead = tfName(htfTf) + " is " + trendWord(d) + ", but wait for "
        if useMtf and biasDirection(mtf) != d
            s := lead + tfName(mtfTf) + " to turn " + trendWord(d) + " before " + action + "."
        else if useLtf and (biasDirection(ltf) != d or not definiteBias(ltf))
            s := lead + tfName(ltfTf) + " to confirm with a " + trendWord(d) + " BOS before " + action + "."
    s

// Healthy Extension: in the HTF trend direction, from the latest LTF HL
// (bullish) or LH (bearish) to the latest LTF close, 0 to 3 LTF ATR.
healthyExtension(TfView htf, float ltfClose, float ltfAtr, float lastLow, int lastLowKind, bool haveLow, float lastHigh, int lastHighKind, bool haveHigh) =>
    bool ok = false
    if not na(ltfAtr) and ltfAtr > 0 and not na(ltfClose)
        float ext = -1.0
        int d = biasDirection(htf)
        if d > 0 and haveLow and lastLowKind < 0
            ext := (ltfClose - lastLow) / ltfAtr
        else if d < 0 and haveHigh and lastHighKind < 0
            ext := (lastHigh - ltfClose) / ltfAtr
        ok := ext >= 0.0 and ext <= MAX_EXTENSION_ATR
    ok

passText(bool pass) =>
    pass ? "PASS" : "BLOCKED"

// Entry filters for the latest closed structure candle: the tooltip of the
// Market Tradability row. The HTF MA filter compares the latest closed HTF
// candle with the HTF MA, the MTF MA filter the latest closed MTF candle with
// the MTF MA. They never change structure, trend or alerts.
entryFilterTooltip() =>
    bool htfLong = true
    bool htfShort = true
    string htfText = "off"
    if useHtfMa
        htfLong := HTF_MA_FULL_BODY ? (hClose > hMa and hOpen > hMa and hClose > hOpen) : hClose > hMa
        htfShort := HTF_MA_FULL_BODY ? (hClose < hMa and hOpen < hMa and hClose < hOpen) : hClose < hMa
        htfText := htfLong ? "long" : htfShort ? "short" : "neutral"
    bool mtfLong = not useMtfMa
    bool mtfShort = not useMtfMa
    string mtfText = "off"
    if useMtfMa
        mtfText := "unavailable"
        if not na(mtfMaValue) and not na(mtfMaOpen) and not na(mtfMaClose)
            mtfLong := MTF_MA_FULL_BODY ? (mtfMaClose > mtfMaValue and mtfMaOpen > mtfMaValue and mtfMaClose > mtfMaOpen) : mtfMaClose > mtfMaValue
            mtfShort := MTF_MA_FULL_BODY ? (mtfMaClose < mtfMaValue and mtfMaOpen < mtfMaValue and mtfMaClose < mtfMaOpen) : mtfMaClose < mtfMaValue
            mtfText := mtfLong ? "long" : mtfShort ? "short" : "neutral"
    bool sess = nz(hSession) == 1
    bool adxPass = not useAdx or (not na(hAdx) and hAdx >= ADX_MINIMUM)
    bool atrPass = true
    if useAtr
        atrPass := not na(hAtr) and (ATR_MODE == "Minimum" ? hAtr >= ATR_MINIMUM : ATR_MODE == "Maximum" ? hAtr <= ATR_MAXIMUM : hAtr >= ATR_MINIMUM and hAtr <= ATR_MAXIMUM)
    bool longDir = htfLong and mtfLong and sess
    bool shortDir = htfShort and mtfShort and sess
    bool chochAdx = not useAdx or not ADX_BOS_AND_CHOCH or adxPass
    string out = "Entry filters, latest closed " + tfName(htfTf) + " candle"
    out := out + "\nBOS: long " + passText(longDir and adxPass and atrPass) + ", short " + passText(shortDir and adxPass and atrPass)
    out := out + "\nCHoCH: long " + passText(longDir and chochAdx and atrPass) + ", short " + passText(shortDir and chochAdx and atrPass)
    out := out + "\nHTF MA " + htfText + " | MTF MA " + mtfText + " | Session " + (useSession ? (sess ? "in" : "out") : "off")
    out := out + "\nADX " + (useAdx ? str.tostring(hAdx, "#.0") + " " + passText(adxPass) : "off") + " | ATR " + (useAtr ? str.tostring(hAtr, format.mintick) + " " + passText(atrPass) : "off")
    out

// Optimal Conditions: every enabled requirement must pass.
evaluateOptimal(bool biasReady, bool healthy, bool goodVolume, float volumeRatio, bool goodMomentum, float momentumRatio) =>
    bool optimal = (not useCorrOpt or biasReady) and (not useExtOpt or healthy) and (not useVolOpt or goodVolume) and (not useMomOpt or goodMomentum)
    string reason = ""
    if optimal
        reason := "All selected requirements are met"
    else
        if useCorrOpt and not biasReady
            reason := "the selected timeframes do not correlate (see Tradability Reason)"
        if useExtOpt and not healthy
            reason := reason + (reason == "" ? "" : "; ") + "price is overextended or lacks a valid corrective anchor"
        if useVolOpt and not goodVolume
            reason := reason + (reason == "" ? "" : "; ") + (volumeRatio < VOLUME_MIN_RATIO ? "volume is too low" : "volume is too high")
        if useMomOpt and not goodMomentum
            reason := reason + (reason == "" ? "" : "; ") + (momentumRatio < MOMENTUM_MIN_RATIO ? "momentum is too low (price is sluggish)" : "momentum is too high (price would need to be chased)")
    [optimal, reason]

// ---------------------------------------------------------------- dashboard
dashPosition = dashPositionInput == "Top Left" ? position.top_left : dashPositionInput == "Bottom Left" ? position.bottom_left : dashPositionInput == "Bottom Right" ? position.bottom_right : position.top_right
// Component names are black and bold, and only the outputs are coloured:
// trends green (Bullish, Bullish Transition), red (Bearish, Bearish
// Transition) or grey (Consolidation / Undefined); tradability and conditions
// green when they pass and red when they do not. No background and no
// borders.
DASH_TEXT_COLOR = color.black
DASH_POSITIVE_COLOR = color.green
DASH_NEGATIVE_COLOR = color.red
DASH_NEUTRAL_COLOR = color.gray
var table dash = table.new(dashPosition, 2, 24, bgcolor = color.new(color.white, 100), frame_width = 0, border_width = 0)

trendColor(TfView v) =>
    int d = biasDirection(v)
    d > 0 ? DASH_POSITIVE_COLOR : d < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

passColor(bool pass) =>
    pass ? DASH_POSITIVE_COLOR : DASH_NEGATIVE_COLOR

internalColor(InternalView iv) =>
    iv.trend > 0 ? DASH_POSITIVE_COLOR : iv.trend < 0 ? DASH_NEGATIVE_COLOR : DASH_NEUTRAL_COLOR

// One row: the component name in bold, then its coloured output.
dashRow(int row, string component, string output, color outputColor, string tip) =>
    table.cell(dash, 0, row, component, text_color = DASH_TEXT_COLOR, text_halign = text.align_left, text_size = size.small, tooltip = tip, text_formatting = text.format_bold)
    table.cell(dash, 1, row, output, text_color = outputColor, text_halign = text.align_left, text_size = size.small, tooltip = tip)

if barstate.islast
    [tradable, tradeReason] = evaluateTradability(htfView, mtfView, ltfView)
    bool healthy = healthyExtension(htfView, lClose, lAtr, lLastLow, nz(lLastLowKind), nz(lHaveLow) == 1, lLastHigh, nz(lLastHighKind), nz(lHaveHigh) == 1)
    float volRatio = nz(lVolRatio)
    bool goodVolume = nz(lVolAvg) > 0 and volRatio >= VOLUME_MIN_RATIO and volRatio <= VOLUME_MAX_RATIO
    float momRatio = nz(lMomRatio)
    bool goodMomentum = nz(lTrAvg) > 0 and momRatio >= MOMENTUM_MIN_RATIO and momRatio <= MOMENTUM_MAX_RATIO
    [optimal, optimalReason] = evaluateOptimal(tradable, healthy, goodVolume, volRatio, goodMomentum, momRatio)
    table.clear(dash, 0, 0, 1, 23)
    int row = 0
    // Each Market Trend with its Internal Structure below it.
    if useHtf
        dashRow(row, "HTF Market Trend (" + tfName(htfTf) + "):", biasText(htfView), trendColor(htfView), breakdownText(htfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(htfInternal), internalColor(htfInternal), internalTooltip(htfInternal, htfView, tfName(htfTf), htfInternalLength))
            row += 1
    if useMtf
        dashRow(row, "MTF Market Trend (" + tfName(mtfTf) + "):", biasText(mtfView), trendColor(mtfView), breakdownText(mtfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(mtfInternal), internalColor(mtfInternal), internalTooltip(mtfInternal, mtfView, tfName(mtfTf), mtfInternalLength))
            row += 1
    if useLtf
        dashRow(row, "LTF Market Trend (" + tfName(ltfTf) + "):", biasText(ltfView), trendColor(ltfView), breakdownText(ltfView))
        row += 1
        if showInternalOnDashboard
            dashRow(row, "Internal Structure:", internalTrendText(ltfInternal), internalColor(ltfInternal), internalTooltip(ltfInternal, ltfView, tfName(ltfTf), ltfInternalLength))
            row += 1
    dashRow(row, "Market Tradability:", tradable ? "Tradable" : "Not Tradable", passColor(tradable), entryFilterTooltip())
    row += 1
    dashRow(row, "Tradability Reason:", tradeReason, DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, "Trade Recommendations:", tradeRecommendation(htfView, mtfView, ltfView, tradable), DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, " ", " ", DASH_TEXT_COLOR, "")
    row += 1
    dashRow(row, "Optimal Conditions:", optimal ? "OPTIMAL" : "NOT OPTIMAL", passColor(optimal), optimalReason)
    row += 1
    if useCorrOpt
        dashRow(row, "Timeframe Correlation:", passText(tradable), passColor(tradable), optimalReason)
        row += 1
    if useExtOpt
        dashRow(row, "Healthy Extension:", passText(healthy), passColor(healthy), optimalReason)
        row += 1
    if useVolOpt
        dashRow(row, "Market Volume:", passText(goodVolume) + " (" + str.tostring(volRatio, "#.00") + "x average)", passColor(goodVolume), optimalReason)
        row += 1
    if useMomOpt
        dashRow(row, "Price Momentum:", passText(goodMomentum) + " (" + str.tostring(momRatio, "#.00") + "x average range)", passColor(goodMomentum), optimalReason)
        row += 1

// ------------------------------------------------------------------- alerts
// Structure-timeframe events that became known on its latest closed candle.
eventsText(int code) =>
    string s = ""
    array<int> digits = codeDigits(code)
    if digits.size() > 0
        for i = 0 to digits.size() - 1
            int d = digits.get(i)
            string one = d == 5 ? "LS (bullish CHoCH failed)" : d == 6 ? "LS (bearish CHoCH failed)" : (d == 1 or d == 2 ? "BOS " : "CHoCH ") + (d == 1 or d == 3 ? "bullish" : "bearish")
            s := s + (s == "" ? "" : " + ") + one
    s

int newCode = nz(hNew)
bool newStructure = nz(hEvents) != nz(hEvents[1]) and newCode > 0
string newCodeText = str.tostring(newCode)
bool newBullBos = newStructure and str.contains(newCodeText, "1")
bool newBearBos = newStructure and str.contains(newCodeText, "2")
bool newBullChoch = newStructure and str.contains(newCodeText, "3")
bool newBearChoch = newStructure and str.contains(newCodeText, "4")
bool newBullLs = newStructure and str.contains(newCodeText, "5")
bool newBearLs = newStructure and str.contains(newCodeText, "6")
if enableAlerts and newStructure
    alert(syminfo.ticker + " " + tfName(htfTf) + " " + eventsText(newCode), alert.freq_once_per_bar)
alertcondition(newBullBos, "Structure TF bullish BOS", "{{ticker}}: bullish BOS on the structure timeframe")
alertcondition(newBearBos, "Structure TF bearish BOS", "{{ticker}}: bearish BOS on the structure timeframe")
alertcondition(newBullChoch, "Structure TF bullish CHoCH", "{{ticker}}: bullish CHoCH on the structure timeframe")
alertcondition(newBearChoch, "Structure TF bearish CHoCH", "{{ticker}}: bearish CHoCH on the structure timeframe")
alertcondition(newBullLs, "Structure TF LS (bullish CHoCH failed)", "{{ticker}}: a bullish CHoCH failed (LS) on the structure timeframe")
alertcondition(newBearLs, "Structure TF LS (bearish CHoCH failed)", "{{ticker}}: a bearish CHoCH failed (LS) on the structure timeframe")
